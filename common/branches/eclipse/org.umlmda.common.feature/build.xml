<?xml version="1.0" encoding="UTF-8"?>
<project name="org.umlmda.common.feature" default="build.update.jar" basedir=".">

	<target name="init">
		<property name="feature.temp.folder" value="${basedir}/feature.temp.folder"/>
		<property name="feature.destination" value="${basedir}"/>
	</target>

	<target name="all.plugins" depends="init">
		<ant antfile="build.xml" dir="../../plugins/org.umlmda.generator.profile" target="${target}">
		</ant>
		<ant antfile="build.xml" dir="../../plugins/org.umlmda.generator.profile.edit" target="${target}">
		</ant>
		<ant antfile="build.xml" dir="../../plugins/org.umlmda.generator.profile.editor" target="${target}">
		</ant>
		<ant antfile="build.xml" dir="../../plugins/org.umlmda.eclipse" target="${target}">
		</ant>
		<ant antfile="build.xml" dir="../../plugins/org.umlmda.eclipse.jdt" target="${target}">
		</ant>
		<ant antfile="build.xml" dir="../../plugins/org.umlmda.generator.model" target="${target}">
		</ant>
		<ant antfile="build.xml" dir="../../plugins/org.umlmda.generator.uml.psm" target="${target}">
		</ant>
	</target>
	<target name="all.features" depends="init">
		<ant antfile="build.xml" dir="../org.umlmda.common.core.feature/" target="${target}"/>
	</target>
	<target name="update.feature" depends="init">
	</target>

	<target name="all.children" depends="init,all.features,all.plugins,update.feature">
	</target>

	<target name="children" if="include.children">
		<antcall target="all.children"/>
	</target>

	<target name="build.jars" depends="init" description="Build all the jars for the feature: org.umlmda.common.feature.">
		<antcall target="all.children">
			<param name="target" value="build.jars"/>
		</antcall>
	</target>

	<target name="build.sources" depends="init">
		<antcall target="all.children">
			<param name="target" value="build.sources"/>
		</antcall>
	</target>

	<target name="build.zips" depends="init">
		<antcall target="all.children">
			<param name="target" value="build.zips"/>
		</antcall>
	</target>

	<target name="build.update.jar" depends="init" description="Build the feature jar of: org.umlmda.common.feature for an update site.">
		<antcall target="all.children">
			<param name="target" value="build.update.jar"/>
		</antcall>
		<property name="feature.base" value="${feature.temp.folder}"/>
		<delete dir="${feature.temp.folder}"/>
		<mkdir dir="${feature.temp.folder}"/>
		<antcall target="gather.bin.parts" inheritAll="false">
			<param name="nl" value="*"/>
			<param name="ws" value="*"/>
			<param name="arch" value="*"/>
			<param name="os" value="*"/>
			<param name="feature.base" value="${feature.temp.folder}"/>
		</antcall>
		<jar destfile="${feature.destination}/org.umlmda.common.feature_3.5.0.200810230936.jar" basedir="${feature.temp.folder}/features/org.umlmda.common.feature_3.5.0.200810230936"/>
		<delete dir="${feature.temp.folder}"/>
	</target>

	<target name="gather.bin.parts" depends="init" if="feature.base">
		<mkdir dir="${feature.base}/features/org.umlmda.common.feature_3.5.0.200810230936"/>
		<antcall target="children">
			<param name="destination.temp.folder" value="${feature.base}/plugins"/>
			<param name="target" value="gather.bin.parts"/>
		</antcall>
		<copy todir="${feature.base}/features/org.umlmda.common.feature_3.5.0.200810230936" failonerror="true" overwrite="false">
			<fileset dir="${basedir}">
				<include name="feature.xml"/>
				<include name="readme.html"/>
			</fileset>
		</copy>
		<eclipse.idReplacer featureFilePath="${feature.base}/features/org.umlmda.common.feature_3.5.0.200810230936/feature.xml"  selfVersion="3.5.0.200810230936" featureIds="org.umlmda.common.core.feature:0.0.0,3.5.0.200810230936," pluginIds="org.umlmda.generator.profile:3.5.0,3.5.0.200810230936,org.umlmda.generator.profile.edit:3.5.0,3.5.0.200810230936,org.umlmda.generator.profile.editor:3.5.0,3.5.0.200810230936,org.umlmda.eclipse:3.5.0,3.5.0.200810230936,org.umlmda.eclipse.jdt:3.5.0,3.5.0.200810230936,org.umlmda.generator.model:3.5.0,3.5.0.200810230936,org.umlmda.generator.uml.psm:3.5.0,3.5.0.200810230936,"/>
		<antcall target="rootFiles${os}_${ws}_${arch}"/>
	</target>
	<target name="rootFiles*_*_*">
	</target>
	<target name="rootFilesgroup_group_group">
		<antcall target="rootFiles*_*_*"/>
	</target>

	<target name="zip.distribution" depends="init" description="Create a zip containing all the plug-ins and features for the feature: org.umlmda.common.feature.">
		<delete dir="${feature.temp.folder}"/>
		<mkdir dir="${feature.temp.folder}"/>
		<antcall target="gather.bin.parts">
			<param name="include.children" value="true"/>
			<param name="nl" value="*"/>
			<param name="arch" value="*"/>
			<param name="ws" value="*"/>
			<param name="feature.base" value="${feature.temp.folder}"/>
			<param name="os" value="*"/>
		</antcall>
		<zip destfile="${feature.destination}/org.umlmda.common.feature_3.5.0.200810230936.bin.dist.zip" basedir="${feature.temp.folder}" filesonly="false" whenempty="skip" update="false"/>
		<delete dir="${feature.temp.folder}"/>
	</target>

	<target name="zip.sources" depends="init">
		<delete dir="${feature.temp.folder}"/>
		<mkdir dir="${feature.temp.folder}"/>
		<antcall target="all.children">
			<param name="destination.temp.folder" value="${feature.temp.folder}/plugins/org.umlmda.common.feature.source_3.5.0.200810230936/src"/>
			<param name="include.children" value="true"/>
			<param name="target" value="gather.sources"/>
		</antcall>
		<zip destfile="${feature.destination}/org.umlmda.common.feature_3.5.0.200810230936.src.zip" basedir="${feature.temp.folder}" filesonly="true" whenempty="skip" update="false"/>
		<delete dir="${feature.temp.folder}"/>
	</target>

	<target name="zip.logs" depends="init">
		<delete dir="${feature.temp.folder}"/>
		<mkdir dir="${feature.temp.folder}"/>
		<antcall target="all.children" inheritAll="false">
			<param name="destination.temp.folder" value="${feature.temp.folder}/plugins"/>
			<param name="include.children" value="true"/>
			<param name="target" value="gather.logs"/>
		</antcall>
		<zip destfile="${feature.destination}/org.umlmda.common.feature_3.5.0.200810230936.log.zip" basedir="${feature.temp.folder}" filesonly="true" whenempty="skip" update="false"/>
		<delete dir="${feature.temp.folder}"/>
	</target>

	<target name="clean" depends="init" description="Clean the feature: org.umlmda.common.feature of all the zips, jars and logs created.">
		<delete file="${feature.destination}/org.umlmda.common.feature_3.5.0.200810230936.jar"/>
		<delete file="${feature.destination}/org.umlmda.common.feature_3.5.0.200810230936.bin.dist.zip"/>
		<delete file="${feature.destination}/org.umlmda.common.feature_3.5.0.200810230936.log.zip"/>
		<delete file="${feature.destination}/org.umlmda.common.feature_3.5.0.200810230936.src.zip"/>
		<delete dir="${feature.temp.folder}"/>
		<antcall target="all.children">
			<param name="target" value="clean"/>
		</antcall>
	</target>

	<target name="refresh" depends="init" if="eclipse.running" description="Refresh this folder.">
		<eclipse.convertPath fileSystemPath="D:/devel/umlmda.pde/build/features/org.umlmda.common.feature/" property="resourcePath"/>
		<eclipse.refreshLocal resource="${resourcePath}" depth="infinite"/>
		<antcall target="all.children">
			<param name="target" value="refresh"/>
		</antcall>
	</target>
	<target name="gather.sources">
		<antcall target="children">
			<param name="destination.temp.folder" value="${feature.temp.folder}/plugins/org.umlmda.common.feature.source_3.5.0.200810230936/src"/>
			<param name="target" value="gather.sources"/>
		</antcall>
	</target>

	<target name="gather.logs" depends="init">
		<mkdir dir="${feature.temp.folder}"/>
		<antcall target="all.children" inheritAll="false">
			<param name="destination.temp.folder" value="${feature.temp.folder}/plugins"/>
			<param name="target" value="gather.logs"/>
		</antcall>
	</target>

</project>
