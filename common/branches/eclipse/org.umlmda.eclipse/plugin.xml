<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>
<plugin>

   <extension-point id="extensionClassloader" name="UMLMDA Extension Classloader" schema="schema/extensionClassloader.exsd"/>
   <extension-point id="templatePath" name="UMLMDA template path" schema="schema/templatePath.exsd"/>
   <extension-point id="modelFactory" name="UMLMDA Model Factory" schema="schema/modelFactory.exsd"/>
   <extension-point id="formatterProvider" name="UMLMDA Code Formatting Provider" schema="schema/formatterProvider.exsd"/>

   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            name="UMLMDA Preferences"
            class="org.umlmda.eclipse.preferences.UMLMDAPreferencePage"
            id="org.umlmda.eclipse.preferences.UMLMDAPreferencePage">
      </page>
   </extension>
   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            category="org.umlmda.eclipse.preferences.UMLMDAPreferencePage"
            class="org.umlmda.eclipse.preferences.FormatterPreferencePage"
            id="org.umlmda.eclipse.preferences.UMLMDAFormatterPreferencePage"
            name="Formatter">
      </page>
   </extension>

</plugin>
