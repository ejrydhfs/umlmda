  <ownedComment xmi:id="_-66UkMT_Ed28n7ofFGqNfw" annotatedElement="_LKQ_oMT7Ed28n7ofFGqNfw">
    <body>&lt;HTML>&lt;HEAD>&#xD;
&lt;META content=&quot;MSHTML 6.00.2900.3199&quot; name=GENERATOR>&lt;/HEAD>&#xD;
&lt;BODY>UMLMDA common stereotypes, used for different modelling purposes (service, domain, persistence, ...)&amp;nbsp;&lt;/BODY>&lt;/HTML></body>
  </ownedComment>
  <packageImport xmi:id="_LKQ_ocT7Ed28n7ofFGqNfw">
    <importedPackage xmi:type="uml:Model" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#_0"/>
  </packageImport>
  <packageImport xmi:id="_LKQ_osT7Ed28n7ofFGqNfw">
    <importedPackage xmi:type="uml:Model" href="pathmap://UML_METAMODELS/UML.metamodel.uml#_0"/>
  </packageImport>
  <packagedElement xmi:type="uml:Stereotype" xmi:id="_L1yPkMUAEd28n7ofFGqNfw" name="Alias">
    <ownedComment xmi:id="_L1yPk8UAEd28n7ofFGqNfw" annotatedElement="_L1yPkMUAEd28n7ofFGqNfw">
      <body>&lt;HTML>&lt;HEAD>&#xD;
&lt;META content=&quot;MSHTML 6.00.2900.3199&quot; name=GENERATOR>&lt;/HEAD>&#xD;
&lt;BODY>A &amp;lt;&amp;lt;Alias&amp;gt;&amp;gt; class contains a single attribute. This attribute may contain additional information (for example persistence informations).&amp;nbsp;Properties using the &amp;lt;&amp;lt;Alias&amp;gt;&amp;gt; as a type will replace the type of the &amp;lt;&amp;lt;Alias&amp;gt;&amp;gt; attribute.&lt;/BODY>&lt;/HTML></body>
    </ownedComment>
    <ownedAttribute xmi:id="_L1yPlsUAEd28n7ofFGqNfw" name="base_Class" association="_L1yPmcUAEd28n7ofFGqNfw">
      <type xmi:type="uml:Class" href="pathmap://UML_METAMODELS/UML.metamodel.uml#Class"/>
    </ownedAttribute>
  </packagedElement>
  <packagedElement xmi:type="uml:Extension" xmi:id="_L1yPmcUAEd28n7ofFGqNfw" name="Class_Alias" memberEnd="_L1yPnMUAEd28n7ofFGqNfw _L1yPlsUAEd28n7ofFGqNfw">
