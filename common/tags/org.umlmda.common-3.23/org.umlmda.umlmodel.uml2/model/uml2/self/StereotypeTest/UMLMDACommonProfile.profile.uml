  </packagedElement>
  <packagedElement xmi:type="uml:Stereotype" xmi:id="_jDba4MUAEd28n7ofFGqNfw" name="Enumeration">
    <ownedComment xmi:id="_jDba48UAEd28n7ofFGqNfw" annotatedElement="_jDba4MUAEd28n7ofFGqNfw">
      <body>Modelling an enumeration, the attributes of the enumeration are the valid values, the initial values of the attributes are the string or integer representation of the value.</body>
    </ownedComment>
    <ownedAttribute xmi:id="_jDba5sUAEd28n7ofFGqNfw" name="base_Class" association="_jDba6cUAEd28n7ofFGqNfw">
      <type xmi:type="uml:Class" href="pathmap://UML_METAMODELS/UML.metamodel.uml#Class"/>
    </ownedAttribute>
    <ownedAttribute xmi:id="_F-xuAMUCEd28n7ofFGqNfw" name="extendable" visibility="public">
      <ownedComment xmi:id="_eliBUMUCEd28n7ofFGqNfw" annotatedElement="_F-xuAMUCEd28n7ofFGqNfw">
        <body>&lt;HTML>&lt;HEAD>&#xD;
&lt;META content=&quot;MSHTML 6.00.2900.3199&quot; name=GENERATOR>&lt;/HEAD>&#xD;
&lt;BODY>An extendable enumeration has not a fixed count of literals. The literals may be loaded from a code database.&lt;/BODY>&lt;/HTML></body>
      </ownedComment>
      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Boolean"/>
      <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_JOWoYMUCEd28n7ofFGqNfw">
        <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Boolean"/>
      </defaultValue>
    </ownedAttribute>
    <ownedAttribute xmi:id="_Q_m-MMUCEd28n7ofFGqNfw" name="final" visibility="public">
      <ownedComment xmi:id="_j5Ry4MUCEd28n7ofFGqNfw" annotatedElement="_Q_m-MMUCEd28n7ofFGqNfw">
        <body>&lt;HTML>&lt;HEAD>&#xD;
&lt;META content=&quot;MSHTML 6.00.2900.3199&quot; name=GENERATOR>&lt;/HEAD>&#xD;
&lt;BODY>A none final enumeration may be derived&amp;nbsp;from an other enumeration.&lt;/BODY>&lt;/HTML></body>
      </ownedComment>
      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Boolean"/>
      <defaultValue xmi:type="uml:LiteralBoolean" xmi:id="_SvqmkMUCEd28n7ofFGqNfw" value="true">
        <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Boolean"/>
      </defaultValue>
    </ownedAttribute>
    <ownedAttribute xmi:id="_vXwKoMgeEd27b5iuD2bDog" name="literalLength" visibility="public">
      <ownedComment xmi:id="_f0olkMgfEd27b5iuD2bDog" annotatedElement="_vXwKoMgeEd27b5iuD2bDog">
        <body>&lt;HTML>&lt;HEAD>&#xD;
&lt;META content=&quot;MSHTML 6.00.2900.3199&quot; name=GENERATOR>&lt;/HEAD>&#xD;
&lt;BODY>&#xD;
&lt;P>Maximum length of the value of a string literal.&lt;/P>&lt;/BODY>&lt;/HTML></body>
      </ownedComment>
      <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
