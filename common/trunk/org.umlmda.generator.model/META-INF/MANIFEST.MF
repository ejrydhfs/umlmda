Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: UMLMDA Generator Model Plug-in
Bundle-SymbolicName: org.umlmda.generator.model
Bundle-Version: 3.5.0.qualifier
Bundle-Vendor: www.umlmda.org
Bundle-Localization: plugin
Export-Package: org.umlmda.generator.annotation,
 org.umlmda.generator.logging,
