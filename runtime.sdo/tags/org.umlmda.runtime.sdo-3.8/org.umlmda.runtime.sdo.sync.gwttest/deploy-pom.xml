<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
>

   <modelVersion>4.0.0</modelVersion>
   <parent>
      <groupId>org.umlmda</groupId>
      <artifactId>org.umlmda.runtime.releng</artifactId>
      <version>2.0.0-SNAPSHOT</version>
   </parent>
   <artifactId>org.umlmda.runtime.sdo.sync.gwttest.deploy</artifactId>
   <name>UMLMDA SDO Sync Test for deployment</name>
   <packaging>war</packaging>

   <build>
      <sourceDirectory>none</sourceDirectory>
      <plugins>
         <plugin>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
               <execution>
                  <id>copy-war</id>
                  <phase>generate-sources</phase>
                  <goals>
                     <goal>copy</goal>
                  </goals>
                  <configuration>
                     <artifactItems>
                        <artifactItem>
                           <groupId>${parent.groupId}</groupId>
                           <artifactId>org.umlmda.runtime.sdo.sync.gwttest</artifactId>
                           <version>${parent.version}</version>
                           <type>war</type>
                           <overWrite>true</overWrite>
                        </artifactItem>
                     </artifactItems>
                     <overWriteReleases>true</overWriteReleases>
                     <overWriteSnapshots>true</overWriteSnapshots>
                  </configuration>
               </execution>
            </executions>
         </plugin>
         <plugin>
            <artifactId>maven-war-plugin</artifactId>
            <configuration>
               <warSourceDirectory>webapp</warSourceDirectory>
               <webXml>webapp/WEB-INF/web.xml</webXml>
               <warSourceExcludes>
                  WEB-INF/lib/*sources.jar,
                  WEB-INF/lib/org.umlmda.runtime.gwt.jreemul-*.jar,
                  WEB-INF/lib/org.umlmda.runtime.sdo.sync.test-*.jar
                  WEB-INF/lib/org.umlmda.runtime.sdo.sync.test.gwt-*.jar
               </warSourceExcludes>
               <webResources>
                  <resource>
                     <directory>webapp</directory>
                     <includes>
                        <include>about.html</include>
                     </includes>
                     <filtering>true</filtering>
                  </resource>
               </webResources>
            </configuration>
         </plugin>
         <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>tomcat-maven-plugin</artifactId>
            <configuration>
               <url>${tomcat.url}</url>
               <server>tomcat</server>
               <path>/demo</path>
               <warFile>${project.build.directory}/dependency/org.umlmda.runtime.sdo.sync.gwttest-${parent.version}.war</warFile>
            </configuration>
         </plugin>
      </plugins>
   </build>
   <!-- umgeht einen Hudson/Maven Bug -->
   <repositories>
      <repository>
         <id>central</id>
         <url>
            http://cor-health-dev1.corag.de:8090/artifactory/repo
         </url>
         <snapshots>
            <enabled>false</enabled>
         </snapshots>
      </repository>
      <repository>
         <id>snapshots</id>
         <url>
            http://cor-health-dev1.corag.de:8090/artifactory/repo
         </url>
         <releases>
            <enabled>false</enabled>
         </releases>
      </repository>
   </repositories>
   <pluginRepositories>
      <pluginRepository>
         <id>central</id>
         <url>
            http://cor-health-dev1.corag.de:8090/artifactory/plugins-releases
         </url>
         <snapshots>
            <enabled>false</enabled>
         </snapshots>
      </pluginRepository>
      <pluginRepository>
         <id>snapshots</id>
         <url>
            http://cor-health-dev1.corag.de:8090/artifactory/plugins-snapshots
         </url>
         <releases>
            <enabled>false</enabled>
         </releases>
      </pluginRepository>
   </pluginRepositories>
</project>