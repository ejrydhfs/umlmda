<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">

   <modelVersion>4.0.0</modelVersion>
   <parent>
      <groupId>org.umlmda</groupId>
      <artifactId>org.umlmda.runtime.sdo</artifactId>
      <version>3.9-SNAPSHOT</version>
   </parent>
   <artifactId>org.umlmda.runtime.sdo.sync.gwttest</artifactId>
   <name>UMLMDA SDO Sync-Service Test GWT</name>
   <packaging>war</packaging> <!-- jar -->
   <description></description>

   <dependencies>
      <dependency>
         <groupId>com.google.gwt</groupId>
         <artifactId>gwt-user</artifactId>
         <version>2.0.2</version>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.gwt.jreemul</artifactId>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.gwt.jreemul</artifactId>
         <classifier>sources</classifier>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.core</artifactId>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.core</artifactId>
         <classifier>sources</classifier>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.sdo.sync</artifactId>
         <version>${pom.version}</version>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.sdo.sync</artifactId>
         <classifier>sources</classifier>
         <version>${pom.version}</version>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.sdo.sync.gwtclient</artifactId>
         <version>${pom.version}</version>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.sdo.sync.gwtclient</artifactId>
         <classifier>sources</classifier>
         <version>${pom.version}</version>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.sdo.sync.gwtserver</artifactId>
         <scope>runtime</scope>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.sdo.sync.test.java</artifactId>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.sdo.sync.test.gwt</artifactId>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.sdo.sync.test.gwt</artifactId>
         <classifier>sources</classifier>
      </dependency>

      <dependency>
         <groupId>de.corag.common</groupId>
         <artifactId>gwt-jmi</artifactId>
         <version>1.2</version>
      </dependency>
      <dependency>
         <groupId>de.corag.common</groupId>
         <artifactId>gwt-jmi</artifactId>
         <classifier>sources</classifier>
         <version>1.2</version>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.gwt.jeeemul</artifactId>
         <version>${umlmda.runtime.version}</version>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.gwt.jeeemul</artifactId>
         <version>${umlmda.runtime.version}</version>
         <classifier>sources</classifier>
      </dependency>
	  <dependency>
         <groupId>log4j</groupId>
         <artifactId>log4j</artifactId>
         <version>1.2.8</version>
      </dependency>


      <!-- Logging -->
      <dependency>
         <groupId>com.allen_sauer.gwt</groupId>
         <artifactId>gwt-log</artifactId>
         <version>1.5.6</version>
      </dependency>
      <dependency>
         <groupId>de.corag.common</groupId>
         <artifactId>logging</artifactId>
         <scope>runtime</scope>
         <version>1.2</version>
      </dependency>
      <dependency>
         <groupId>de.corag.common</groupId>
         <artifactId>logging</artifactId>
         <classifier>sources</classifier>
         <version>1.2</version>
      </dependency>

   </dependencies>

   <build>
      <plugins>
         <plugin>
            <groupId>com.totsp.gwt</groupId>
            <artifactId>maven-googlewebtoolkit2-plugin</artifactId>
            <configuration>
               <logLevel>INFO</logLevel>
               <runTarget>
                  org.umlda.runtime.sdo.sync.gwt.test.SdoGwtServiceTest/SdoGwtServiceTest.html
               </runTarget>
               <style>DETAILED</style>
               <!-- <noServer>true</noServer> -->
               <port>8080</port>
               <!-- <debugPort>8000</debugPort> -->
               <!-- <contextXml>src/main/webapp/META-INF/context.xml</contextXml>  -->
               <webXml>${basedir}/webapp/WEB-INF/web.xml</webXml>
               <!--  <tomcat>../apps/apache-tomcat-6.0.14</tomcat>  -->
               <!-- gwtVersion>1.4.61</gwtVersion -->
               <compileTargets>
                  <param>
                     org.umlda.runtime.sdo.sync.gwt.test.SdoGwtServiceTest
                  </param>
               </compileTargets>
               <extraJvmArgs>-Xms512M -Xmx1024M</extraJvmArgs>
            </configuration>
            <executions>
               <execution>
                  <goals>
                     <!--<goal>generateClientBeans</goal>-->
                     <goal>mergewebxml</goal>
                     <goal>compile</goal>
                     <!-- <goal>testGwt</goal> -->
                  </goals>
               </execution>
            </executions>
         </plugin>
         <plugin>
            <artifactId>maven-war-plugin</artifactId>
            <configuration>
               <warSourceDirectory>webapp</warSourceDirectory>
               <webXml>target/web.xml</webXml>
               <warSourceExcludes>
                  WEB-INF/lib/*sources.jar,
                  WEB-INF/lib/org.umlmda.runtime.gwt.jreemul-*.jar,
                  WEB-INF/lib/org.umlmda.runtime.sdo.sync.test-*.jar
                  WEB-INF/lib/org.umlmda.runtime.sdo.sync.test.gwt-*.jar
               </warSourceExcludes>
               <webResources>
                  <resource>
                     <directory>webapp</directory>
                     <includes>
                        <include>about.html</include>
                     </includes>
                     <filtering>true</filtering>
                  </resource>
               </webResources>
            </configuration>
         </plugin>
         <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>tomcat-maven-plugin</artifactId>
            <configuration>
               <url>${tomcat.url}</url>
               <server>tomcat</server>
               <path>/synctest</path>
            </configuration>
         </plugin>
      </plugins>
   </build>
   <repositories>
      <repository>
         <id>artifactory</id>
         <url>http://coding.ds2k.de/artifactory/repo</url>
         <releases>
            <enabled>true</enabled>
         </releases>
         <snapshots>
            <enabled>true</enabled>
         </snapshots>
      </repository>
   </repositories>
</project>