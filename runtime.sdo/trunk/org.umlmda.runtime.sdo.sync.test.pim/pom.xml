<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

   <modelVersion>4.0.0</modelVersion>
   <parent>
      <artifactId>org.umlmda.runtime.sdo</artifactId>
      <groupId>org.umlmda</groupId>
      <version>3.18-SNAPSHOT</version>
   </parent>
   <artifactId>org.umlmda.runtime.sdo.sync.test.pim</artifactId>
   <name>UMLMDA SDO Sync-Service Test Model PIM and Generator</name>
   <description />
   <packaging>pom</packaging>

   <dependencies>
      <!-- oAW -->
      <dependency>
         <groupId>org.openarchitectureware</groupId>
         <artifactId>oaw-rsdp-adapter</artifactId>
         <version>${oaw.version}</version>
      </dependency>
      <dependency>
         <groupId>org.openarchitectureware</groupId>
         <artifactId>oaw-util-stdlib</artifactId>
         <version>${oaw.version}</version>
      </dependency>

      <!-- UMLMDA -->
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.generator.model</artifactId>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.generator.profile</artifactId>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.generator.uml.psm</artifactId>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.model.profile</artifactId>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.umlmodel.uml2</artifactId>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.umlmodel</artifactId>
      </dependency>

      <!-- UMLMDA oAW -->
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.generator.uml.oaw</artifactId>
      </dependency>

      <!-- Apache stuff -->
      <dependency>
         <groupId>commons-lang</groupId>
         <artifactId>commons-lang</artifactId>
         <scope>runtime</scope>
      </dependency>
      <dependency>
         <groupId>oro</groupId>
         <artifactId>oro</artifactId>
      </dependency>
   </dependencies>

   <build>
      <resources>
         <resource>
            <directory>src</directory>
         </resource>
      </resources>
      <plugins>
         <plugin>
            <artifactId>maven-clean-plugin</artifactId>
            <configuration>
               <filesets>
                  <fileset>
                     <directory>etc/umlmda/3rd</directory>
                  </fileset>
                  <fileset>
                     <directory>model/rsm/3rd</directory>
                  </fileset>
                  <fileset>
                     <directory>profiles/rsm/3rd</directory>
                  </fileset>
               </filesets>
            </configuration>
         </plugin>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
               <!-- Auspacken von UML Profilen, UMLMDA Generatorprofilen und -sets -->
               <execution>
                  <id>unpack</id>
                  <phase>initialize</phase>
                  <goals>
                     <goal>unpack</goal>
                  </goals>
                  <configuration>
                     <artifactItems>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.generator.profiles</artifactId>
                           <version>${umlmda.generator.profile.version}</version>
                           <type>zip</type>
                           <classifier>java-ump</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/etc/umlmda/3rd/profile</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.generator.profiles</artifactId>
                           <version>${umlmda.generator.profile.version}</version>
                           <type>zip</type>
                           <classifier>gwt-ump</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/etc/umlmda/3rd/profile</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.profiles</artifactId>
                           <version>${umlmda.uml2.profile.version}</version>
                           <type>zip</type>
                           <classifier>std</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>
                              ${basedir}/profiles/rsm/3rd/umlmda/profiles
                           </outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.profiles</artifactId>
                           <version>${umlmda.uml2.profile.version}</version>
                           <type>zip</type>
                           <classifier>sdo</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>
                              ${basedir}/profiles/rsm/3rd/umlmda/profiles
                           </outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>com.ibm.xtools.uml.msl</groupId>
                           <artifactId>uml2_profiles</artifactId>
                           <type>zip</type>
                           <overWrite>false</overWrite>
                           <outputDirectory>
                              ${basedir}/profiles/rsm/3rd/ibm
                           </outputDirectory>
                        </artifactItem>
                     </artifactItems>
                     <overWriteReleases>false</overWriteReleases>
                     <overWriteSnapshots>true</overWriteSnapshots>
                  </configuration>
               </execution>
            </executions>
         </plugin>

         <plugin>
            <groupId>org.fornax.toolsupport</groupId>
            <artifactId>fornax-oaw-m2-plugin</artifactId>
            <configuration>
               <defaultOawResourceDir>${basedir}/src/main/resources</defaultOawResourceDir>
               <properties>
                  <model.name>SyncTestModel.emx</model.name>
               </properties>
               <property file="${basedir}/src/main/resources/workflow.properties" />
            </configuration>
            <executions>
               <execution>
                  <id>run-oaw-workflow</id>
                  <phase>generate-sources</phase>
                  <goals>
                     <goal>run-workflow</goal>
                  </goals>
               </execution>
            </executions>
         </plugin>
      </plugins>
   </build>
</project>