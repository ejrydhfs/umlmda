<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

   <modelVersion>4.0.0</modelVersion>
   <parent>
      <groupId>org.umlmda</groupId>
      <artifactId>org.umlmda.oaw</artifactId>
      <version>3.14-SNAPSHOT</version>
   </parent>
   <artifactId>org.umlmda.test.persistence</artifactId>
   <version>1.0-SNAPSHOT</version>
   <packaging>pom</packaging>
   <name>UMLMDA oaw test persistence</name>
   <description>UMLMDA maven project for umlmda persistence generation test.</description>

   <properties>
      <umlmda.oaw.version>3.14-SNAPSHOT</umlmda.oaw.version>
      <umlmda.uml2.profile.version>4.1.0</umlmda.uml2.profile.version>
      <umlmda.uml2.profile.new.version>4.2.0</umlmda.uml2.profile.new.version>
      <umlmda.generator.profile.version>3.6</umlmda.generator.profile.version>
      <umlmda.runtime.version>3.8</umlmda.runtime.version>
   </properties>

   <dependencyManagement>
      <dependencies>
      <dependency>
         <groupId>javax.persistence</groupId>
         <artifactId>persistence-api</artifactId>
         <version>1.0</version>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.runtime.core</artifactId>
         <version>${umlmda.runtime.version}</version>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.runtime.common</artifactId>
         <version>${umlmda.runtime.version}</version>
      </dependency>
      </dependencies>
   </dependencyManagement>

   <build>
      <sourceDirectory>src/main/java</sourceDirectory>
      <testSourceDirectory>src/test/java</testSourceDirectory>
      <resources>
         <resource>
            <directory>src/main/resources</directory>
            <excludes>
               <exclude>*.java</exclude>
            </excludes>
         </resource>
      </resources>
      <plugins>
         <!-- compiler -->
         <plugin>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
               <source>1.5</source>
               <target>1.5</target>
               <debug>true</debug>
               <optimize>false</optimize>
               <fork>true</fork>
               <meminitial>128m</meminitial>
               <maxmem>512m</maxmem>
            </configuration>
         </plugin>
      </plugins>
   </build>

   <modules>
      <module>org.umlmda.test.persistence.pim</module>
      <module>org.umlmda.test.persistence.java</module>
   </modules>

   <scm>
      <connection>scm:svn:https://umlmda.svn.sourceforge.net/svnroot/umlmda/oaw/trunk</connection>
      <developerConnection>scm:svn:https://umlmda.svn.sourceforge.net/svnroot/umlmda/oaw/trunk</developerConnection>
   </scm>

   <repositories>
      <repository>
         <id>artifactory</id>
         <url>http://coding.ds2k.de/artifactory/repo</url>
         <releases>
            <enabled>true</enabled>
         </releases>
         <snapshots>
            <enabled>true</enabled>
         </snapshots>
      </repository>
      <repository>
         <id>cor-artifactory</id>
         <url>http://cor-health-dev1.corag.de/artifactory/repo</url>
         <releases>
            <enabled>true</enabled>
         </releases>
         <snapshots>
            <enabled>true</enabled>
         </snapshots>
      </repository>
   </repositories>

</project>