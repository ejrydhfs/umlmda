<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
   <parent>
      <groupId>org.umlmda</groupId>
      <artifactId>org.umlmda.test.persistence</artifactId>
      <version>1.0-SNAPSHOT</version>
   </parent>
   <modelVersion>4.0.0</modelVersion>
   <artifactId>org.umlmda.test.persistence.pim</artifactId>
   <name>org.umlmda.test.persistence.pim</name>

   <dependencyManagement>
      <dependencies>
         <!-- UMLMDA Profile -->
         <dependency>
            <groupId>org.umlmda</groupId>
            <artifactId>org.umlmda.uml2.profiles</artifactId>
            <version>${umlmda.uml2.profile.version}</version>
         </dependency>
         <dependency>
            <groupId>org.umlmda</groupId>
            <artifactId>org.umlmda.uml2.profiles.new</artifactId>
            <version>${umlmda.uml2.profile.new.version}</version>
         </dependency>
         <dependency>
            <groupId>org.umlmda</groupId>
            <artifactId>org.umlmda.uml2.generator.profiles</artifactId>
            <version>${umlmda.generator.profile.version}</version>
         </dependency>
      </dependencies>
   </dependencyManagement>

   <dependencies>
      <!-- oAW -->
      <dependency>
         <groupId>org.openarchitectureware</groupId>
         <artifactId>oaw-rsdp-adapter</artifactId>
         <version>${oaw.version}</version>
      </dependency>
      <dependency>
         <groupId>org.openarchitectureware</groupId>
         <artifactId>oaw-util-stdlib</artifactId>
         <version>${oaw.version}</version>
      </dependency>

      <!-- UMLMDA -->
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.generator.model</artifactId>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.generator.profile</artifactId>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.generator.uml.psm</artifactId>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.model.profile</artifactId>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.umlmodel.uml2</artifactId>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.umlmodel</artifactId>
      </dependency>

      <!-- UMLMDA oAW -->
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.generator.uml.oaw</artifactId>
      </dependency>

      <!-- Apache stuff -->
      <dependency>
         <groupId>commons-lang</groupId>
         <artifactId>commons-lang</artifactId>
         <scope>runtime</scope>
      </dependency>
      <dependency>
         <groupId>oro</groupId>
         <artifactId>oro</artifactId>
      </dependency>

   </dependencies>

   <build>
      <plugins>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
               <!-- Auspacken von UML Profilen, UMLMDA Generatorprofilen und -sets -->
               <execution>
                  <id>default</id>
                  <phase>initialize</phase>
                  <goals>
                     <goal>unpack</goal>
                  </goals>
                  <configuration>
                     <artifactItems>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.generator.profiles</artifactId>
                           <type>zip</type>
                           <classifier>java-ump</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/etc/umlmda/3rd/profile</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.profiles</artifactId>
                           <type>zip</type>
                           <classifier>std</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/profiles/rsm/3rd/umlmda/profiles</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.profiles.new</artifactId>
                           <type>zip</type>
                           <classifier>common</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/profiles/rsm/3rd/umlmda/profiles</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.profiles.new</artifactId>
                           <type>zip</type>
                           <classifier>domain</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/profiles/rsm/3rd/umlmda/profiles</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.profiles.new</artifactId>
                           <type>zip</type>
                           <classifier>persistence</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/profiles/rsm/3rd/umlmda/profiles</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>com.ibm.xtools.uml.msl</groupId>
                           <artifactId>uml2_profiles</artifactId>
                           <version>7.1.200</version>
                           <type>zip</type>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/profiles/rsm/3rd/ibm</outputDirectory>
                        </artifactItem>
                     </artifactItems>
                     <overWriteReleases>false</overWriteReleases>
                     <overWriteSnapshots>true</overWriteSnapshots>
                  </configuration>
               </execution>
            </executions>
         </plugin>

         <!-- Start oAW Workflow -->
         <plugin>
            <groupId>org.fornax.toolsupport</groupId>
            <artifactId>fornax-oaw-m2-plugin</artifactId>
            <version>2.1.1</version>
            <executions>
               <execution>
                  <id>run-oaw-workflow-base</id>
                  <phase>generate-sources</phase>
                  <goals>
                     <goal>run-workflow</goal>
                  </goals>
                  <configuration>
                     <defaultOawResourceDir>${basedir}/src/main/resource</defaultOawResourceDir>
                  </configuration>
               </execution>
            </executions>
         </plugin>
         <!-- Clean 3rd modelling stuff -->
         <plugin>
            <artifactId>maven-clean-plugin</artifactId>
            <configuration>
               <filesets>
                  <fileset>
                     <directory>etc/umlmda/3rd</directory>
                  </fileset>
                  <fileset>
                     <directory>model/rsm/3rd</directory>
                  </fileset>
                  <fileset>
                     <directory>profiles/rsm/3rd</directory>
                  </fileset>
                  <fileset>
                     <directory>../${parent.artifactId}.java/src/generated/java</directory>
                  </fileset>
               </filesets>
            </configuration>
         </plugin>
      </plugins>
   </build>
</project>