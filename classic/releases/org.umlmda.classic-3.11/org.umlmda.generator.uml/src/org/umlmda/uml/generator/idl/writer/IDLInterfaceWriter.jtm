<% @conf 
main.JostracaVersion       = 0.3
main.CodeWriter            = IDLInterfaceWriter
main.CodeWriterFormat	   = format/EmbeddedJavaWriterFormat.jwf
java.CodeWriter.package    = org.umlmda.uml.generator.idl.writer
java.CodeWriter.extends    = org.umlmda.uml.generator.idl.AbstractIDLElementWriter
%>
<% import!
import org.umlmda.model.uml.*;
import java.util.*;
// ==== End of generation header ===============================================
%>
<% @section declare %><%
%><% @section %>
   /**
    *
    */
   interface <%=getClassName()%> <%if ( getModelClass().getSuperClass() != null ) {%>: <%=getBaseClass()%><%}%>
   {
      // name registed in the CORBA naming service
      const string REGISTERED_SERVICE_NAME = "<%=getModelClass().getTaggedValues().getProperty("CORBAServiceName", getClassName())%>";
     
<% // Modelled Methods
   for ( Iterator ia = getModelClass().getMethods().iterator(); ia.hasNext(); ) {
	   ModelMethod method = (ModelMethod)ia.next();
%>   /**
    * <%=method.getDocumentation()%>
    */
    <%=getMethodSignature(method)%>;
<%   }%>		
   };
