<% // Loop required types
     for ( Iterator iter = classList.iterator(); iter.hasNext(); ) {
        WSModelClass modelClass = (WSModelClass)iter.next();

        // Skip classes from other packages
        if ( packageFilter && modelClass.getPackage().equals(modelPackage) == false ) 
           continue;
        // Skip everything that is not <<BusinessObject>> nor <<BusinessException>>
        if ( (modelClass.hasStereotype("BusinessObject") || modelClass.hasStereotype("BusinessException")) == false )
           continue;
        String direction = "";   
        if ( modelClass.isOptimized() == false ) {   
%><% @include WsdlType.jtm template-relative %><%
        }
        else {
          direction = "In";
%><% @include WsdlType.jtm template-relative %><%
          direction = "Out";
%><% @include WsdlType.jtm template-relative %><%
        }
     } // for
     
     // Loop services
     for ( Iterator iter = classList.iterator(); soapWrapping && iter.hasNext(); ) {
        ModelClass modelClass = (ModelClass)iter.next();

        // Skip classes from other packages
        if ( packageFilter && modelClass.getPackage().equals(modelPackage) == false ) 
           continue;
        // Skip everything that is not <<BusinessService>>
        if ( modelClass.hasStereotype("BusinessService") == false )
           continue;

        for ( Iterator im = modelClass.getMethods().iterator(); im.hasNext(); ) {
           ModelMethod method = (ModelMethod)im.next();
           
%>    <element name="<%=method.getName()%>Request">
      <complexType>
        <sequence>
<%         for ( Iterator ip = method.getParameters().iterator(); ip.hasNext(); ) {
              ModelParameter parameter = (ModelParameter)ip.next();
              ModelClassifier classifier = parameter.getType();
              String parameterName = parameter.getName();
              String parameterType = "";
              
              if ( classifier instanceof ModelClass ) {
                 WSModelClass parameterClass = (WSModelClass)classifier;
                 
                 parameterType = parameterClass.getDirectionType("In");
              }
              else {
                 parameterType = getType(classifier);
              }
%>            <element name="<%=parameterName%>" type="<%=parameterType%>"/>
<%              
           }
%>        </sequence>
      </complexType>
    </element>

<%         if ( method.getReturnType() != null ) {
              ModelClassifier classifier = method.getReturnType();
              String returnType = "";
              
              if ( classifier instanceof ModelClass ) {
                 WSModelClass returnClass = (WSModelClass)classifier;
                 
                 returnType = returnClass.getDirectionType("Out");
              }
              else {
                 returnType = getType(classifier);
              }
%>    <element name="<%=method.getName()%>Response">
      <complexType>
        <sequence>
            <element name="return" type="<%=returnType%>"/>
        </sequence>
      </complexType>
    </element>
<%         }
%>           
<%           
        } // for ( method
     } // for ( modelClass
%>

