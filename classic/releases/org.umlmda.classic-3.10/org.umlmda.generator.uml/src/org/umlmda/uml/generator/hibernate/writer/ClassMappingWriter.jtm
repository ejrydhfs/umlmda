<?xml version="1.0" encoding="ISO-8859-1"?>
<!-- @@Generated file, please edit UserSections only -->
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD//EN"
  "http://hibernate.sourceforge.net/hibernate-mapping-2.0.dtd" >
<% @conf 
main.JostracaVersion       = 0.3
main.CodeWriter            = ClassMappingWriter
main.CodeWriterFormat	     = format/ParentJavaWriterFormat.jwf
java.CodeWriter.package    = org.umlmda.uml.generator.hibernate.writer
java.CodeWriter.extends    = org.umlmda.uml.generator.hibernate.AbstractMappingWriter
%><% import!
import org.umlmda.model.uml.ModelAssociation;
import org.umlmda.model.uml.ModelAttribute;
import org.umlmda.profile.ModelStereotype;
import org.umlmda.profile.ModelTaggedValues;
import java.util.Iterator;
import java.util.List;
import org.umlmda.generator.model.util.StringUtil;

// ==== End of generation header ===============================================
%><% @section declare %><%
   /* (non-Javadoc)
    * @see net.sourceforge.umlmda.generator.AbstractWriter#generateOutput()
    */
   public boolean generateOutput() {
      String dbTable = getModelClass().getTaggedValues().getProperty(ModelTaggedValues.DB_TABLE);
      
      return StringUtil.isEmpty(dbTable) == false;
   }

%><% @section %>
<hibernate-mapping package="<%=getModelClass().getPackage().getQualifiedName()%>">
  <class name="<%=getModelClass().getName()%>" table="<%=getModelClass().getTaggedValues().getProperty(ModelTaggedValues.DB_TABLE)%>">
<% // Key Properties
   List keyAttributes = getModelClass().getKeyAttributes();
   if ( keyAttributes.size() == 1 ) {
     ModelAttribute attribute = (ModelAttribute)keyAttributes.get(0);
%>
    <id name="<%=attribute.getName()%>"
         column="<%=getDbName(attribute)%>"
         type="<%=getType(attribute)%>">
<!-- @@UserSection-Begin Generator -->
      <generator class="assigned">
      </generator> 
<!-- @@UserSection-End Generator -->
    </id>
<% } else if ( keyAttributes.size() > 1 ) { %>
    <composite-id name="<%=getModelClass().getName()%>Pkey" class="<%=getModelClass().getName()%>$PKey">
<% for ( Iterator ia = getModelClass().getKeyAttributes().iterator(); ia.hasNext(); ) {
	   ModelAttribute attribute = (ModelAttribute)ia.next();
%>   
      <key-property name="<%=attribute.getName()%>"
         column="<%=getDbName(attribute)%>"
         type="<%=getType(attribute)%>"/>
<% }   
%>   
    </composite-id>
<% } else { %>
   <!-- No Keys defined in Model, add Stereotype <<PKey>> at least to one attribute -->
   
   
<% }
%>    
	<!--Properties - Start--><%
   // Non-Key Properties
   for ( Iterator ia = getModelClass().getAttributes().iterator(); ia.hasNext(); ) {
	   ModelAttribute attribute = (ModelAttribute)ia.next();
	   
	   if ( attribute.hasStereotype(ModelStereotype.ATTRIBUTE_PKEY) == false ) { %>
    <property name="<%=attribute.getName()%>"
              column="<%=getDbName(attribute)%>"
              type="<%=getType(attribute)%>"
    />	   
<%   }
   }
%>    <!--Properties - End-->

	<!--Associations - Start-->
<%
   // Assocations
   for ( Iterator ia = getModelClass().getAssociations().iterator(); ia.hasNext(); ) {
      ModelAssociation association = (ModelAssociation)ia.next();
     
      if ( association.isNavigatableToTarget() && association.getTarget().hasStereotype(ModelStereotype.BUSINESS_OBJECT)) {
		//One-To-Many composition
       	if ( association.isMultiple()  && association.isComposition()) {
%>    <!--One-To-Many composition-->
    <set name="<%=association.getName()%>List" cascade="all-delete-orphan" lazy="false">
      <key>
		<%   
			for ( Iterator iattr = getModelClass().getKeyAttributes().iterator(); iattr.hasNext(); ) {
          		ModelAttribute attribute = (ModelAttribute)iattr.next();
%>   <column name="<%=getDbName(attribute)%>"<%=association.isOptional() ? "" : " not-null=\"true\""%>/>
<%     }
%>      </key>
      <one-to-many class="<%=getType(association.getTarget())%>"/>
    </set>
<%    
	   	}
	   	//One-To-Many association
	   	else if (association.isMultiple() && !association.isComposition() && !association.getReverse().isMultiple()){
%>    <!--One-To-Many association-->
    <set name="<%=association.getName()%>List" cascade="save-update" lazy="false">
      <key>
		<%   
			for ( Iterator iattr = getModelClass().getKeyAttributes().iterator(); iattr.hasNext(); ) {
          		ModelAttribute attribute = (ModelAttribute)iattr.next();
%>   <column name="<%=getDbName(attribute)%>"<%=association.isOptional() ? "" : " not-null=\"true\""%>/>
<%     }
%>      </key>
      <one-to-many class="<%=getType(association.getTarget())%>"/>
    </set>
<%      
      } 
	   //One-To-One	association
      else if ( (!association.isMultiple() && !association.getReverse().isMultiple())
      		     || (association.isComposition() && !association.isMultiple())) {
%>    <!--One-To-One association-->
	  <many-to-one name="<%=association.getName()%>"
                   class="<%=getType(association.getTarget())%>"
                   cascade="<%=association.isComposition() ? "delete" : "save-update"%>">
<% for ( Iterator iattr = association.getTarget().getKeyAttributes().iterator(); iattr.hasNext(); ) {
          		ModelAttribute attribute = (ModelAttribute)iattr.next();
%>           <column name="<%=getDbName(attribute)%>" unique="true"<%=association.isOptional() ? "" : " not-null=\"true\""%>/> 
<%     }
%> 	  </many-to-one>			
<%  
      }
	  //Many-To-One	association
      else if ( !association.isMultiple() && association.getReverse().isMultiple()
      		     || (!association.isComposition() && !association.isMultiple())) {
%>    <!--Many-To-One association-->
	  <many-to-one name="<%=association.getName()%>"
                   class="<%=getType(association.getTarget())%>">
<% for ( Iterator iattr = association.getTarget().getKeyAttributes().iterator(); iattr.hasNext(); ) {
          		ModelAttribute attribute = (ModelAttribute)iattr.next();
%>           <column name="<%=getDbName(attribute)%>"<%=association.isOptional() ? "" : " not-null=\"true\""%>/> 
<%     }
%> 	  </many-to-one>			
<%  
      }
     } 
   }
%>    <!--Associations - End-->
  
  </class>
  
</hibernate-mapping>
