public class $<main.CodeWriter> 
$<{java.CodeWriter.extends>  extends $<java.CodeWriter.extends> $<}java.CodeWriter.extends> 
$<{java.CodeWriter.implements>  implements $<java.CodeWriter.implements> $<}java.CodeWriter.implements>
{

  /* Constants << */
 
  // User Interface text message parts
  public static final String writer__UITEXT_ExceptionIn              = "Exception in ";
  public static final String writer__UITEXT_ColonNewLine             = ":\n";
  public static final String writer__UITEXT_Section                  = "section ";
  public static final String writer__UITEXT_ErrorHeader              = "\n\n--- CodeWriter Error Description Start ---\n\n";
  public static final String writer__UITEXT_ErrorFooter              = "\n--- CodeWriter Error Description End -----\n\n";

  public static final int writer__BUFFER_SIZE  = 4096; // initial size of StringBuffer

  /* Constants >> */


  /* Writer Variables << */

  protected StringBuffer writer__iText                  = new StringBuffer();  // current text
  protected Hashtable    writer__iProperties            = new Hashtable();     // lookup table for compile time properties
  protected boolean      writer__iPropertiesInitialised = false;               // true => lookup table initialiased

  /* Writer Variables >> */


  !<{declare>/* section:declare << */
  //

  !<declare>

  //
  /* section:declare >> */!<}declare>



  /* Writer Services << */

  /* Initialize. */
  public void writer__initialize() {
    writer__iText = new StringBuffer( writer__BUFFER_SIZE );
  }



  /** Template script is placed here in the body section. */
  public void writer__write() throws Exception {

    // initialize
    String writer__currentSection = "body";

    try {

      !<{init>/* section:init << */
      //

      writer__currentSection = "init";
      !<init>

      //
      /* section:init >> */!<}init>


      !<{body>/* section:body << */
      //

      writer__currentSection = "body";
      !<body>

      //
      /* section:body >> */!<}body>

    } 
    catch( Exception e ) {
      writer__handleException( writer__UITEXT_ExceptionIn + writer__UITEXT_Section + writer__currentSection, e );
    }
  }



  /** Handle exceptions: print an explanation for user. */
  public void writer__handleException( final String pMessage, final Exception pException ) throws Exception {

    StringBuffer userMsg = new StringBuffer( 111 );

    userMsg.append( writer__UITEXT_ErrorHeader );

    userMsg.append( writer__describeState() + pMessage + writer__UITEXT_ColonNewLine );

    StringWriter stringWriter = new StringWriter();
    pException.printStackTrace( new PrintWriter( stringWriter) );
    userMsg.append( stringWriter.toString() );

    userMsg.append( writer__UITEXT_ErrorFooter );

    throw new Exception( userMsg.toString() );
  }



  /** Provide a concise description of the state of the CodeWriter. */
  public String writer__describeState() {
    String currentState = ""; 
    return currentState;
  }



  /** Set compile time properties. */
  public void writer__initProperties() {
    $<{jostraca.properties.NameValueList>
    String[] propertyList = new String[] { $<jostraca.properties.NameValueList> };
    int numProperties = propertyList.length;
    for( int propI = 0; propI < numProperties; propI += 2 ) {
      writer__iProperties.put( propertyList[ propI ], propertyList[ propI+1 ] );
    }
    writer__iPropertiesInitialised = true;
    $<}jostraca.properties.NameValueList>
  }


  /* Writer Services >> */
 



  /* Template Services (Control) << */

  public String _emit() throws Exception {
    writer__initialize();
    writer__write();
    return _getText();
  }



  /** Get compile time property
   *  @param rName Name of property to get.
   */
  public String _getProperty( final String pName ) {
    String result = "";

    if( ! writer__iPropertiesInitialised ) {
      writer__initProperties();
    }

    if( writer__iProperties.containsKey( pName ) ) {
      result = (String) writer__iProperties.get( pName );
    }

    return result;
  }

  /* Template Services (Control) >> */




  /* Template Services (Text Production) << */


  // inserts
  // ...

  /** Insert text into written file. */
  public void _insert( String rText ) {
    writer__iText.append( rText );
  }

  /** Insert string representation of object into written file. */
  public void _insert( final Object pObject ) {
    writer__iText.append( String.valueOf( pObject ) );
  }

  /** Insert string representation of primitive data type into written file. */

  public void _insert( final int pInt ) {
    writer__iText.append( pInt );
  }
  public void _insert( final long pLong ) {
    writer__iText.append( pLong );
  }
  public void _insert( final short pShort ) {
    writer__iText.append( pShort );
  }
  public void _insert( final byte pByte ) {
    writer__iText.append( pByte );
  }
  public void _insert( final double pDouble ) {
    writer__iText.append( pDouble );
  }
  public void _insert( final float pFloat ) {
    writer__iText.append( pFloat );
  }
  public void _insert( final char pChar ) {
    writer__iText.append( pChar );
  }
  public void _insert( final boolean pBoolean ) {
    writer__iText.append( pBoolean );
  }



  /** Create a String containing specified number of spaces. */
  public String _spaces( final int pNumSpaces ) {
    int numSpaces = pNumSpaces;
    if( 0 > numSpaces ) { numSpaces *= -1; }
    StringBuffer spaces = new StringBuffer( numSpaces );
    for(int spaceI = 0; spaceI < numSpaces; spaceI++) {
      spaces.append(" ");
    }
    return spaces.toString();
  }



  /** Left align String with spaces. */ 
  public String _left( final String pText, final int pColWidth ) {
    return _align( pText, " ", pColWidth, 'l' );
  } 



  /** Right align String with spaces. */ 
  public String _right( final String pText, final int pColWidth ) {
    return _align( pText, " ", pColWidth, 'r' );
  } 



  /** Center align String with spaces. */ 
  public String _center( final String pText, final int pColWidth ) {
    return _align( pText, " ", pColWidth, 'c' );
  } 



  /** Align text within background text to specified column width. 
   *  Alignment can be 'l': left, 'c': center, 'r': right
   */
  public String _align( final String pText, final String pBackText, final int pColWidth, final char pAlignment ) {
    String result = pText;
 
    if( null == pText ) { 
       result = ""; 
    }
    else if( null != pBackText ) {
      try {
        int textLen = pText.length();
        if( pColWidth > textLen ) {
          int    backTextLen     = pBackText.length();
          int    remainWidth     = pColWidth - textLen;
          int    backTextRepeats = remainWidth / backTextLen;
          int    backTextRemain  = remainWidth % backTextLen;
          String back            = "";
          for( int backTextI = 0; backTextI < backTextRepeats; backTextI++ ) {
            back = back + pBackText;
          }
          back = back + pBackText.substring( 0, backTextRemain );
 
          switch( pAlignment ) {
          case 'l':
            result = result + back;
            break;
          case 'c':
            result = back.substring( 0, (back.length()/2) ) + result + back.substring( (back.length()/2) );
            break;
          case 'r':
            result = back + result;
            break;
          }
        }
      } 
      catch( Exception e ) {
        result = pText;
      }
    }
    return result;
  }



  /** Set text being generated. */
  public void _setText( final String pText) {
    writer__iText = new StringBuffer( pText );
  }



  /** Get text being generated. */
  public String _getText() {
    return writer__iText.toString();
  }

  /* Template Services (Text Production) >> */

}

