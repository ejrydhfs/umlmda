REM @@Generated file, please edit UserSections only 
REM @@UserSection-Begin RCSHeader
<%=RcsHelper.writeHeader("REM ")%>
REM @@UserSection-End RCSHeader
<% @conf 
main.JostracaVersion       = 0.3
main.CodeWriter            = DDLWriter
main.CodeWriterFormat	     = format/ParentJavaWriterFormat.jwf
java.CodeWriter.package    = org.umlmda.uml.generator.sql.writer
java.CodeWriter.extends    = org.umlmda.uml.generator.sql.AbstractDDLWriter
%><% import!
import org.umlmda.generator.model.util.RcsHelper;
import org.umlmda.model.uml.*;
import org.umlmda.profile.ModelTaggedValues;
import java.util.Iterator;
import java.util.List;
import org.umlmda.generator.model.util.StringUtil;

// ==== End of generation header ===============================================
%><% @section declare %><%
   /* (non-Javadoc)
    * @see net.sourceforge.umlmda.generator.AbstractWriter#generateOutput()
    */
   public boolean generateOutput() {
      String dbTable = getModelClass().getTaggedValues().getProperty(ModelTaggedValues.DB_TABLE);
      
      return StringUtil.isEmpty(dbTable) == false;
   }

   private java.util.Set foreignKeyNames = new java.util.HashSet();

%><% @section %>
REM <%=getModelClass().getName()%>
CREATE TABLE <%=getDbName()%> (
  -- Parent key properties
<%
   // Parent-Key Properties
   if ( isInheritPKeyFromParent(getModelClass()) ) {
     List keyAttributes = getModelClass().getKeyAttributes();
     for ( Iterator ia = getModelClass().getParent().getKeyAttributes().iterator(); ia.hasNext(); ) {
       ModelAttribute attribute = (ModelAttribute)ia.next();
%>  -- <%=attribute.getName()%>
  <%=getDbName(attribute)%> <%=getType(attribute)%><%=getDbColLength(attribute)%>, 
<%   }
   }
%>  -- Data properties
<% // Properties
   for ( Iterator ia = getAttributes(getModelClass()).iterator(); ia.hasNext(); ) {
     ModelAttribute attribute = (ModelAttribute)ia.next();
     
     if ( attribute.isTransient() == false ) { 
%>  -- <%=attribute.getName()%>
  <%=getDbName(attribute)%> <%=getType(attribute)%><%=getDbColLength(attribute)%>, 
<%   }
   }
%>  -- Definition of the primary key
  PRIMARY KEY (
<%
   // Key Properties
   List keyAttributes = getModelClass().getKeyAttributes();
   for ( Iterator ia = getModelClass().getKeyAttributes().iterator(); ia.hasNext(); ) {
	   ModelAttribute attribute = (ModelAttribute)ia.next();
%>      <%=getDbName(attribute)%><%if (ia.hasNext()) {%>,<%}%>
<% }
%>  )
-- @@UserSection-Begin DDL.CreateTable
-- @@UserSection-End DDL.CreateTable
);
REM Foreign keys
<% 
   // Foreign Keys
   for ( Iterator ia = getModelClass().getAssociations().iterator(); ia.hasNext(); ) {
      ModelAssociation association = (ModelAssociation)ia.next();
      
      String foreignKeyName = getDbName()+"_"+getDbName(association.getTarget());

       if ( !foreignKeyNames.contains(foreignKeyName) &&  (
       				(!association.isMultiple() && !association.getReverse().isMultiple())
      		     || (association.isComposition() && !association.isMultiple()) 
      		     || (!association.isMultiple() && association.getReverse().isMultiple())
      		     || (!association.isComposition() && !association.isMultiple()))) {
      		     
      		     foreignKeyNames.add(foreignKeyName);
      		     
%>REM FK to <%=getDbName(association.getTarget())%>
ALTER TABLE <%=getDbName()%>
  ADD CONSTRAINT FK_<%=foreignKeyName%>
      FOREIGN KEY (<%
  for ( Iterator iat = association.getTarget().getKeyAttributes().iterator(); iat.hasNext(); ) {
    ModelAttribute attribute = (ModelAttribute)iat.next();
%><%=getDbName(attribute)%><%if ( iat.hasNext() ) {%>, <%}
  }
%>)
      REFERENCES <%=getDbName(association.getTarget())%> (<%
  for ( Iterator iat = association.getTarget().getKeyAttributes().iterator(); iat.hasNext(); ) {
    ModelAttribute attribute = (ModelAttribute)iat.next();
%><%=getDbName(attribute)%><%if ( iat.hasNext() ) {%>, <%}
  }
%>)<%if (association.isComposition())%>
   ON DELETE CASCADE;
<%
      }
   }
%>

REM @@UserSection-Begin DDL
REM @@UserSection-End DDL
REM @@UserSection-Begin RCSLog
<%=RcsHelper.writeLog("REM ")%>
REM @@UserSection-End RCSLog