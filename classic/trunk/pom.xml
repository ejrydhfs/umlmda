<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

   <modelVersion>4.0.0</modelVersion>
   <parent>
      <groupId>org.umlmda</groupId>
      <artifactId>org.umlmda.releng</artifactId>
      <version>3.3.0</version>
   </parent>
   <artifactId>org.umlmda.classic</artifactId>
   <version>3.3-SNAPSHOT</version>
   <packaging>pom</packaging>
   <name>UMLMDA Classic</name>
   <description>UMLMDA maven project for umlmda classic modules.</description>

   <properties>
      <umlmda.uml2.profile.version>3.2.0</umlmda.uml2.profile.version>
      <umlmda.generator.profile.version>3.2.0</umlmda.generator.profile.version>
      <umlmda.common.version>3.3</umlmda.common.version>
      <umlmda.oaw.version>3.7</umlmda.oaw.version>
      <umlmda.jostraca.version>3.1</umlmda.jostraca.version>
      <oaw.version>4.2.0</oaw.version>
      <jostraca.version>0.3.3</jostraca.version>
      <uml2.version>2.1.0</uml2.version>
      <emf.version>2.3.0</emf.version>
   </properties>

   <build>
      <sourceDirectory>src</sourceDirectory>
      <testSourceDirectory>test</testSourceDirectory>

      <pluginManagement>
         <plugins>
            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-site-plugin</artifactId>
               <version>2.0-beta-4</version>
            </plugin>
            <plugin>
               <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-project-info-reports-plugin</artifactId>
               <version>2.0.1</version>
            </plugin>
            <plugin>
               <groupId>org.umlmda</groupId>
               <artifactId>org.umlmda.jostraca.maven</artifactId>
               <version>${umlmda.jostraca.version}</version>  
            </plugin>
         </plugins>
      </pluginManagement>


   </build>

   <modules>
      <module>org.umlmda.generator.core</module>
      <module>org.umlmda.generator.uml</module>
   </modules>

   <scm>
      <connection>scm:svn:https://umlmda.svn.sourceforge.net/svnroot/umlmda/classic/trunk</connection>
      <developerConnection>scm:svn:https://umlmda.svn.sourceforge.net/svnroot/umlmda/classic/trunk</developerConnection>
   </scm>

   <dependencyManagement>
      <dependencies>
         <!-- Apache stuff -->
         <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity</artifactId>
            <version>1.5</version>
         </dependency>
         <dependency>
            <groupId>ant</groupId>
            <artifactId>ant</artifactId>
            <version>1.6.5</version>
         </dependency>
         <!-- Freemarker -->
         <dependency>
            <groupId>freemarker</groupId>
            <artifactId>freemarker</artifactId>
            <version>2.3.9</version>
         </dependency>
         <!-- EMF -->
         <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>ecore</artifactId>
            <version>${emf.version}</version>
            <scope>provided</scope>
            <exclusions>
               <exclusion>
                  <groupId>org.eclipse.core</groupId>
                  <artifactId>runtime</artifactId>
               </exclusion>
            </exclusions>
         </dependency>
         <!-- UML2 -->
         <dependency>
            <groupId>org.eclipse.uml2</groupId>
            <artifactId>resources</artifactId>
            <version>${uml2.version}</version>
            <scope>provided</scope>
         </dependency>
         <dependency>
            <groupId>org.eclipse.uml2</groupId>
            <artifactId>uml</artifactId>
            <version>${uml2.version}</version>
            <scope>provided</scope>
            <exclusions>
               <exclusion>
                  <groupId>org.eclipse.core</groupId>
                  <artifactId>runtime</artifactId>
               </exclusion>
            </exclusions>
         </dependency>
         <dependency>
            <groupId>org.eclipse.uml2</groupId>
            <artifactId>uml-ecore-importer</artifactId>
            <version>${uml2.version}</version>
            <scope>provided</scope>
            <exclusions>
               <exclusion>
                  <groupId>org.eclipse.core</groupId>
                  <artifactId>runtime</artifactId>
               </exclusion>
            </exclusions>
         </dependency>
         <!-- oAW -->
         <dependency>
            <groupId>org.openarchitectureware</groupId>
            <artifactId>oaw-core-expressions</artifactId>
            <version>${oaw.version}</version>
            <scope>provided</scope>
         </dependency>
         <dependency>
            <groupId>org.openarchitectureware</groupId>
            <artifactId>oaw-core-workflow</artifactId>
            <version>${oaw.version}</version>
            <scope>provided</scope>
         </dependency>
         <dependency>
            <groupId>org.openarchitectureware</groupId>
            <artifactId>oaw-core-xpand2</artifactId>
            <version>${oaw.version}</version>
            <scope>provided</scope>
            <exclusions>
               <exclusion>
                  <groupId>org.eclipse.jdt</groupId>
                  <artifactId>core</artifactId>
               </exclusion>
            </exclusions>
         </dependency>
         <dependency>
            <groupId>org.openarchitectureware</groupId>
            <artifactId>oaw-util-stdlib</artifactId>
            <version>${oaw.version}</version>
            <scope>provided</scope>
         </dependency>
         <dependency>
            <groupId>org.openarchitectureware</groupId>
            <artifactId>oaw-uml2-adapter</artifactId>
            <version>${oaw.version}</version>
            <!-- 
               <exclusions>
               <exclusion>
               <groupId>org.eclipse.jdt</groupId>
               <artifactId>core</artifactId>
               </exclusion>
               </exclusions> -->
         </dependency>

         <!-- UMLMDA Common -->
         <dependency>
            <groupId>${parent.groupId}</groupId>
            <artifactId>org.umlmda.umlmodel.uml2</artifactId>
            <version>${umlmda.common.version}</version>
         </dependency>
         <dependency>
            <groupId>${parent.groupId}</groupId>
            <artifactId>org.umlmda.umlmodel.nsuml</artifactId>
            <version>${umlmda.common.version}</version>
         </dependency>
         <dependency>
            <groupId>${parent.groupId}</groupId>
            <artifactId>org.umlmda.generator.uml.psm</artifactId>
            <version>${umlmda.common.version}</version>
         </dependency>

      </dependencies>
   </dependencyManagement>


   <repositories>
      <repository>
         <id>artifactory</id>
         <url>http://coding.ds2k.de/artifactory/repo</url>
         <releases>
            <enabled>true</enabled>
         </releases>
         <snapshots>
            <enabled>true</enabled>
         </snapshots>
      </repository>
      <repository>
         <id>cor-artifactory</id>
         <url>http://cor-health-dev1:8090/artifactory/repo</url>
         <releases>
            <enabled>true</enabled>
         </releases>
         <snapshots>
            <enabled>true</enabled>
         </snapshots>
      </repository>
   </repositories>

</project>