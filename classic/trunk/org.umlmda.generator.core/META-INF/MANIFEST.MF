Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: UMLMDA Generator Core Plug-in
Bundle-SymbolicName: org.umlmda.generator.core; singleton:=true
Bundle-Version: 3.0.1.qualifier
Bundle-ClassPath: runtime/org.umlmda.generator.core.jar
Bundle-Activator: org.umlmda.generator.plugin.GeneratorPlugin
Bundle-Vendor: www.umlmda.org
Bundle-Localization: plugin
Require-Bundle: org.apache.log4j,
 org.apache.jakarta.oro;visibility:=reexport,
 org.apache.commons.lang,
 org.apache.commons.collection,
 org.apache.velocity;visibility:=reexport,
 org.apache.ant,
 org.freemarker;visibility:=reexport,
 org.antlr;resolution:=optional;visibility:=reexport,
 org.eclipse.core.runtime,
 org.umlmda.model.profile;visibility:=reexport,
 org.umlmda.umlmodel;visibility:=reexport,
 org.umlmda.generator.profile;visibility:=reexport,
 org.umlmda.generator.model;visibility:=reexport,
 org.openarchitectureware.dependencies;resolution:=optional,
 org.umlmda.generator.uml.oaw;resolution:=optional
Eclipse-LazyStart: true
Export-Package: org.umlmda.generator,
 org.umlmda.generator.anttask,
 org.umlmda.generator.model.pattern,
 org.umlmda.generator.plugin,
 org.umlmda.generator.writer
Bundle-RequiredExecutionEnvironment: J2SE-1.5
