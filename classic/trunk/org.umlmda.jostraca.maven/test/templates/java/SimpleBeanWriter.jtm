   }
   
   genClass.resetImports();
   genClass.registerImport(JavaArtefacts.BUSINESS_OBJECT_INTERFACE);
   if ( genSuperClass != null ) {
      genClass.registerImport(JavaArtefacts.BUSINESS_OBJECT, genSuperClass);
   }
   genClass.registerImports(JavaArtefacts.BUSINESS_OBJECT_INTERFACE, genClass.getReferencedTypes(), ModelStereotype.BUSINESS_OBJECT);
   genClass.registerImports(JavaArtefacts.ENUMERATION, genClass.getReferencedTypes(), ModelStereotype.ENUMERATION);
   genClass.registerImports(JavaArtefacts.BUSINESS_EXCEPTION, genClass.getReferencedTypes(), ModelStereotype.BUSINESS_EXCEPTION);
   if ( implVisitable ) {
      genClass.registerImport(JavaArtefacts.VISITOR, genPackage);
