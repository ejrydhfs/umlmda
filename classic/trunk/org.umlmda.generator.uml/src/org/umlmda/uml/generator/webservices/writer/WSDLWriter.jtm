<% @conf 
main.JostracaVersion       = 0.3
main.CodeWriter            = WSDLWriter
main.CodeWriterFormat	   = format/ParentJavaWriterFormat.jwf
java.CodeWriter.package    = org.umlmda.uml.generator.webservices.writer
java.CodeWriter.extends    = AbstractWSDLWriter
%><% import!
import java.util.Iterator;
import java.util.List;
import org.umlmda.model.uml.*;
import org.umlmda.uml.generator.webservices.*;

// ==== End of generation header ===============================================
%><% @section declare %><%

%><% @section %><%
   WSModelClass genClass = (WSModelClass)getGenClass();
   WSModelPackage genPackage = (WSModelPackage)genClass.getGeneratorPackage();
   WSModel genModel = (WSModel)genClass.getGeneratorModel();
   String xmlEncoding = getProperties().getProperty("xmlEncoding", "ISO-8859-1");
   String soapBindingTag = "";
   String soapEncodingTag = "";
   String soapEncodingStyleTag = "";
   String soapBinding = getProperties().getProperty("soapBinding", "rpc");
   String soapEncoding = getProperties().getProperty("soapEncoding", "encoded");
   boolean soapWrapping = genModel.isSoapWrapping();

   if ( soapBinding.equals("rpc" ) ) {
      soapBindingTag = "rpc";
   }
   else if ( soapBinding.equals("document" ) ) {
      soapBindingTag = "document";
   }
   else {
      throw new RuntimeException("Invalid soapBinding "+soapBinding+" specified, only rpc or document supported");
   }

   if ( soapEncoding.equals("encoded") ) {
      soapEncodingTag = "encoded";
      soapEncodingStyleTag = " encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\"";
   }
   else if ( soapEncoding.equals("literal") ) {
      soapEncodingTag = "literal";
   }
   else {
      throw new RuntimeException("Invalid soapEncoding "+soapEncoding+" specified, only encoded or literal supported");
   }

%><?xml version="1.0" encoding="<%=xmlEncoding%>"?>
<!-- @@Generated file, please edit UserSections only -->

<wsdl:definitions 
  targetNamespace="<%=getType(getModelClass().getPackage())%>" 
  xmlns:apachesoap="http://xml.apache.org/xml-soap" 
  xmlns:wsdlsoap="http://schemas.xmlsoap.org/wsdl/soap/" 
  xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/" 
  xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
<% // Loop required packages
   final List classList = getModelClass().getSchemaTypes();
   final List packageList = UMLModelHelper.getPackagesFromClassList( classList);
   int index=1;
   for ( Iterator iter = packageList.iterator(); iter.hasNext(); ++index) {
      ModelPackage modelPackage = (ModelPackage)iter.next();
%>  xmlns:tns<%=index%>="<%=getType(modelPackage)%>" 
<% }  
%>  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
 <wsdl:types>
<% // Loop required packages
   for ( Iterator ip = packageList.iterator(); ip.hasNext(); ) {
      ModelPackage modelPackage = (ModelPackage)ip.next();
%>  
  <schema xmlns="http://www.w3.org/2001/XMLSchema" 
          targetNamespace="<%=getType(modelPackage)%>">
<%    if ( soapEncodingTag.equals("encoded") ) {%>
    <import namespace="http://schemas.xmlsoap.org/soap/encoding/"/>
<%    }%>    
<% // Loop required types
     for ( Iterator iter = getReferencedClasses(modelPackage).iterator(); iter.hasNext(); ) {
        ModelClass modelClass = (ModelClass)iter.next();
        
        if ( modelClass.hasStereotype("BusinessObject") == false )
           continue;
%>   
  <complexType name="<%=modelClass.getName()%>">
<%      if ( modelClass.getSuperClass() != null ) {
%>    <complexContent>
     <extension base="<%=getType(modelClass.getSuperClass())%>">
<%      }
%>     <sequence>
<%      // Attributes
        for ( Iterator ia = modelClass.getAttributes().iterator(); ia.hasNext(); ) {
          ModelAttribute attribute = (ModelAttribute)ia.next();
%>       <element name="<%=attribute.getName()%>" nillable="true" type="<%=getType(attribute)%>"/>         
<%      }
        // Assocations
        for ( Iterator ia = modelClass.getAssociations().iterator(); ia.hasNext(); ) {
          ModelAssociation association = (ModelAssociation)ia.next();
          if ( association.isNavigatableToTarget() ) {
            if ( association.isMultiple() ) {
%>       <element name="<%=association.getName()%>" minOccurs="0" maxOccurs="unbounded" type="<%=getTypeOrHierarchie(association.getTarget())%>"/>
<%          } else {
%>       <element name="<%=association.getName()%>" nillable="true" type="<%=getTypeOrHierarchie(association.getTarget())%>"/>
<%          }
          }
        }
%>     </sequence>
<%      if ( modelClass.getSuperClass() != null ) {
%>    </extension>
    </complexContent>
<%      }
%>  </complexType>
<%      if ( hasDerivedClasses(modelClass) ) {
%>    <complexType name="<%=modelClass.getName()%>Hierarchie">
      <choice>
<%         for ( Iterator id = getDerivedClasses(modelClass).iterator(); id.hasNext(); ) {
              ModelClass derivedClass = (ModelClass)id.next();
%>        <element name="<%=derivedClass.getName()%>" type="<%=getType(derivedClass)%>"/>
<%         }
%>      </choice>
    </complexType>
<%      }
     } // for
%>
  </schema>
<% }
%>  
 </wsdl:types>

<% // Modelled Methods
   for ( Iterator ia = getModelClass().getMethods(true).iterator(); ia.hasNext(); ) {
     ModelMethod method = (ModelMethod)ia.next();
%>  
   <wsdl:message name="<%=method.getName()%>Request">
<%   for ( Iterator ip = method.getParameters().iterator(); ip.hasNext(); ) {
        ModelParameter parameter = (ModelParameter)ip.next();
%>      <wsdl:part name="<%=parameter.getName()%>" type="<%=getTypeOrHierarchie(parameter.getType())%>"/>
<%   }
%>   </wsdl:message>
<%    if ( method.getReturnType() != null && method.getReturnType().getName().equals("void") == false ) {
%>   <wsdl:message name="<%=method.getName()%>Response">
      <wsdl:part name="return" type="<%=getTypeOrHierarchie(method.getReturnType())%>"/>
   </wsdl:message>
<%    }
      for ( Iterator ie = method.getExceptions().iterator(); ie.hasNext(); ) {
        ModelClass exception = (ModelClass)ie.next();
%>   <wsdl:message name="<%=method.getName()%><%=exception.getName()%>">
    <wsdl:part name="fault" type="<%=getType(exception)%>"/>
   </wsdl:message>
<%    }        
   }
%>

<% @include WSDLPortService.jti template-relative %>

</wsdl:definitions>
