<%// $Header: /cvsroot/umlmda/UMLGenerator/src/org/umlmda/uml/generator/webservices/writer/OptimizedWSDLWriter.jtm,v 1.8 2006/07/10 08:00:56 moroff Exp $
//
// Copyright (C) 2005 Dieter Moroff
//
// This file is part of UMLMDA (http://www.umlmda.org)
// 
// OptimizedWSDLWriter generates WSDL files from <<BusinessService>> model elements.
//
// optimization measures:
// <<Out>> attributes are stripped from ingoing DTOs
// <<In>> attributes are stripped from outgoing DTOs
//
%><% @conf 
main.JostracaVersion       = 0.3
main.CodeWriter            = OptimizedWSDLWriter
main.CodeWriterFormat	   = format/ParentJavaWriterFormat.jwf
java.CodeWriter.package    = org.umlmda.uml.generator.webservices.writer
java.CodeWriter.extends    = AbstractWSDLWriter
%><% import!
import org.apache.commons.lang.StringUtils;
import java.beans.Introspector;
import java.util.Iterator;
import java.util.List;

import org.umlmda.model.uml.*;
import org.umlmda.profile.ModelStereotype;
import org.umlmda.uml.generator.webservices.*;

// ==== End of generation header ===============================================
%><% @section declare %><%
%><% @section %><%
   WSModelClass genClass = (WSModelClass)getGenClass();
   WSModelPackage genPackage = (WSModelPackage)genClass.getGeneratorPackage();
   WSModel genModel = (WSModel)genClass.getGeneratorModel();
   String xmlEncoding = genModel.getArtefact().getProperties().getProperty("xmlEncoding", "ISO-8859-1");
   String soapBindingTag = "";
   String soapEncodingTag = "";
   String soapEncodingStyleTag = "";
   String soapBinding = genModel.getArtefact().getProperties().getProperty("soapBinding", "rpc");
   String soapEncoding = genModel.getArtefact().getProperties().getProperty("soapEncoding", "encoded");
   boolean soapWrapping = genModel.isSoapWrapping();
   boolean packageFilter = true;

   String  modularizedModePpt = genModel.getArtefact().getProperties().getProperty("modularizedMode", "false");
   boolean useModularizedMode = modularizedModePpt.equals("true");
   String  schemaNameImportExt = useModularizedMode ? "/import" : "";

   if ( soapBinding.equals("rpc" ) ) {
      soapBindingTag = "rpc";
   }
   else if ( soapBinding.equals("document" ) ) {
      soapBindingTag = "document";
   }
   else {
      throw new RuntimeException("Invalid soapBinding "+soapBinding+" specified, only rpc or document supported");
   }

   if ( soapEncoding.equals("encoded") ) {
      soapEncodingTag = "encoded";
      soapEncodingStyleTag = " encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\"";
   }
   else if ( soapEncoding.equals("literal") ) {
      soapEncodingTag = "literal";
   }
   else {
      throw new RuntimeException("Invalid soapEncoding "+soapEncoding+" specified, only encoded or literal supported");
   }

%><?xml version="1.0" encoding="<%=xmlEncoding%>"?>
<!-- @@Generated file, please edit UserSections only -->
<wsdl:definitions 
  targetNamespace="<%=getType(getModelClass().getPackage())%>" 
  xmlns:apachesoap="http://xml.apache.org/xml-soap" 
  xmlns:wsdlsoap="http://schemas.xmlsoap.org/wsdl/soap/" 
  xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/" 
  xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
<% // Loop required packages
   final List classList = getModelClass().getSchemaTypes();
   final List packageList = UMLModelHelper.getPackagesFromClassList( classList);
   int index=1;
   for ( Iterator iter = packageList.iterator(); iter.hasNext(); ++index) {
      WSModelPackage modelPackage = (WSModelPackage)iter.next();
%>  xmlns:<%=modelPackage.getNamespacePrefix(genPackage)%>="<%=getType(modelPackage)%>" 
<% }  
%>  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
 <wsdl:types>
<% // Loop required packages
   for ( Iterator ipkg = packageList.iterator(); ipkg.hasNext(); ) {
      ModelPackage modelPackage = (ModelPackage)ipkg.next();
%>  <schema xmlns="http://www.w3.org/2001/XMLSchema" 
          targetNamespace="<%=getType(modelPackage) + schemaNameImportExt%>">
<%    if ( soapEncodingTag.equals("encoded") ) {%>
    <import namespace="http://schemas.xmlsoap.org/soap/encoding/"/>
<%    }%>
<%    if (useModularizedMode) {%>
          <import namespace="<%=getType(modelPackage)%>" schemaLocation="<%=modelPackage.getName() + ".xsd"%>"/> 
<%    }
      else {   %> 
          <% @include OptimizedSchema.jti template-relative %>
<%    } %>
  </schema>
<% } // Loop required packages %>
 </wsdl:types>

<% // Modelled Methods
   for ( Iterator ia = getModelClass().getMethods(true).iterator(); ia.hasNext(); ) {
     ModelMethod method = (ModelMethod)ia.next();
     WSModelClass serviceClass = (WSModelClass)method.getOwningClass();
     WSModelPackage serviceComponent = (WSModelPackage)serviceClass.getPackage();
     
     String requestName = method.getName() + "Request";
     String responseName = method.getName() + "Response";
%>  
   <wsdl:message name="<%=requestName%>">
<%   for ( Iterator ip = method.getParameters().iterator(); ip.hasNext(); ) {
           ModelParameter parameter = (ModelParameter)ip.next();
           WSModelClassifier classifier = (WSModelClassifier)parameter.getType();
        if ( soapBinding.equals("document") ) {
%>      <wsdl:part name="<%=parameter.getName()%>" element="<%=classifier.getSchemaType()%>Element"/>
<%      } else {
%>      <wsdl:part name="<%=parameter.getName()%>" type="<%=classifier.getSchemaType()%>"/>
<%      }
     } // for
%>   </wsdl:message>
<%    if ( method.getReturnType() != null ) {
           WSModelClassifier returnClassifier = (WSModelClassifier)method.getReturnType();

%>   <wsdl:message name="<%=responseName%>">
<%       if ( soapBinding.equals("document") ) {
%>      <wsdl:part name="returnValue" element="<%=returnClassifier.getSchemaType()%>Element"/>
<%       } else {
%>      <wsdl:part name="returnValue" type="<%=returnClassifier.getSchemaType()%>"/>
<%       }
%>   </wsdl:message>
<%    }

      for ( Iterator ie = method.getExceptions().iterator(); ie.hasNext(); ) {
        ModelClass exception = (ModelClass)ie.next();
%>   <wsdl:message name="<%=method.getName()%><%=exception.getName()%>">
    <wsdl:part name="fault" element="<%=getType(exception)%>Element"/>
   </wsdl:message>
<%    }        
   }
%>

<% @include WSDLPortService.jti template-relative %>

</wsdl:definitions>
