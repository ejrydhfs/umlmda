import javax.jws.soap.SOAPBinding;
import javax.xml.bind.annotation.XmlSeeAlso;

<%=genClass.registeredImports()%>

@Stateless
@TransactionAttribute(TransactionAttributeType.NEVER)
@WebService(name = "<%=genClass.getGeneratedName(WSArtefacts.WS_SERVICE_PORT)%>", targetNamespace = "<%=genPackage.getNamespace()%>")
@SOAPBinding(style = SOAPBinding.Style.RPC)
public class <%=getBaseName()%> implements <%=genClass.getScopedName("jaxWs.WSPortLocal")%> {
   <%=logging.initDeclaration()%>
<% for ( Iterator ip = packageList.iterator(); ip.hasNext(); ) {
     WSModelPackage modelPackage = (WSModelPackage)ip.next();
     JavaModelPackage pimPackage = modelPackage.getPIMPackage();
     String factoryClass = genClass.getScopedName(JavaArtefacts.BUSINESS_FACTORY, pimPackage);
%>   private <%=factoryClass%> <%=getFactoryMember(pimPackage)%> = null;
<% }
%>   @EJB (beanInterface=<%=genClass.getScopedName(JavaArtefacts.BUSINESS_SERVICE_INTERFACE, pimClass)%>Local.class)
   private final <%=genClass.getScopedName(JavaArtefacts.BUSINESS_SERVICE_INTERFACE, pimClass)%> delegate;
   private <%=genClass.getScopedName(WSArtefacts.WS_UTILS)%> utils = new <%=genClass.getScopedName(WSArtefacts.WS_UTILS)%>();

   /**
    * Construktor, creates factories and creates delegate
    */
   public <%=getBaseName()%>() {
      super();
      delegate = <%=getFactoryMember(((WSModelPackage)getModelClass().getPackage()).getPIMPackage())%>.create<%=getModelClass().getName()%>();
<% for ( Iterator ip = packageList.iterator(); ip.hasNext(); ) {
     WSModelPackage modelPackage = (WSModelPackage)ip.next();
     JavaModelPackage pimPackage = modelPackage.getPIMPackage();
     String factoryName = StringUtils.capitalize(pimPackage.getName());
%>      utils.set<%=factoryName%>Factory(<%=getFactoryMember(pimPackage)%>);
<% }
%>   }

<% // Modelled Methods
   for ( Iterator im = getModelClass().getMethods(true).iterator(); im.hasNext(); ) {
     WSModelMethod method = (WSModelMethod)im.next();
     JavaModelMethod pimMethod = method.getPIMMethod();
%>   /**
    * <%=method.getDocumentation()%>
    */
    public <%=method.getWebServiceSignature()%> {
       try {
<%  WSModelParameter requestParameter = (WSModelParameter)method.getParameters().get(0);
    WSModelClass requestClass = (WSModelClass)requestParameter.getType();
 
    if ( genModel.isSoapWrapping() ) {
       for ( Iterator ip = requestClass.getAttributes().iterator(); ip.hasNext(); ) {
         WSModelAttribute parameterAttr = (WSModelAttribute)ip.next();
         
         if ( parameterAttr.getModelClassifier() instanceof ModelDataType ) {
%>       <%=parameterAttr.getJavaType()%> <%=parameterAttr.getName()%> = <%=parameterAttr.getConvertFromWs("request")%>;
<%       } else {
            JavaModelClass pimParameterClass = ((WSModelClass)parameterAttr.getModelClass()).getPIMClass();
%>       <%=pimParameterClass.getJavaType()%> <%=parameterAttr.getName()%> = utils.create<%=pimParameterClass.getName()%>(request.<%=parameterAttr.getGetter()%>());
<%       }
       } // for
     } else {     
%>       <%=requestClass.getPIMClass().getJavaType()%> bs<%=requestParameter.getName()%> = utils.create<%=requestClass.getPIMClass().getName()%>(<%=requestParameter.getName()%>);
<%   }       
     if ( pimMethod.getReturnType() != null ) {
%>         <%=pimMethod.getJavaType()%> result;
         
         utils.resolveReferences();
         result = <% 
     } else {
%>
         utils.resolveReferences();
         <%
     }
%><%=getCallDelegateSignature("delegate", "bs", false, pimMethod)%>
<%   if ( genModel.isSoapWrapping() ) {
        WSModelClass reponseClass = (WSModelClass)method.getReturnType();
%>         <%=method.getWebServiceType()%> wsReturn 
            = new <%=method.getWebServiceType()%>();
         utils.resetReferences();   
<%      if ( pimMethod.getReturnType() instanceof ModelClass ) {
           WSModelClass returnClass = (WSModelClass)((ModelAttribute)reponseClass.getAttributes().get(0)).getModelClass();
%>         wsReturn.setReturnValue(utils.create<%=returnClass.getName()%>(result));
<%      } else if ( pimMethod.getReturnType() instanceof ModelDataType ) {
           WSModelDataType returnType = (WSModelDataType)pimMethod.getReturnType();
           
%>         wsReturn.setReturnValue(<%=returnType.getConvertToWs()%>(result));
<%      }
%>         utils.resolveReferences();  
         return wsReturn;  
<%   } 
     else if ( method.getReturnType() != null ) {
        if ( method.getReturnType() instanceof ModelClass ) {
%>         utils.resetReferences();
         <%=((WSModelClass)method.getReturnType()).getJavaType()%> convertedResult = utils.create<%=method.getReturnType().getName()%>(result);
         utils.resolveReferences();
         return convertedResult;
<%      } else {
%>	       return WebserviceUtils.convertToWs(result);
<%      }
     }
     for ( Iterator ie = method.getExceptions().iterator(); ie.hasNext(); ) {
       WSModelClass exception = (WSModelClass)ie.next();
       WSModelPackage exceptionPackage = (WSModelPackage) exception.getPackage();
       JavaModelClass pimException = exception.getPIMClass();
%>      } catch (<%=genClass.getQualifiedName(JavaArtefacts.BUSINESS_EXCEPTION, pimException)%> e) {
         <%=exception.getScopedName(WSArtefacts.WS_STUB)%> exception = utils.create<%=exception.getName()%>(e);
         utils.resolveReferences();
         throw new <%=exceptionPackage.getQualifiedPackageName(WSArtefacts.WS_STUB)+"."+StringUtils.capitalize(method.getName())+exception.getGeneratedName(WSArtefacts.WS_STUB)%>(e.getMessage(), exception);
<%   }
%>      } finally {
         utils.resetReferences();
      }
   }
<%     
   }

   if ( springSupport ) {
%>   
   /**
    *
    */
   protected void init() throws ServiceException {
<% for ( Iterator ip = packageList.iterator(); ip.hasNext(); ) {
     WSModelPackage modelPackage = (WSModelPackage)ip.next();
     JavaModelPackage pimPackage = modelPackage.getPIMPackage();
     String factoryClass = genClass.getScopedName(JavaArtefacts.BUSINESS_FACTORY, pimPackage);
%>      <%=getFactoryMember(pimPackage)%> = (<%=factoryClass%>) getBeanFactory().getBean("<%=pimPackage.getQualifiedName(JavaArtefacts.BUSINESS_FACTORY)%>", <%=factoryClass%>.class);
<% }
%>
   }
   
   /**
    * Get the bean factory and register the bean factory with the name "BeanFactory"
    */      
    protected BeanFactory getBeanFactory() {
      BeanFactory beanFactory = getApplicationContext();

      if ( beanFactory.getType("BeanFactory") == null ) {
         register("BeanFactory", beanFactory);
      }
      return beanFactory;
   }
   
   private void register(String contextName, Object singleton) {
      BeanFactory beanFactory = getApplicationContext();
      
      if (beanFactory instanceof ConfigurableBeanFactory) {
         ConfigurableBeanFactory configurableBeanFactory = (ConfigurableBeanFactory)beanFactory;
         
         configurableBeanFactory.registerSingleton(contextName, singleton);
      }
      else if (beanFactory instanceof ConfigurableApplicationContext) {
         ConfigurableApplicationContext applicationContext = (ConfigurableApplicationContext)beanFactory;
         
         applicationContext.getBeanFactory().registerSingleton(contextName, singleton);
      }
      else {
         throw new RuntimeException("Unable to regsiter a bean in the beanFactory "+beanFactory.getClass().toString());
      }
   }

   /**
    * Create a new bean factory searching a xml file in the classpath called <b>applicationContext-ws.xml</b>.
    */
   private BeanFactory getApplicationContext() {
      ClassPathXmlApplicationContext applicationContext = new ClassPathXmlApplicationContext("applicationContext-ws.xml");
      
      return applicationContext;
   }


<% }
%>
