<%=RcsHelper.writeHeader("// ")%>
//@@UserSection-End RCSHeader

package <%=getPackageName()%>;

<% WSModelClass genClass = (WSModelClass)getGenClass();
   JavaModelClass pimClass = genClass.getPIMClass();
   WSModelPackage genPackage = (WSModelPackage)genClass.getPackage();
   WSModel genModel = (WSModel)genClass.getGeneratorModel();
   final List classList = getModelClass().getSchemaTypes();
   final List packageList = UMLModelHelper.getPackagesFromClassList( classList);
   LoggingWriter logging = genModel.getLoggingWriter();
   boolean springSupport = genModel.isSpringSupported();

   genClass.resetImports();
   genClass.registerImport(WSArtefacts.WS_UTILS);
   genClass.registerImport(WSArtefacts.WS_SERVICE_PORT);
   genClass.getScopedName(JavaArtefacts.BUSINESS_SERVICE_INTERFACE, pimClass);
   for ( Iterator ip = packageList.iterator(); ip.hasNext(); ) {
      WSModelPackage modelPackage = (WSModelPackage)ip.next();
      JavaModelPackage pimPackage = modelPackage.getPIMPackage();
      
      genClass.registerImport(JavaArtefacts.BUSINESS_FACTORY, pimPackage);
   }

%><%=logging.importDeclaration()%>

<% if ( springSupport ) {
%>import javax.xml.rpc.ServiceException;

import org.springframework.beans.factory.BeanFactory;
import org.springframework.beans.factory.config.ConfigurableBeanFactory;
import org.springframework.context.ConfigurableApplicationContext;
import org.springframework.context.support.ClassPathXmlApplicationContext;

<% } 
%>import org.umlmda.runtime.webservice.WebserviceUtils;
