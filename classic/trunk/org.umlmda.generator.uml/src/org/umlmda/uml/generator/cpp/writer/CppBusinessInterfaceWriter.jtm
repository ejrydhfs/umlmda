      ModelClassifier targetClass = association.getTarget();
      if ( !association.isUnspecified() ) {
         if ( association.isMultiple() ) {
%>
   virtual const std::list<<%=getType(targetClass)%> *> &get<%=StringUtil.firstToUpperCase(association.getName())%>List() const = 0;
   virtual       std::list<<%=getType(targetClass)%> *> &get<%=StringUtil.firstToUpperCase(association.getName())%>List() = 0;
<%       } else {
%>
   virtual const <%=getType(targetClass)%> &get<%=StringUtil.firstToUpperCase(association.getName())%>() const = 0;
   virtual       <%=getType(targetClass)%> *get<%=StringUtil.firstToUpperCase(association.getName())%>() = 0;
   virtual void set<%=StringUtil.firstToUpperCase(association.getName())%>(<%=getType(targetClass)%> *) = 0;
<%       }
      }
   } // for 
