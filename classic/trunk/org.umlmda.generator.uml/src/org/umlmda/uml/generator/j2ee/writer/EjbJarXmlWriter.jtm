<% @conf 
main.JostracaVersion       = 0.3
main.CodeWriter            = EjbJarXmlWriter
main.CodeWriterFormat	     = format/ParentJavaWriterFormat.jwf
java.CodeWriter.package    = org.umlmda.uml.generator.j2ee.writer
java.CodeWriter.extends    = org.umlmda.uml.generator.j2ee.AbstractPackageWriter
%><% import!
import java.util.Iterator;
import org.umlmda.model.uml.*;
import org.umlmda.profile.ModelStereotype;
import org.umlmda.uml.generator.java.*;
import org.umlmda.uml.generator.j2ee.*;
// ==== End of generation header ===============================================
%><% @section declare %><%
%><% @section %><%
   J2EEModelPackage genPackage = (J2EEModelPackage)getGenPackage();
   J2EEModel genModel = (J2EEModel)genPackage.getGeneratorModel();
%><?xml version="1.0" encoding="ISO-8859-1"?>
<!-- Generated file, please edit UserSections only -->
<% if ( "2.0".equals(genModel.getJ2EESpec()) ) {
%><!DOCTYPE ejb-jar PUBLIC "-//Sun Microsystems, Inc.//DTD Enterprise JavaBeans 2.0//EN" "http://java.sun.com/dtd/ejb-jar_2_0.dtd">
<ejb-jar id="ejb-jar_ID">
<% } else {
%><ejb-jar id="ejb-jar_ID" 
         version="2.1" xmlns="http://java.sun.com/xml/ns/j2ee" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/ejb-jar_2_1.xsd">
<% }%>

   <description>Sessionbeans for services from model package <%=genPackage.getQualifiedName()%></description>
<!-- UserSection-Begin display-name -->
   <display-name><%=genPackage.getComponent()%>, generated by UMLMDA</display-name>
<!-- UserSection-End display-name -->

   <enterprise-beans>

      <!-- Session Beans -->
<% 
   for ( Iterator ia = getModelPackage().getClasses().iterator(); ia.hasNext(); ) {
	   J2EEModelClass modelClass = (J2EEModelClass)ia.next();
	   J2EEModelPackage modelPackage = (J2EEModelPackage)modelClass.getGeneratorPackage();
	   
     
     if ( modelClass.hasStereotype(ModelStereotype.BUSINESS_SERVICE) && modelClass.isAbstract() == false ) {
        String modelClassName = modelClass.getName();
        String homeInterface = modelClass.getScopedName(J2EEArtefacts.HOME_INTERFACE);
        String localHomeInterface = modelClass.getScopedName(J2EEArtefacts.LOCAL_HOME_INTERFACE);
        String remoteInterface = modelClass.getScopedName(J2EEArtefacts.REMOTE_INTERFACE);
        String localInterface = modelClass.getScopedName(J2EEArtefacts.LOCAL_INTERFACE);
        String sessionBean  = modelClass.getScopedName(J2EEArtefacts.SESSION_BEAN);
        String sessionType = modelClass.isStateful() ? "Stateful" : "Stateless";
%>      <session id="<%=modelClassName%>">
         <description><![CDATA[
         ]]></description>

         <ejb-name><%=modelClassName%></ejb-name>
         <home><%=homeInterface%></home>
         <remote><%=remoteInterface%></remote>
         <local-home><%=localHomeInterface%></local-home>
         <local><%=localInterface%></local>
         <ejb-class><%=sessionBean%></ejb-class>
         <session-type><%=sessionType%></session-type>
         <transaction-type>Container</transaction-type>
<!-- UserSection-Begin <%=modelClassName%> -->
<!-- UserSection-End <%=modelClassName%> -->
      </session>

<%   }     
   } 
%>    
<!-- UserSection-Begin enterprise-beans -->
<!-- UserSection-End enterprise-beans -->
   </enterprise-beans>
   
   <!-- Assembly Descriptor -->
   <assembly-descriptor >
<!-- UserSection-Begin assembly-descriptor-security -->   
<!-- UserSection-End assembly-descriptor-security -->

     <!-- transactions -->
<% for ( Iterator it = getTransactionTypes().iterator(); it.hasNext(); ) {
     String transactionType = (String)it.next();
%>     <!-- <%=transactionType%> -->
     <container-transaction>
<%   for ( Iterator ia = getModelPackage().getClasses().iterator(); ia.hasNext(); ) {
	   J2EEModelClass modelClass = (J2EEModelClass)ia.next();
       String modelClassName = modelClass.getName();

       if ( modelClass.hasStereotype(ModelStereotype.BUSINESS_SERVICE) == false ) 
		 continue;
		 
       for ( Iterator im = getMethods(modelClass, transactionType).iterator(); im.hasNext(); ) {
         ModelMethod method = (ModelMethod)im.next();

%>       <method>
         <ejb-name><%=modelClass.getName()%></ejb-name>
         <method-intf>Remote</method-intf>
         <method-name><%=method.getName()%></method-name>
<%       if ( method.getParameters().size() > 0 ) {
%>         <method-params>
<%         for ( Iterator ip = method.getParameters().iterator(); ip.hasNext(); ) {
             ModelParameter parameter = (ModelParameter)ip.next();
             JavaModelClassifier classifier = (JavaModelClassifier)parameter.getType();
             
%>           <method-param><%=classifier.getJavaType()%></method-param>
<%         } // for
%>         </method-params>
<%       } // if
%>       </method>
<%     }
     }
%>       <trans-attribute><%=transactionType%></trans-attribute>
     </container-transaction>
     
<% }
%><!-- UserSection-Begin assembly-descriptor -->
<!-- UserSection-End assembly-descriptor -->
   </assembly-descriptor>
   
</ejb-jar>