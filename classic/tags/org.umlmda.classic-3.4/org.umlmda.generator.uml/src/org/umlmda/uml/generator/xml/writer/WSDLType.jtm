  <complexType name="<%=modelClass.getName()%><%=direction%>">
<%  if ( modelClass.getSuperClass() != null ) {
       WSModelClass superClass = (WSModelClass)modelClass.getSuperClass();
%>    <complexContent>
     <extension base="<%=superClass.getDirectionType(direction)%>">
<% }
%>     <sequence>
<%      // Attributes
    for ( Iterator ia = modelClass.getAttributes().iterator(); ia.hasNext(); ) {
      WSModelAttribute attribute = (WSModelAttribute)ia.next();
      String maxOccursTag = attribute.isMultivalue() ? " maxOccurs=\"unbounded\"" : "";
      String minOccursTag = attribute.isMultivalue() && attribute.isOptional() ? " minOccurs=\"0\"" : "";
      if ( attribute.matchDirection(direction) == false ) 
        continue;
%>       <element name="<%=attribute.getName()%>" nillable="true" type="<%=attribute.getSchemaType()%>"<%=minOccursTag%><%=maxOccursTag%>/>         
<%  }
    // Assocations
    for ( Iterator ia = modelClass.getAssociations().iterator(); ia.hasNext(); ) {
      WSModelAssociation association = (WSModelAssociation)ia.next();
      WSModelClass assocTarget = (WSModelClass)association.getTarget();
      if ( association.matchDirection(direction) ) {
        if ( association.isMultiple() ) {
%>       <element name="<%=association.getName()%>"<%
           if ( association.isOptional() ) {
%> minOccurs="0"<% 
           } else {
%> minOccurs="1"<% 
           } 
%> maxOccurs="unbounded" type="<%=assocTarget.getTypeOrHierarchie(direction)%>"/>
<%      } else {
%>       <element name="<%=association.getName()%>"<%
           if ( association.isOptional() ) {
%> nillable="true"<% 
           } else {
%> nillable="false"<% 
           } 
%> type="<%=assocTarget.getTypeOrHierarchie(direction)%>"/>
<%      }
      }
    }
%>     </sequence>
<%  if ( modelClass.getSuperClass() != null ) {
%>    </extension>
    </complexContent>
<%  }
%>  </complexType>
<%  if ( modelClass.hasDerivedClasses() && modelClass.usedAsParameterOrReference(genClass) ) {
      if ( direction.equals("") == false ) {
%>  <!-- Polymorph hierarchie -->  
  <complexType name="<%=modelClass.getName()%><%=direction%>Hierarchie">
    <sequence>
<%      for ( Iterator id = modelClass.getInstanceClasses().iterator(); id.hasNext(); ) {
          WSModelClass derivedClass = (WSModelClass)id.next();
          String derivedName = Introspector.decapitalize(derivedClass.getName());

%>        <element name="<%=derivedName%>" type="<%=derivedClass.getDirectionType(direction)%>"/>
<%      } // for
%>    </sequence>
  </complexType>
<%    }
      else {
%>  <!-- Polymorph optimized hierarchies -->  
  <complexType name="<%=modelClass.getName()%>InHierarchie">
    <sequence>
<%      for ( Iterator id = modelClass.getInstanceClasses().iterator(); id.hasNext(); ) {
          WSModelClass derivedClass = (WSModelClass)id.next();
          String derivedName = Introspector.decapitalize(derivedClass.getName());

%>        <element name="<%=derivedName%>" type="<%=derivedClass.getDirectionType("In")%>"/>
<%      } // for
%>    </sequence>
  </complexType>      
  <complexType name="<%=modelClass.getName()%>OutHierarchie">
    <sequence>
<%      for ( Iterator id = modelClass.getInstanceClasses().iterator(); id.hasNext(); ) {
          WSModelClass derivedClass = (WSModelClass)id.next();
          String derivedName = Introspector.decapitalize(derivedClass.getName());

%>        <element name="<%=derivedName%>" type="<%=derivedClass.getDirectionType("Out")%>"/>
<%      } // for
%>    </sequence>
  </complexType>      
<%    } // else
   }
%>
