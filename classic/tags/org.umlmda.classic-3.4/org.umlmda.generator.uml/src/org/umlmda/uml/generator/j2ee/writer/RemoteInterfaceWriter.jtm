<% @conf 
main.JostracaVersion       = 0.3
main.CodeWriter            = RemoteInterfaceWriter
main.CodeWriterFormat	     = format\\ParentJavaWriterFormat.jwf
java.CodeWriter.package    = org.umlmda.uml.generator.j2ee.writer
java.CodeWriter.extends    = org.umlmda.uml.generator.j2ee.AbstractRemoteInterfaceWriter
%><% import!
import java.util.Iterator;
import org.umlmda.generator.model.util.RcsHelper;
import org.umlmda.generator.model.util.StringUtil;
import org.umlmda.model.uml.*;
import org.umlmda.uml.generator.java.*;
import org.umlmda.uml.generator.j2ee.*;
// ==== End of generation header ===============================================
%><% @section declare %><%
%><% @section %><%
   J2EEModelClass genClass = (J2EEModelClass)getGenClass();
   JavaModelClass genSuperClass = (JavaModelClass)genClass.getSuperClass();
   J2EEModel genModel = (J2EEModel)genClass.getGeneratorModel();
   
   genClass.resetImports();
   if ( genSuperClass != null ) {
      genClass.registerImport(genModel.getArtefact().getName(), genSuperClass);
   }
%>//@@Generated file, please edit UserSections only
//@@UserSection-Begin RCSHeader
<%=RcsHelper.writeHeader("// ")%>
//@@UserSection-End RCSHeader
   
package <%=getPackageName()%>;

import java.rmi.RemoteException;
<%=genClass.registeredImports()%>
<%= beginUserSection("Imports", COMMON) %>
<%= endUserSection("Imports", COMMON) %>

/**
 * J2EE Remote Interface for <%=genClass.getQualifiedName(JavaArtefacts.BUSINESS_SERVICE_INTERFACE)%>
 */
public interface <%=genClass.getGeneratedName()%> extends <%if ( genSuperClass != null ) {%><%=genClass.getScopedName(genModel.getArtefact().getName(), genSuperClass)%><%} else { %>javax.ejb.EJBObject<% } %>
{
<% // Setter/Getter
   for ( Iterator ia = getModelClass().getAttributes().iterator(); ia.hasNext(); ) {
	   ModelAttribute attribute = (ModelAttribute)ia.next();
%>   /**
   * Get <%=attribute.getName()%>
   */
   public <%=attribute.getType()%> get<%=StringUtil.firstToUpperCase(attribute.getName())%>() throws RemoteException;
   
   /**
   * Set <%=attribute.getName()%>
   */
   public void set<%=StringUtil.firstToUpperCase(attribute.getName())%>(<%=attribute.getType()%> <%=attribute.getName()%>) throws RemoteException;

<% }%>
<%   // Associations-Accessors
   for ( Iterator ia = getModelClass().getAssociations().iterator(); ia.hasNext(); ) {
      ModelAssociation association = (ModelAssociation)ia.next();
      if ( !association.isUnspecified() ) {
         if ( association.isMultiple() ) {
%>
   public java.util.Collection get<%=StringUtil.firstToUpperCase(association.getName())%>() throws RemoteException;

<%       } else {
%>
   public <%=association.getTarget()%> get<%=StringUtil.firstToUpperCase(association.getName())%>() throws RemoteException;

   public void set<%=StringUtil.firstToUpperCase(association.getName())%>(<%=association.getTarget()%> <%=association.getName()%>) throws RemoteException;
<%       }
     }
   }
   // Modelled Methods
   for ( Iterator ia = getModelClass().getMethods().iterator(); ia.hasNext(); ) {
	   J2EEModelMethod method = (J2EEModelMethod)ia.next();
%>   /**
    * <%=method.getDocumentation()%>
    */
    <%=method.getRemoteSignature()%>;

<% }%>		

};
