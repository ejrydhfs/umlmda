  JavaModelClass pimClass = modelClass.getPIMClass();
  boolean isOptimized = isOptimized(modelClass);
  String arg = StringUtils.uncapitalize(pimClass.getName());
  String interfaceName = "";
  String stubName = genClass.getScopedName(WSArtefacts.WS_STUB, modelClass);
 
  if ( pimClass.hasStereotype(ModelStereotype.BUSINESS_EXCEPTION) )
    interfaceName = genClass.getScopedName(JavaArtefacts.BUSINESS_EXCEPTION, pimClass);
  else if ( pimClass.hasStereotype(ModelStereotype.ENUMERATION) )
