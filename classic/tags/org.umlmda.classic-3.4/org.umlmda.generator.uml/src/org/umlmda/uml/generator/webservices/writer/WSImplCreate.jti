     String wsHierarchie = pimClass.getName() + "Hierarchie";
     List hierarchie = new ArrayList(modelClass.getAssociations().size());
     for ( Iterator ia = modelClass.getAssociations().iterator(); ia.hasNext(); ) {
        ModelAssociation assoc = (ModelAssociation)ia.next();
        hierarchie.add(assoc.getTarget());
     }
     Collections.sort(hierarchie, ModelClassAdapter.getHierachyComparator());
%>   // create <%=pimClass.getName()%> hierarchical web service DTO from interface DTO  
   public <%=stubName%> create<%=modelClass.getName()%>(<%=interfaceName%> <%=arg%>) {
      <%=stubName%> <%=wsHierarchie%> = new <%=stubName%>();
      
<%    // Loop associations of the hierarchy class
      for ( Iterator ia = hierarchie.iterator(); ia.hasNext(); ) {
        WSModelClass derivedClass = (WSModelClass)ia.next();
        JavaModelClass derivedPIMClass = derivedClass.getPIMClass();
        String derivedClassName = genClass.getScopedName(JavaArtefacts.BUSINESS_OBJECT_INTERFACE, derivedPIMClass);
%>      if ( <%=arg%> instanceof <%=derivedClassName%> ) {
         <%=wsHierarchie%>.set<%=derivedClass.getName()%>(create<%=derivedClass.getName()%>((<%=derivedClassName%>)<%=arg%>));
      }   
<%       if ( ia.hasNext() ) {
%>      else <%
         } 
      } // for
%>            registry.put(<%=arg%>, <%=wsHierarchie%>);
      return <%=wsHierarchie%>;
   }

   /**
    * create <%=pimClass.getName()%> interface DTO from hierarchical web service DTO
    */
   public <%=interfaceName%> create<%=pimClass.getName()%>(<%=stubName%> src) {
<%    // Loop associations of the hierarchy class
      for ( Iterator ia = hierarchie.iterator(); ia.hasNext(); ) {
        WSModelClass derivedClass = (WSModelClass)ia.next();
        JavaModelClass derivedPIMClass = derivedClass.getPIMClass();
%>      if ( src.get<%=derivedClass.getName()%>() != null )
         return create<%=derivedPIMClass.getName()%>(src.get<%=derivedClass.getName()%>());
<%      if ( ia.hasNext() ) {
%>      else <% 
        }
      } // for
%>      else
         return null;
   }

<%}

  // Handling simple (none hierarchy) dtos
  else {
     if ( modelClass.hasStereotype(WSStereotypes.WEB_SERVICE_EXCEPTION) )  {
%>   // create <%=pimClass.getName()%> web service exception from business service exception
   public <%=stubName%> create<%=modelClass.getName()%>(final <%=interfaceName%> from) {
      int ii;
      
      if ( from != null ) {
<% // Attributes        
   for ( Iterator ia = modelClass.getAttributes(true).iterator(); ia.hasNext(); ) {
      WSModelAttribute attribute = (WSModelAttribute)ia.next();
      
      if ( attribute.getModelClassifier().hasStereotype(WSStereotypes.WEB_SERVICE_ENUMERATION) && attribute.isOptional() == false ) {
%>      if ( from.<%=attribute.getGetter()%>() == null ) {
         throw new IllegalArgumentException("None optional attribute <%=attribute.getQualifiedName()%> is null");
      }
<%    } 
%>      <%=attribute.getWSJavaType()%> _<%=attribute.getName()%> = <%=attribute.getConvertToWs()%>;
<% } // for 
   // Associations
   for ( Iterator ia = modelClass.getAssociations(true).iterator(); ia.hasNext(); ) {
      WSModelAssociation association = (WSModelAssociation)ia.next();
      WSModelClass assocClass = (WSModelClass)association.getTarget();
      String assocName = association.getName();
      String assocType = genClass.getScopedName(JavaArtefacts.BUSINESS_OBJECT_INTERFACE, assocClass.getPIMClass());
      String assocWsType = genClass.getScopedName(WSArtefacts.WS_STUB, assocClass);

      if ( association.isComposition() ) {
         if ( association.isMultiple() ) {
%>      <%=assocWsType%> _<%=assocName%>[] = new <%=assocWsType%>[from.<%=association.getGetter()%>().size()];
      ii=0;
      for ( Iterator i=from.<%=association.getGetter()%>().iterator(); i.hasNext(); ++ii) {
         _<%=assocName%>[ii] = create<%=assocClass.getName()%>((<%=assocType%>)i.next());
      }
<%       }
         else {
%>      <%=assocWsType%> _<%=assocName%> = create<%=assocClass.getName()%>(from.<%=association.getGetter()%>());
<%       }
      }
      else {
         if ( association.isMultiple() ) {
%>      final <%=assocWsType%> _<%=assocName%>[] = new <%=assocWsType%>[from.<%=association.getGetter()%>().size()];
      register(new ResolveReference() {
         void resolve() {
            int ii=0;
            for ( Iterator i=from.<%=association.getGetter()%>().iterator(); i.hasNext(); ++ii) {
               <%=assocType%> from<%=assocName%> = (<%=assocType%>) i.next();
               <%=assocWsType%> <%=assocName%>Ws = (<%=assocWsType%>)lookup(from<%=assocName%>);
            
               if ( <%=assocName%>Ws == null ) 
                  <%=assocName%>Ws = create<%=assocClass.getName()%>(from<%=assocName%>);
               _<%=assocName%>[ii] = <%=assocName%>Ws;
            }
         }   
     });
<%       }
         else {
%>      final <%=assocWsType%> _<%=assocName%>;
      register(new ResolveReference() {
         void resolve() {
            <%=assocWsType%> <%=assocName%>Ws = (<%=assocWsType%>)lookup(from.<%=association.getGetter()%>());
            
            if ( <%=assocName%>Ws == null ) 
              <%=assocName%>Ws = create<%=assocClass.getName()%>(from.<%=association.getGetter()%>());
            _<%=assocName%> = <%=assocName%>Ws;
         }
      });      
<%       }
      }
   }
%>         <%=stubName%> dest = new <%=stubName%>(<%
   // Attributes        
     for ( Iterator ia = modelClass.getAttributes(true).iterator(); ia.hasNext(); ) {
        ModelStructuralFeature attribute = (ModelStructuralFeature)ia.next();
%>_<%=attribute.getName()%><%if ( ia.hasNext() ) {%>, <%}
     } // for
     if ( modelClass.getAttributes(true).size() > 0 && modelClass.getAssociations(true).size() > 0 ) {%>, <%} 

     // Associations
     for ( Iterator ia = modelClass.getAssociations(true).iterator(); ia.hasNext(); ) {
        ModelStructuralFeature feature = (ModelStructuralFeature)ia.next();
%>_<%=feature.getName()%><%if ( ia.hasNext() ) {%>, <%}
