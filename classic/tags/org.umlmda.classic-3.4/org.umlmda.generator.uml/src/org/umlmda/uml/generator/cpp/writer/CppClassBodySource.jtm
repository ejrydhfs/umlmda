#include <<%=getClassName()%>.h>
<% if ( hasBusinessInterface() ) { %>
<%    for ( Iterator iter = getReferencedTypes().iterator(); iter.hasNext(); ) {
         ModelClass modelClass = (ModelClass)iter.next();
%><%=guardedInclude("", modelClass.getName())%>
<%    }
   }%>

using namespace <%=getNamespace(getModelClass())%>;

<%=getClassName()%>::<%=getClassName()%>() {
}

// copy ctor
<%=getClassName()%>::<%=getClassName()%>(const <%=getClassName()%> &rSrc)
<% // copy attributes
   char sep = ':';
 
   if ( getModelClass().getSuperClass() != null ) {
      sep = ',';
%>: <%=getQualifiedName(getModelClass().getSuperClass())%>(rSrc)
<% }
   for ( Iterator ia = getModelClass().getAttributes().iterator(); ia.hasNext(); ) {
      ModelAttribute attribute = (ModelAttribute)ia.next();
   %><%=sep%> a_<%=attribute.getName()%>( rSrc.a_<%=attribute.getName()%> )
<% sep = ','; 
} %>
{
   copyAssociations(rSrc);
}

<% // Ctor with attributes as arguments
   if ( generateAttributeCtor() && getModelClass().getAttributes(true).size() > 0 ) {
%><%=getClassName()%>::<%=getClassName()%>(<%
      for ( Iterator ia = getModelClass().getAttributes(true).iterator(); ia.hasNext(); ) {
         ModelAttribute attribute = (ModelAttribute)ia.next();
%><%=getType(attribute)%> <%=attribute.getName()%><%
         if ( ia.hasNext() ) {%>, <%}
      }   
%>)
<%    if ( getModelClass().getSuperClass() != null ) {
         sep = ',';
%>: <%=getQualifiedName(getModelClass().getSuperClass())%>(<%
         for ( Iterator ia = getModelClass().getSuperClass().getAttributes(true).iterator(); ia.hasNext(); ) {
            ModelAttribute attribute = (ModelAttribute)ia.next();
%><%=attribute.getName()%><%
            if ( ia.hasNext() ) {%>, <%}
         } // for   
%>)
<%    } else { 
         sep = ':';
      }
      for ( Iterator ia = getModelClass().getAttributes(false).iterator(); ia.hasNext(); ) {
         ModelAttribute attribute = (ModelAttribute)ia.next();
%><%=sep%> a_<%=attribute.getName()%>(<%=attribute.getName()%>)
<%       sep = ',';
      }   
%>{
}

<% }
   if ( hasBusinessInterface() ) { %>
<%=getClassName()%>::<%=getClassName()%>(const I<%=getClassName()%> &rSrc)
<% // copy attributes
   sep = ':';
   for ( Iterator ia = getModelClass().getAttributes().iterator(); ia.hasNext(); ) {
      ModelAttribute attribute = (ModelAttribute)ia.next();
   %><%=sep%> a_<%=attribute.getName()%>( rSrc.get<%=StringUtil.firstToUpperCase(attribute.getName())%>() )
<% sep = ','; 
} %>
{
   copyAssociations(rSrc);
}
<% } %>

// assignment operator
<%=getClassName()%> & <%=getClassName()%>::operator =(const <%=getClassName()%> &rSrc)
{
<% if ( hasBusinessInterface() ) { %>
   *this = (const I<%=getClassName()%> &)rSrc;
   return *this;
}

<%=getClassName()%> & <%=getClassName()%>::operator =(const I<%=getClassName()%> &rSrc)
{
<% } // if ( hasBusinessInterface() ) 
   if ( getModelClass().getSuperClass() != null ) { %>
   this-><%=getQualifiedName(getModelClass().getSuperClass())%>::operator=(rSrc);
<% }   
   for ( Iterator ia = getModelClass().getAttributes().iterator(); ia.hasNext(); ) {
      ModelAttribute attribute = (ModelAttribute)ia.next();
%>   a_<%=attribute.getName()%> = rSrc.get<%=StringUtil.firstToUpperCase(attribute.getName())%>();
<%}
%>
   copyAssociations(rSrc);
   return *this;
}

<%=getClassName()%>::~<%=getClassName()%>()
{
}

<% // Setter/Getter
   for ( Iterator ia = getModelClass().getAttributes().iterator(); ia.hasNext(); ) {
     ModelAttribute attribute = (ModelAttribute)ia.next();
%>/**
* Get <%=attribute.getName()%>
*/
<%=getType(attribute)%> <%=getClassName()%>::get<%=StringUtil.firstToUpperCase(attribute.getName())%>() const {
   return a_<%=attribute.getName()%>;
}

/**
 * Set <%=attribute.getName()%>
 */
void <%=getClassName()%>::set<%=StringUtil.firstToUpperCase(attribute.getName())%>(<%=getType(attribute)%> <%=attribute.getName()%>) {
   a_<%=attribute.getName()%> = <%=attribute.getName()%>;
}
<% }

   // association accessors
   for ( Iterator ia = getModelClass().getAssociations().iterator(); ia.hasNext(); ) {
      ModelAssociation association = (ModelAssociation)ia.next();
      if ( !association.isUnspecified() ) {
         if ( association.isMultiple() ) {
%>
const std::list<<%=getType(association.getTarget())%> *> &<%=getClassName()%>::get<%=StringUtil.firstToUpperCase(association.getName())%>List() const {
   return a_<%=StringUtil.firstToUpperCase(association.getName())%>List;
}

std::list<<%=getType(association.getTarget())%> *> &<%=getClassName()%>::get<%=StringUtil.firstToUpperCase(association.getName())%>List() {
   return a_<%=StringUtil.firstToUpperCase(association.getName())%>List;
}
<%       } else {
%>
const <%=getType(association.getTarget())%> <%=getClassName()%>::get<%=StringUtil.firstToUpperCase(association.getName())%>() const {
}

<%=getType(association.getTarget())%> <%=getClassName()%>::get<%=StringUtil.firstToUpperCase(association.getName())%>() {
}

void <%=getClassName()%>::set<%=StringUtil.firstToUpperCase(association.getName())%>(const <%=getType(association.getTarget())%> *p<%=StringUtil.firstToUpperCase(association.getName())%>) {
}

<%       }
      }
   }
%>
void <%=getClassName()%>::copyAssociations(const <%=getClassName()%> &rSrc) {
<% if ( hasBusinessInterface() ) {%>
   copyAssociations((const I<%=getClassName()%> &)rSrc);
}   

void <%=getClassName()%>::copyAssociations(const I<%=getClassName()%> &rSrc) {
<% } // if ( hasBusinessInterface() )

   for ( Iterator ib = getModelClass().getAssociations().iterator(); ib.hasNext(); ) {
      ModelAssociation association = (ModelAssociation)ib.next();
      if ( association.isUnspecified() )
         continue;
      ModelClassifier targetClass = association.getTarget();
      String assocName = new String( StringUtil.firstToUpperCase(association.getName()) + "List");
      if ( association.isMultiple() ) {
         // deep copy composite associations%>
   a_<%=assocName%>.clear();
   for (std::list<<%=getType(targetClass)%> *>::const_iterator <%=assocName%>Iter = rSrc.get<%=assocName%>().begin();
        <%=assocName%>Iter != rSrc.get<%=assocName%>().end();
        <%=assocName%>Iter++ ) {
      a_<%=assocName%>.push_back( new <%=targetClass.getName()%>( **<%=assocName%>Iter));
   }
<%     }
       else
       {%>
#error TODO: copy aggregate object
<%     }
   } // for %>
}   

<%   // Modelled Methods
   for ( Iterator ia = getModelClass().getMethods().iterator(); ia.hasNext(); ) {
	   ModelMethod method = (ModelMethod)ia.next();
%>/**
* <%=method.getDocumentation()%>
*/
<%=getMethodSignature(method)%> {
<%= beginUserSection(method.getName(), COMMON) %>
       //@@@TODO Insert implementation
<%= endUserSection(method.getName(), COMMON) %>      
}
<% }%>
