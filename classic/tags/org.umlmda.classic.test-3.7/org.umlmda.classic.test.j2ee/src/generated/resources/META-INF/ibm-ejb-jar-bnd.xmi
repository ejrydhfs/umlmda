<?xml version="1.0" encoding="ISO-8859-1"?>
<ejbbnd:EJBJarBinding xmi:version="2.0"
	xmlns:xmi="http://www.omg.org/XMI"
	xmlns:ejbbnd="ejbbnd.xmi"
	xmlns:ejb="ejb.xmi"
	xmlns:commonbnd="commonbnd.xmi"
	xmlns:common="common.xmi"
	xmi:id="EJBJarBinding_1">
	<ejbJar href="META-INF/ejb-jar.xml#ejb-jar_ID"/>

    <!-- Session Beans -->
    	<ejbBindings
		xmi:id="CommonService"
		jndiName="ejb/partner/1/CommonService">
		<enterpriseBean xmi:type="ejb:Session"
			href="META-INF/ejb-jar.xml#CommonService"/>		
		</ejbBindings>

    	<ejbBindings
		xmi:id="PartnerPersistence"
		jndiName="ejb/partner/1/PartnerPersistence">
		<enterpriseBean xmi:type="ejb:Session"
			href="META-INF/ejb-jar.xml#PartnerPersistence"/>		
		</ejbBindings>

    	<ejbBindings
		xmi:id="PartnerService"
		jndiName="ejb/partner/1/PartnerService">
		<enterpriseBean xmi:type="ejb:Session"
			href="META-INF/ejb-jar.xml#PartnerService"/>		
		</ejbBindings>

    
</ejbbnd:EJBJarBinding>
