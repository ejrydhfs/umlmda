/* Constants << */ 

/* Command line arguments */
char* WRITER__ARGUMENT_CONTROL_PREFIX          = "$<main.CodeWriter.argument.ControlPrefix>";
char* WRITER__ARGUMENT_OutputFolder            = "$<main.CodeWriter.argument.name.OutputFolder>";
char* WRITER__ARGUMENT_BackupFolder            = "$<main.CodeWriter.argument.name.BackupFolder>";
char* WRITER__ARGUMENT_NoBackup                = "$<main.CodeWriter.argument.name.NoBackup>";

/* User Interface text message parts */
char* WRITER__UITEXT_Method                    = "method ";
char* WRITER__UITEXT_Main                      = "main ";
char* WRITER__UITEXT_ExceptionIn               = "Exception in ";
char* WRITER__UITEXT_ColonNewLine              = ":\n";
char* WRITER__UITEXT_NewLine                   = "\n";
char* WRITER__UITEXT_Section                   = "section ";
char* WRITER__UITEXT_SavedFile                 = "Saved file:       ";
char* WRITER__UITEXT_UnableToSaveFile          = "Unable to save file: ";
char* WRITER__UITEXT_UnableToBackupFile        = "Unable to backup file: ";
char* WRITER__UITEXT_ToBackupFolder            = " to backup folder: ";
char* WRITER__UITEXT_BackupFolderColon         = "Backup folder: ";
char* WRITER__UITEXT_BackupFolderExistFailure  = " does not exist and cannot be created.";
char* WRITER__UITEXT_BackupFolderNotAFolder    = " is not a folder.";
char* WRITER__UITEXT_BackupFolderNotWritable   = " is not writable.";
char* WRITER__UITEXT_CodeWriterState           = "Code Writer State: ";
char* WRITER__UITEXT_GetFileIndexEquals        = "\n_getFileIndex()    = ";
char* WRITER__UITEXT_GetFullFileNameEquals     = "\n_getFullFileName() = ";
char* WRITER__UITEXT_GetOutputFolderEquals     = "\n_getOutputFolder() = ";
char* WRITER__UITEXT_ErrorHeader               = "\n\n--- CodeWriter Error Description Start ---\n\n";
char* WRITER__UITEXT_ErrorFooter               = "\n--- CodeWriter Error Description End -----\n\n";
char* WRITER__UITEXT_PlaceHolderException      = "This placeholder Exception should never be thrown: there is an error in the WriterFormat.";

/* String constants */
#define WRITER__STRING_empty                   ""
#define WRITER__STRING_dot                     "."
#define WRITER__STRING_separator               "$<\jostraca.system.fileSeparator>"

#define WRITER__MAX_LINE_LEN 2222




/* Constants >> */




/* section:define << */
/**/

#define _insertf(f,v) { sprintf( writer__iSprintfInsertBuffer, f, v); _insert( writer__iSprintfInsertBuffer ); }
!<define>

/**/
/* section:define >> */



/* requires a NULL entry will empty line at end */
struct writer__FileText {
  char*                    line;
  struct writer__FileText* next; 
};



/* Writer Variables << */

char**    writer__iFileNameRoots                   = NULL;                     /* generated file name roots */
int       writer__iNumFiles                        = 0;                        /* number of generated files */
  
char*     writer__iFileNamePrefix                  = WRITER__STRING_empty;     /* failsafe default */
char*     writer__iFileNameSuffix                  = WRITER__STRING_empty;     /* failsafe default */

char*     writer__iBackupPrefix                    = WRITER__STRING_empty;     /* failsafe default */
char*     writer__iBackupSuffix                    = WRITER__STRING_empty;     /* failsafe default */

struct writer__FileText* writer__iCurrentText      = NULL;                     /* current text */
struct writer__FileText* writer__iCurrentTextLine  = NULL;                     /* current text line */
int                      writer__iCurrentFileIndex = 0;                        /* current file index */

char**    writer__iArgs                            = NULL;                     /* cmd line args */
int       writer__iNumArgs                         = 0;                        /* number of cmd line args */
char**    writer__iUserArgs                        = NULL;                     /* user cmd line args */
int       writer__iNumUserArgs                     = 0;                        /* number of user cmd line args */

int       writer__iSave                            = 1;                        /* save generated code to disk */
int       writer__iBackup                          = 1;                        /* make backups */

char*     writer__iOutputFolder                    = WRITER__STRING_dot;       /* written code is output to this folder */
char*     writer__iBackupFolder                    = WRITER__STRING_dot;       /* overwritten files are placed here */

char*     writer__iProperties[]                    = { $<jostraca.properties.NameValueList>, NULL, NULL };   
int       writer__iPropertiesInit                  = 1;                        /* true => lookup table initialiased */

int       writer__iException                       = 0;                        /* true => exception was thrown */
char*     writer__iExceptionMessage                = WRITER__STRING_empty;     /* internal message describing the exception */


char  writer__iSprintfInsertBuffer[ WRITER__MAX_LINE_LEN ];

/* Writer Variables >> */



void      writer__initialize();
void      writer__write();
int       writer__startFile();
int       writer__endFile();
void      writer__nextFile();
void      writer__handleArgs( int argc, char *argv[] );
