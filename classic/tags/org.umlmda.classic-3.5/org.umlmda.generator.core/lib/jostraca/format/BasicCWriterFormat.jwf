void      writer__initArgs(int argc, char** argv);
void      writer__userMessage( char* pMessage );
void      writer__handleException( char* pMessage, char* pException );
char*     writer__describeState();
void      writer__backup( char* pFilePath, char* pFileName, char* pBackupFolder );
struct writer__FileText* writer__insert( char* pText, struct writer__FileText* pTextLine );
void      writer__initProperties(); 


void      _setFileNamePrefix(char* pPrefix);
char*     _getFileNamePrefix();
void      _setFileNameSuffix(char* pSuffix);
char*     _getFileNameSuffix();
void      _setFullFileName( char* pName );
char*     _getFullFileName();
void      _setFullFileNames( int pNumFileNames, char* pFullFileNames[] );
char**    _getFullFileNames();
void      _setFileNameRoot(char* pFileNameRoot);
char*     _getFileNameRoot();
void      _setFileNameRoots(int pNumFileNameRoots, char* pFileNameRoots[]);
