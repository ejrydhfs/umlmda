  /** Create a String containing specified number of spaces. */
  public String _spaces( int pNumSpaces ) {
    int numSpaces = pNumSpaces;
    if( 0 > numSpaces ) { numSpaces *= -1; }
    StringBuffer spaces = new StringBuffer( numSpaces );
    for(int spaceI = 0; spaceI < numSpaces; spaceI = spaceI + 1 ) {
      spaces.append(" ");
    }
    return spaces.toString();
  }



  /** Left align String with spaces. */ 
  public String _left( String pText, int pColWidth ) {
    return _align( pText, " ", pColWidth, 'l' );
  } 



  /** Right align String with spaces. */ 
  public String _right( String pText, int pColWidth ) {
    return _align( pText, " ", pColWidth, 'r' );
  } 



  /** Center align String with spaces. */ 
  public String _center( String pText, int pColWidth ) {
    return _align( pText, " ", pColWidth, 'c' );
  } 



  /** Align text within background text to specified column width. 
   *  Alignment can be 'l': left, 'c': center, 'r': right.
   */
  public String _align( String pText, String pBackText, int pColWidth, char pAlignment ) {
    String result = pText;
 
    if( null == pText ) { 
       result = WRITER__STRING_empty; 
    }
    else if( null != pBackText ) {
      try {
        int textLen = pText.length();
        if( pColWidth > textLen ) {
          int    backTextLen     = pBackText.length();
          int    remainWidth     = pColWidth - textLen;
          int    backTextRepeats = remainWidth / backTextLen;
          int    backTextRemain  = remainWidth % backTextLen;
          String back            = WRITER__STRING_empty;
          for( int backTextI = 0; backTextI < backTextRepeats; backTextI = backTextI + 1 ) {
            back = back + pBackText;
          }
          back = back + pBackText.substring( 0, backTextRemain );
 
          switch( pAlignment ) {
          case 'l':
            result = result + back;
            break;
          case 'c':
            result = back.substring( 0, (back.length()/2) ) + result + back.substring( (back.length()/2) );
            break;
          case 'r':
            result = back + result;
            break;
          }
        }
      } 
      catch( Exception e ) {
        result = pText;
      }
    }
    return result;
  }



  /** Set the text of file currently being generated. */
  public void _setText( String pText) {
    writer__iCurrentText = new StringBuffer( pText );
  }



  /** Get the text of file currently being generated. */
  public String _getText() {
    return writer__iCurrentText.toString();
  }

  /* Template Services (Text Production) >> */

}


