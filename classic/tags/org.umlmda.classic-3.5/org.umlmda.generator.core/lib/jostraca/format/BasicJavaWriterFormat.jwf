  /* Template Services (Control) << */

  /** Get the value of a compile-time property. */
  public String _getProperty( String pName ) {
    String result = WRITER__STRING_empty;

    if( ! writer__iPropertiesInit ) {
      writer__initProperties();
    }

    if( writer__iProperties.containsKey( pName ) ) {
      result = (String) writer__iProperties.get( pName );
    }

    return result;
  }



  /** Get first user arg. */
  public String _getFirstUserArg() {
