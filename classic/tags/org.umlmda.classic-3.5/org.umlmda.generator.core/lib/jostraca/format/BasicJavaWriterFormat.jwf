  /* section:declare >> */!<}declare>




  /** Execute. */
  public static void main( String pArgs[] ) {
    $<main.CodeWriter> cw = new $<main.CodeWriter>();
    System.exit( cw._generate( pArgs ) );
  }




  /* Writer Services << */

  /** Generate. */
  public int _generate( String[] pArgs ) {
    try {
      writer__initialize();
      writer__handleArgs( pArgs );
      writer__write();    
      return 0;
    } 
    catch( Exception e ) {
      writer__handleException( WRITER__UITEXT_ExceptionIn + WRITER__UITEXT_Method + WRITER__UITEXT_Main, e );
      return 1;
    }
  }


  /* Initialize. */
  public void writer__initialize() {
    writer__iCurrentFileIndex = 0;
    writer__setDefaults();
  }



  /** Main file generation loop. Template script is placed here in the body section. */
  public void writer__write() throws Exception {
    if( false ) { throw new Exception( WRITER__UITEXT_PlaceHolderException ); }

    // initialize
    String writer__currentSection = "init";

    try {
      if( false ) { throw new Exception( WRITER__UITEXT_PlaceHolderException ); }

      !<{init>/* section:init << */
      //

      !<init>

      //
      /* section:init >> */!<}init>


      // write files loop
      int      writer__numFiles = _getNumFiles();
      int      writer__fileI    = 0;
      writer__next_file: for( writer__fileI = 0; writer__fileI < writer__numFiles; writer__fileI = writer__fileI + 1 ) {

        try {
          if( false ) { throw new Exception( WRITER__UITEXT_PlaceHolderException ); }


          !<{prewrite>/* section:prewrite << */
          // 

          writer__currentSection = "prewrite";
          !<prewrite>

          //
          /* section:prewrite >> */!<}prewrite>


          if( ! writer__startFile() ) { continue writer__next_file; }


          !<{body>/* section:body << */
          //

          writer__currentSection = "body";
          !<body>

          //
          /* section:body >> */!<}body>


          if( ! writer__endFile() ) { continue writer__next_file; }


          !<{postwrite>/* section:postwrite << */
          // 

          writer__currentSection = "postwrite";
          !<postwrite>

          //
          /* section:postwrite >> */!<}postwrite>


        } 
        catch( Exception e ) {
           writer__handleException( WRITER__UITEXT_ExceptionIn + WRITER__UITEXT_Section + writer__currentSection, e );
        }

        writer__nextFile();       
      }
 

      !<{cleanup>/* section:cleanup << */
      //
 
      writer__currentSection = "cleanup";
      !<cleanup>

      //
      /* section:cleanup >> */!<}cleanup>


    } 
    catch( Exception e ) {
      writer__handleException( WRITER__UITEXT_ExceptionIn + WRITER__UITEXT_Section + writer__currentSection, e );
    }
  }



  /** Start writing a file. */
  public boolean writer__startFile() {
    writer__iCurrentText = new StringBuffer( WRITER__FILE_BUFFER_SIZE );
    return true;
  }



  /** End writing a file. */
  public boolean writer__endFile() {
    boolean endOK = true;

    String fileName = _getFullFileName();
    String filePath 
      = writer__iOutputFolder
      + WRITER__STRING_separator
      + fileName;

    if( writer__iBackup ) {
      try {
        writer__backup( filePath, fileName, writer__iBackupFolder );
      } 
      catch( Exception e ) {
        writer__handleException( WRITER__UITEXT_UnableToBackupFile 
                                 + filePath 
                                 + WRITER__UITEXT_ToBackupFolder
                                 + writer__iBackupFolder
                                 ,e );
        endOK = false;
      }
    }
 
    if( endOK && writer__iSave ) {
      try {
        _saveTextFile( filePath, writer__iCurrentText.toString() );
        writer__userMessage( WRITER__UITEXT_SavedFile + filePath + WRITER__UITEXT_NewLine );
      } 
      catch( Exception e ) {
        writer__handleException( WRITER__UITEXT_UnableToSaveFile + filePath, e );
        endOK = false;
      }
    }

    return endOK;
  }



  /** Move to next file. */
  public void writer__nextFile() {
    writer__iCurrentFileIndex = writer__iCurrentFileIndex + 1;
  }



  /** Handle command line arguments to CodeWriter. */
  public void writer__handleArgs( String[] pArgs ) {

    // set arg names
    String argName_OutputFolder = WRITER__ARGUMENT_CONTROL_PREFIX + WRITER__ARGUMENT_OutputFolder;
    String argName_BackupFolder = WRITER__ARGUMENT_CONTROL_PREFIX + WRITER__ARGUMENT_BackupFolder;
    String argName_NoBackup     = WRITER__ARGUMENT_CONTROL_PREFIX + WRITER__ARGUMENT_NoBackup;

    // parse
    int numArgs = pArgs.length;
    for(int argI = 0; argI < numArgs; argI = argI + 1 ) {
      if( pArgs[argI].startsWith( argName_OutputFolder ) ) {
        _setOutputFolder( pArgs[ argI ].substring( argName_OutputFolder.length() ) );
      }
      else if( pArgs[argI].startsWith( argName_BackupFolder ) ) {
        _setBackupFolder( pArgs[ argI ].substring( argName_BackupFolder.length() ) );
      }
      else if( argName_NoBackup.equals( pArgs[ argI ] ) ) {
        _backup( $<lang.FalseString> ); // NOTE: -B => don't make backups
      }
    }

    writer__initArgs( pArgs.length, pArgs );
  }



  /** Set defaults from configuration property set. */
  public void writer__setDefaults() {

    $<{main.FileNameRoot>_setFileNameRoot( "$<\main.FileNameRoot>" );$<}main.FileNameRoot>
    $<{main.FileNamePrefix>_setFileNamePrefix( "$<\main.FileNamePrefix>" );$<}main.FileNamePrefix>
    $<{main.FileNameSuffix>_setFileNameSuffix( "$<\main.FileNameSuffix>" );$<}main.FileNameSufffix>

    $<{main.OutputFolder>_setOutputFolder( "$<\main.OutputFolder>" );$<}main.OutputFolder>

    $<{main.BackupFolder>_setBackupFolder( "$<\main.BackupFolder>" );$<}main.BackupFolder>
    $<{main.BackupPrefix>_setBackupPrefix( "$<\main.BackupPrefix>" );$<}main.BackupPrefix>
    $<{main.BackupSuffix>_setBackupSuffix( "$<\main.BackupSuffix>" );$<}main.BackupSufffix>
    _backup( "$<lang.TrueString>".equals( "$<jostraca.MakeBackup>" ) );

  }



  /** Initialize command line arguments. */
  public void writer__initArgs( int pNumArgs, String[] pArgs ) {
    int      argI        = 0;
    int      userArgI    = 0;

    writer__iNumArgs     = pNumArgs;
    writer__iArgs        = pArgs;
    writer__iNumUserArgs = writer__iNumArgs;

    for( argI = 0; argI < writer__iNumArgs; argI = argI + 1 ) {
      if( writer__iArgs[argI].startsWith( WRITER__ARGUMENT_CONTROL_PREFIX ) ) {
        writer__iNumUserArgs = writer__iNumUserArgs - 1;
      }
    }

    writer__iUserArgs = new String[ writer__iNumUserArgs ];
    for( argI = 0; argI < writer__iNumArgs; argI = argI + 1 ) {
      if( !writer__iArgs[argI].startsWith( WRITER__ARGUMENT_CONTROL_PREFIX ) ) {
        writer__iUserArgs[ userArgI ] = writer__iArgs[ argI ];
        userArgI = userArgI + 1;
      }
    }
  }



  /** Print a user readable message. */
  public void writer__userMessage( String pMessage ) {
    System.out.print( pMessage );
  }



  /** Handle exceptions: print an explanation for user. */
  public void writer__handleException( String pMessage, Exception pException ) {

    StringBuffer userMsg = new StringBuffer();

    userMsg.append( WRITER__UITEXT_ErrorHeader );

    userMsg.append( writer__describeState() + pMessage + WRITER__UITEXT_ColonNewLine );

    StringWriter stringWriter = new StringWriter();
    pException.printStackTrace( new PrintWriter( stringWriter) );
    userMsg.append( stringWriter.toString() );

    userMsg.append( WRITER__UITEXT_ErrorFooter );

    writer__userMessage( userMsg.toString() );
  }



  /** Provide a concise description of the state of the CodeWriter. */
  public String writer__describeState() {
    String currentState 
      = WRITER__UITEXT_CodeWriterState
      + WRITER__UITEXT_GetFileIndexEquals    + _getFileIndex() 
      + WRITER__UITEXT_GetFullFileNameEquals + _getFullFileName()
      + WRITER__UITEXT_GetOutputFolderEquals + _getOutputFolder()
      + WRITER__UITEXT_NewLine
      ; 
    return currentState;
  }



  /** Backup overwritten files, if they exist.
   *  Backups have the format: [YYYYMMDDhhmmss][prefix][filename][suffix].
   */ 
  public void writer__backup( String pFilePath, String pFileName, String pBackupFolder ) throws Exception {

    File backupFolder = new File( pBackupFolder );

    // check backup folder ( create if necessary )
    if( ! backupFolder.exists() ) {
      if( ! backupFolder.mkdir() ) {
        throw new Exception( WRITER__UITEXT_BackupFolderColon
                             + backupFolder
                             + WRITER__UITEXT_BackupFolderExistFailure );
      }
    }
    if( ! backupFolder.isDirectory() ) {
      throw new Exception( WRITER__UITEXT_BackupFolderColon 
                           + backupFolder
                           + WRITER__UITEXT_BackupFolderNotAFolder );
    }
    if( ! backupFolder.canWrite() ) {
      throw new Exception( WRITER__UITEXT_BackupFolderColon
                           + backupFolder
                           + WRITER__UITEXT_BackupFolderNotWritable );
    }

    // create backup file path
    Calendar calendar = Calendar.getInstance();
    String year_yyyy = _align( String.valueOf( calendar.get(Calendar.YEAR) ),         "0", 4, 'r' );
    String month_mm  = _align( String.valueOf( (1+calendar.get(Calendar.MONTH)) ),    "0", 2, 'r' );
    String day_dd    = _align( String.valueOf( calendar.get(Calendar.DAY_OF_MONTH) ), "0", 2, 'r' );
    String hour_hh   = _align( String.valueOf( calendar.get(Calendar.HOUR_OF_DAY) ),  "0", 2, 'r' );
    String minute_mm = _align( String.valueOf( calendar.get(Calendar.MINUTE) ),       "0", 2, 'r' );
    String second_ss = _align( String.valueOf( calendar.get(Calendar.SECOND) ),       "0", 2, 'r' );
    String dateTime       = year_yyyy+month_mm+day_dd+hour_hh+minute_mm+second_ss;
    String backupFileName = dateTime + writer__iBackupPrefix + pFileName + writer__iBackupSuffix;
    File   backupFilePath = new File( pBackupFolder, backupFileName );
    
    // save backup file
    File fileToBackup = new File( pFilePath );
    if( fileToBackup.exists() ) {
      String fileContents = _loadTextFile( pFilePath );
      _saveTextFile( backupFilePath.getPath(), fileContents );
    }
  }



  /** Set compile-time properties. */
  public void writer__initProperties() {
    $<{jostraca.properties.NameValueList>
    String[] propertyList  = new String[] { $<jostraca.properties.NameValueList> };
    int      numProperties = propertyList.length;
    for( int propI = 0; propI < numProperties; propI = propI + 2 ) {
      writer__iProperties.put( propertyList[ propI ], propertyList[ propI+1 ] );
    }
    writer__iPropertiesInit = true;
    $<}jostraca.properties.NameValueList>
  }

  /* Writer Services >> */
 



  /* Template Services (File Generation) << */

  /** Set the prefix of the files to be generated. */
  public void _setFileNamePrefix( String pPrefix ) {
    if( null == pPrefix ) {
      return; // ignore
    }
    writer__iFileNamePrefix = pPrefix;
  }



  /** Get prefix of files to be generated. */
  public String _getFileNamePrefix() {
    return writer__iFileNamePrefix;
  }



  /** Set the suffix of the files to be generated. */
  public void _setFileNameSuffix( String pSuffix ) {
    if( null == pSuffix ) {
      return; // ignore
    }
    writer__iFileNameSuffix = pSuffix;
  }



  /** Get suffix of files to be generated. */
  public String _getFileNameSuffix() {
    return writer__iFileNameSuffix;
  }



  /** Set the full name of the file to be generated. 
   *  Prefix and Suffix are set to empty.
   */
  public void _setFullFileName( String pName ) {
    _setFileNamePrefix( WRITER__STRING_empty );
    _setFileNameRoot(   pName );
    _setFileNameSuffix( WRITER__STRING_empty );
  }



  /** Get the full name of current file being generated. */
  public String _getFullFileName() {
    return _getFileNamePrefix() + _getFileNameRoot() + _getFileNameSuffix();
  }



  /** Set the names of the files to be generated. 
   *  Prefix and Suffix are set to empty.
   */
  public void _setFullFileNames( String[] pNames ) {
    _setFileNamePrefix( WRITER__STRING_empty );
    _setFileNameRoots(  pNames );
    _setFileNameSuffix( WRITER__STRING_empty );
  }



  /** Get the full names of the files to be generated. */
  public String[] _getFullFileNames() {

    String[] fileNameRoots  = _getFileNameRoots();
    int      numFiles       = fileNameRoots.length;
    String[] fullFileNames  = new String[ numFiles ];
    String   fileNamePrefix = _getFileNamePrefix();
    String   fileNameSuffix = _getFileNameSuffix();

    for( int fileI = 0; fileI < numFiles; fileI = fileI + 1 ) {
      fullFileNames[ fileI ] = fileNamePrefix + fileNameRoots[ fileI ] + fileNameSuffix;
    }

    return fullFileNames;
  }



  /** Set the root of the name of the file to be generated. */
  public void _setFileNameRoot( String pFileNameRoot ) {
    if( null == pFileNameRoot ) {
      return; // ignore
    }
    _setFileNameRoots( new String[] { pFileNameRoot } );
  }



  /** Get the root of the name of the current file being generated. */
  public String _getFileNameRoot() {
    if( 0 < writer__iFileNameRoots.length ) {
      return writer__iFileNameRoots[ writer__iCurrentFileIndex ];
    }
    return WRITER__STRING_empty;
  }



  /** Set the roots of the names of the files to be generated. */
  public void _setFileNameRoots( String[] pFileNameRoots ) {
    if( null == pFileNameRoots ) {
      return; // ignore
    }

    // copy
    String[] roots = (String[]) pFileNameRoots.clone();

    // normalize - replace nulls
    int numRoots = roots.length;
    for(int rootI = 0; rootI < numRoots; rootI = rootI + 1 ) {
      if( null == roots[ rootI ] ) {
        roots[ rootI ] = WRITER__STRING_empty;
      }
    }

    // save roots
    writer__iFileNameRoots = roots;
    writer__iNumFiles      = numRoots;
  }



  /** Get roots of the names of files to be generated. */
  public String[] _getFileNameRoots() {
    return writer__iFileNameRoots;
  }



  /** Get index of file currently being generated. */
  public int _getFileIndex() {
    return writer__iCurrentFileIndex;
  }



  /** Get number of files to generate. */
  public int _getNumFiles() {
    return writer__iNumFiles;
  }



  /** Set output folder. */
  public void _setOutputFolder( String pOutputFolder ) {
    writer__iOutputFolder = pOutputFolder;
  }



  /** Get output folder. */
  public String _getOutputFolder() {
    return writer__iOutputFolder;
  }



  /** Set backup folder. */
  public void _setBackupFolder( String pBackupFolder ) {
    writer__iBackupFolder = writer__iOutputFolder + WRITER__STRING_separator + pBackupFolder;
  }



  /** Get backup folder. */
  public String _getBackupFolder() {
    return writer__iBackupFolder;
  }



  /** Set the prefix of backup files. */
  public void _setBackupPrefix( String pPrefix ) {
    if( null == pPrefix ) {
      return; // ignore
    }
    writer__iBackupPrefix = pPrefix;
  }



  /** Set the suffix of backup files. */
  public void _setBackupSuffix( String pSuffix ) {
    if( null == pSuffix ) {
      return; // ignore
    }
    writer__iBackupSuffix = pSuffix;
  }



  /** Set to true if generated files are to be backed up to disk automatically. */
  public void _backup( boolean pBackup ) {
    writer__iBackup = pBackup;
  }



  /** Set to true if generated files are to be saved to disk automatically. */
  public void _save( boolean pSave ) {
    writer__iSave = pSave;
  }



  /** Save a text file. */
  public void _saveTextFile( String pFilePath, String pContent ) throws Exception {
    StringReader   sr = new StringReader( pContent );
    BufferedReader br = new BufferedReader( sr );
    FileWriter     fw = new FileWriter( pFilePath );
    BufferedWriter bw = new BufferedWriter( fw );

    String line;
    while( null != (line = br.readLine()) ) {
      bw.write( line );
      bw.newLine();
    }

    bw.close();
    br.close();
  }



  /** Load a text file. */
  public String _loadTextFile( String pFilePath ) throws Exception {
    File       file       = new File( pFilePath );
    FileReader in         = new FileReader( file );
    int        size       = (int) file.length();
    char[]     data       = new char[size];
    int        charsRead  = 0;

    while( charsRead < size ) {
      charsRead += in.read( data, charsRead, size - charsRead );
    }

    return new String( data );
  }

