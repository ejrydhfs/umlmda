package <%=getPackageName()%>;

<%=genClass.registeredImports()%>

/**
 * EJB-Utility class for <%=getModelClass().getName()%>.
 */
public class <%=genClass.getGeneratedName()%>
{
   /** Cached remote home (EJBHome). Uses lazy loading to obtain its value (loaded by getHome() methods). */
   private static <%=homeInterface%> cachedRemoteHome = null;

   private static Object lookupHome(java.util.Hashtable environment, String jndiName, Class narrowTo) throws javax.naming.NamingException {
      // Obtain initial context
      javax.naming.InitialContext initialContext = new javax.naming.InitialContext(environment);
      try {
         Object objRef = initialContext.lookup(jndiName);
         // only narrow if necessary
         if (java.rmi.Remote.class.isAssignableFrom(narrowTo)) 
            return javax.rmi.PortableRemoteObject.narrow(objRef, narrowTo);
         else
            return objRef;
      } finally {
         initialContext.close();
      }
   }

   // Home interface lookup methods

   /**
    * Obtain remote home interface from default initial context
    * @return Home interface for <%=getModelClass().getName()%>. Lookup using COMP_NAME
    */
   public static <%=homeInterface%> getHome() throws javax.naming.NamingException
   {
      if (cachedRemoteHome == null) { 
         try { 
            cachedRemoteHome = (<%=homeInterface%>) lookupHome(null, <%=homeInterface%>.COMP_NAME, <%=homeInterface%>.class); 
         } catch (javax.naming.NamingException e){
            // Eat exception, some implementation throws naming exceptions, return null 
         }
         // If not yet resolved try with JNDI name of component
         if (cachedRemoteHome == null) { 
            cachedRemoteHome = (<%=homeInterface%>) lookupHome(null, <%=homeInterface%>.JNDI_NAME, <%=homeInterface%>.class); 
         } 
      } 
      return cachedRemoteHome;
   }


}