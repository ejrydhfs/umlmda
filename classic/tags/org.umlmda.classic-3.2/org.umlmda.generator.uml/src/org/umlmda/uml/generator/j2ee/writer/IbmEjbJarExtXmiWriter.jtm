<% @conf 
main.JostracaVersion       = 0.3
main.CodeWriter            = IbmEjbJarExtXmiWriter
main.CodeWriterFormat	   = format\\ParentJavaWriterFormat.jwf
java.CodeWriter.package    = org.umlmda.uml.generator.j2ee.writer
java.CodeWriter.extends    = org.umlmda.uml.generator.j2ee.AbstractPackageWriter
%><% import!
import org.umlmda.model.uml.*;
import org.umlmda.profile.ModelStereotype;
import java.util.Iterator;

// ==== End of generation header ===============================================
%><% @section declare %><%
%><% @section %><?xml version="1.0" encoding="ISO-8859-1"?>
<ejbext:EJBJarExtension xmi:version="2.0"
	xmlns:xmi="http://www.omg.org/XMI"
	xmlns:ejbext="ejbext.xmi"
	xmlns:ejb="ejb.xmi"
	xmi:id="EJBJarExtension_1">

  <ejbExtensions xmi:type="ejbext:SessionExtension" xmi:id="SessionExtension_1">
    <!-- Session Beans -->
<% 
   for ( Iterator ia = getModelPackage().getClasses().iterator(); ia.hasNext(); ) {
	   ModelClass modelClass = (ModelClass)ia.next();
     String modelClassName = modelClass.getName();
     String packageName = modelClass.getPackage().getQualifiedName();
     
     if ( modelClass.hasStereotype(ModelStereotype.BUSINESS_SERVICE) ) {
%>    <enterpriseBean xmi:type="ejb:Session" href="META-INF/ejb-jar.xml#<%=modelClassName%>"/>
<%   }     
   } 
%>    
<!-- UserSection-Begin enterprise-beans -->
    <localTransaction xmi:id="LocalTransaction" boundary="BeanMethod" resolver="ContainerAtBoundary" unresolvedAction="Commit"/>
<!-- UserSection-End enterprise-beans -->
  </ejbExtensions>
  <ejbJar href="META-INF/ejb-jar.xml#ejb-jar_ID"/>
</ejbext:EJBJarExtension>