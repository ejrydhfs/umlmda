<% @conf 
main.JostracaVersion       = 0.3
main.CodeWriter            = BusinessObjectFactoryWriter
main.CodeWriterFormat	     = format\\ParentJavaWriterFormat.jwf
java.CodeWriter.package    = org.umlmda.uml.generator.java.writer
java.CodeWriter.extends    = org.umlmda.uml.generator.java.AbstractBusinessFactoryWriter
%><% import!
import org.umlmda.generator.model.util.RcsHelper;
import org.umlmda.model.uml.*;
import java.util.*;
import org.umlmda.profile.*;
import org.umlmda.uml.generator.java.*;
// ==== End of generation header ===============================================
%><% @section declare %><%
   public String getFileExt() {
   		return ".java";
   }
%><% @section %><%
   JavaModelPackage genPackage = (JavaModelPackage)getGenPackage();
   JavaModel genModel = (JavaModel)genPackage.getGeneratorModel();
   
   genPackage.resetImports();
   genPackage.registerImports(JavaArtefacts.BUSINESS_OBJECT_INTERFACE, genPackage.getClasses(), ModelStereotype.BUSINESS_OBJECT);
%>//@@Generated file, please edit UserSections only
//@@UserSection-Begin RCSHeader
<%=RcsHelper.writeHeader("// ")%>
//@@UserSection-End RCSHeader

package <%=getPackageName()%>;

<%=genPackage.registeredImports()%>

/**
 *
 */
public interface <%=genPackage.getGeneratedName()%>
{
<% // Factory-Methods
   for ( Iterator ia = getModelPackage().getClasses().iterator(); ia.hasNext(); ) {
	   JavaModelClass genClass = (JavaModelClass)ia.next();
	   String businessInterface = null;
	   
      if ( genClass.isAbstract() == false && genClass.hasStereotype(ModelStereotype.BUSINESS_OBJECT)) {
		   businessInterface = genPackage.getScopedName(JavaArtefacts.BUSINESS_OBJECT_INTERFACE, genClass);
%>   /**
   * Create Businessinterface for <%=genClass.getName()%>
   * @see <%=businessInterface%>
   */
   public <%=businessInterface%> create<%=genClass.getName()%>();
<%	   
       ModelClass parent = getParent(genClass);
       
       if ( isInheritPKeyFromParent(genClass) && parent.getKeyAttributes().size() > 0 ) {%>
   /**
   * Create Businessinterface for <%=genClass.getName()%>, using the
   * parent class for setting the primary keys
   * @see <%=businessInterface%>
   */
   public <%=businessInterface%> create<%=genClass.getName()%>(<%=getType(parent)%> parent, <%=getParameterSignature(getOwnedKeyAttributes(genClass, true))%>);
<%     }
       if ( genClass.getKeyAttributes().size() > 0 ) {%>
   /**
   * Create Businessinterface for <%=genClass.getName()%>, giving the
   * primary key attributes.
   * @see <%=businessInterface%>
   */
   public <%=businessInterface%> create<%=genClass.getName()%>(<%=getParameterSignature(genClass.getKeyAttributes())%>);
<%     }
     } // if
	 } // for
%>	    

}

//@@UserSection-Begin RCSLog
<%=RcsHelper.writeLog("// ")%>
//@@UserSection-End RCSLog
