<?xml version="1.0" encoding="UTF-8"?>
<project name="org.umlmda.generator.uml" default="jostraca.generate" basedir=".">
	
	<!-- ================================= 
          target: pre.runtime/org.umlmda.generator.uml.jar, pde build callback             
         ================================= -->
    <target name="pre.runtime/org.umlmda.generator.uml.jar" depends="jostraca.generate" description="pde build callback">
        
    </target>

	<!-- - - - - - - - - - - - - - - - - - 
          target: jostraca.init                      
         - - - - - - - - - - - - - - - - - -->
    <target name="jostraca.init">
		<property name="writer.src" value="${basedir}/src/org/umlmda/uml/generator"/>
		<!--Jostraca Properties (JSP-Generator)-->
		<property name="jostraca.version" value="0.3.3"/>
		<property name="jostraca.dir" value="../org.umlmda.generator.core/lib/jostraca"/>
		<taskdef name="jostraca" classname="org.jostraca.JostracaTask">
			<classpath>
				<fileset dir="${jostraca.dir}/lib">
					<include name="**/*.jar"/>
				</fileset>
			</classpath>
		</taskdef>
    </target>

	<!-- ================================= 
          target: jostraca.generate              
         ================================= -->
    <target name="jostraca.generate" depends="jostraca.init" description="Generate java for jostrace templates">
        <echo message="Compile JOSTRACA templates"/>
		<echo level="info" message="Using jostraca from ${jostraca.dir}"/>

		<antcall target="compileJavaTemplates"/>
		<antcall target="compileJ2EETemplates"/>
		<antcall target="compileIDLTemplates"/>
		<antcall target="compileCppTemplates"/>
		<antcall target="compileDocbookTemplates"/>
		<antcall target="compileSqlTemplates"/>
		<antcall target="compileHibernateTemplates"/>
		<antcall target="compileWebServicesTemplates"/>
		<antcall target="compileXMLTemplates"/>
    </target>

	<target name="compileJavaTemplates" depends="jostraca.init" description="compile the java writer templates">
		<!-- Java Code Templates -->
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/java"/>
			<param name="template" value="BusinessException"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/java"/>
			<param name="template" value="BusinessFactory"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/java"/>
			<param name="template" value="BusinessObjectFactory"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/java"/>
			<param name="template" value="BusinessObjectFactoryImpl"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/java"/>
			<param name="template" value="BusinessInterface"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/java"/>
			<param name="template" value="SimpleBean"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/java"/>
			<param name="template" value="PersistenceInterface"/>
		</antcall>
	</target>

	<target name="compileJ2EETemplates" depends="jostraca.init"  description="compile the j2ee writer templates">
		<!-- Java J2EE Code Templates -->
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/j2ee"/>
			<param name="template" value="HomeInterface"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/j2ee"/>
			<param name="template" value="LocalHomeInterface"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/j2ee"/>
			<param name="template" value="LocalInterface"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/j2ee"/>
			<param name="template" value="RemoteInterface"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/j2ee"/>
			<param name="template" value="SessionBean"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/j2ee"/>
			<param name="template" value="BeanUtils"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/j2ee"/>
			<param name="template" value="Adapter"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/j2ee"/>
			<param name="template" value="AdapterFactory"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/j2ee"/>
			<param name="template" value="EjbJarXml"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/j2ee"/>
			<param name="template" value="JBossXml"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/j2ee"/>
			<param name="template" value="IbmEjbJarExtXmi"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/j2ee"/>
			<param name="template" value="IbmEjbJarBndXmi"/>
		</antcall>
	</target>

	<target name="compileWebServicesTemplates" depends="jostraca.init" description="compile the webservcies writer templates">
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/webservices"/>
			<param name="template" value="WSDL"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/webservices"/>
			<param name="template" value="OptimizedWSDL"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/webservices"/>
			<param name="template" value="OptimizedXSD"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/webservices"/>
			<param name="template" value="WSServlet"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/webservices"/>
			<param name="template" value="WSAdapter"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/webservices"/>
			<param name="template" value="WSAdapterUtils"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/webservices"/>
			<param name="template" value="WSAdapterFactory"/>
		</antcall>
	</target>

	<target name="compileCppTemplates" depends="jostraca.init">
		<!-- C++ Templates -->
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/cpp"/>
			<param name="template" value="CppBusinessFactory"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/cpp"/>
			<param name="template" value="CppBusinessFactorySource"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/cpp"/>
			<param name="template" value="CppBusinessInterface"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/cpp"/>
			<param name="template" value="CppBusinessInterfaceSource"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/cpp"/>
			<param name="template" value="CppBusinessObject"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/cpp"/>
			<param name="template" value="CppBusinessObjectSource"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/cpp"/>
			<param name="template" value="CppSimpleClass"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/cpp"/>
			<param name="template" value="CppSimpleClassSource"/>
		</antcall>
	</target>

	<target name="compileIDLTemplates" depends="jostraca.init">
		<!-- IDL Templates -->
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/idl"/>
			<param name="template" value="IDL"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/idl"/>
			<param name="template" value="IDLStructure"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/idl"/>
			<param name="template" value="IDLInterface"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/idl"/>
			<param name="template" value="IDLException"/>
		</antcall>
	</target>

	<target name="compileDocbookTemplates" depends="jostraca.init">
		<!-- DocBook Templates -->
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/docbook"/>
			<param name="template" value="Package"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/docbook"/>
			<param name="template" value="Class"/>
		</antcall>
	</target>

	<target name="compileHibernateTemplates" depends="jostraca.init">
		<!-- Hibernate Templates -->
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/hibernate"/>
			<param name="template" value="ClassMapping"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/hibernate"/>
			<param name="template" value="PersistenceService"/>
		</antcall>
	</target>

	<target name="compileSqlTemplates" depends="jostraca.init">
		<!-- DocBook Templates -->
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/sql"/>
			<param name="template" value="DDL"/>
		</antcall>
	</target>

	<target name="compileXMLTemplates" depends="jostraca.init" description="compile the XML writer templates">
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/xml"/>
			<param name="template" value="AttributeSchema"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/xml"/>
			<param name="template" value="ElementSchema"/>
		</antcall>
		<antcall target="compileNewerTemplate">
			<param name="subdir" value="/xml"/>
			<param name="template" value="Marshaller"/>
		</antcall>
	</target>


	<target name="compileNewerTemplate">
		<!--
		<uptodate property="jostraca.notrequired" targetfile="${writer.src}/${template}writer.java" srcfile="${writer.src}/${template}writer.jtm" />
      -->
		<antcall target="compileTemplate"/>
	</target>

	<target name="compileTemplate" unless="jostraca.notrequired">
		<property name="subdir" value="/."/>
		<jostraca homeFolder="${jostraca.dir}" backup="no" compile="no" generate="no" verbose="yes" template="${writer.src}${subdir}/writer/${template}Writer.jtm" outputFolder="${writer.src}${subdir}/writer" />
	</target>
	
</project>