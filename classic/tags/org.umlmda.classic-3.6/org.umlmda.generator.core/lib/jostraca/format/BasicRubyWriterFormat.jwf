!<header>



!<{import># section:import <<
#

!<import>

#
# section:import >> !<}import>



!<{require># section:require <<
#

!<require>

#
# section:require >> !<}require>



class $<main.CodeWriter> $<{ruby.CodeWriter.extends> < $<ruby.CodeWriter.extends> $<}ruby.CodeWriter.extends> 
  
  # Constants << #
   
  # Command line arguments
  WRITER__ARGUMENT_CONTROL_PREFIX         = "$<main.CodeWriter.argument.ControlPrefix>"
  WRITER__ARGUMENT_OutputFolder           = "$<main.CodeWriter.argument.name.OutputFolder>"
  WRITER__ARGUMENT_BackupFolder           = "$<main.CodeWriter.argument.name.BackupFolder>"
  WRITER__ARGUMENT_NoBackup               = "$<main.CodeWriter.argument.name.NoBackup>"
  
  # User Interface text message parts
  WRITER__UITEXT_Method                   = "method ";
  WRITER__UITEXT_Main                     = "main ";
  WRITER__UITEXT_ExceptionIn              = "Exception in ";
  WRITER__UITEXT_ColonNewLine             = ":\n";
  WRITER__UITEXT_NewLine                  = "\n";
  WRITER__UITEXT_Section                  = "section ";
  WRITER__UITEXT_SavedFile                = "Saved file:       ";
  WRITER__UITEXT_UnableToSaveFile         = "Unable to save file: ";
  WRITER__UITEXT_UnableToBackupFile       = "Unable to backup file: ";
  WRITER__UITEXT_ToBackupFolder           = " to backup folder: ";
  WRITER__UITEXT_BackupFolderColon        = "Backup folder: ";
  WRITER__UITEXT_BackupFolderExistFailure = " does not exist and cannot be created.";
  WRITER__UITEXT_BackupFolderNotAFolder   = " is not a folder.";
  WRITER__UITEXT_BackupFolderNotWritable  = " is not writable.";
  WRITER__UITEXT_CodeWriterState          = "Code Writer State: ";
  WRITER__UITEXT_GetFileIndexEquals       = "\n_getFileIndex()    = ";
  WRITER__UITEXT_GetFullFileNameEquals    = "\n_getFullFileName() = ";
  WRITER__UITEXT_GetOutputFolderEquals    = "\n_getOutputFolder() = ";
  WRITER__UITEXT_ErrorHeader              = "\n\n--- CodeWriter Error Description Start ---\n\n";
  WRITER__UITEXT_ErrorFooter              = "\n--- CodeWriter Error Description End -----\n\n";
  WRITER__UITEXT_PlaceHolderException     = "This placeholder Exception should never be thrown: there is an error in the WriterFormat.";

  # String constants
  WRITER__STRING_empty                    = ""
  WRITER__STRING_dot                      = "."
  WRITER__STRING_separator                = "$<\jostraca.system.fileSeparator>"

  # Constants >> #
  

  
  
  # Writer Variables << #
  
  def writer__initInstanceVars()
    @writer__iFileNameRoots         = []                    # generated file name roots
    @writer__iNumFiles              = 0                     # number of generated files
    
    @writer__iFileNamePrefix        = WRITER__STRING_empty  # failsafe default
    @writer__iFileNameSuffix        = WRITER__STRING_empty  # failsafe default
  
    @writer__iBackupPrefix          = WRITER__STRING_empty  # failsafe default
    @writer__iBackupSuffix          = WRITER__STRING_empty  # failsafe default
  
    @writer__iCurrentText           = WRITER__STRING_empty  # current text
    @writer__iCurrentFileIndex      = 0                     # current file index
  
    @writer__iArgs                  = []                    # cmd line args
    @writer__iNumArgs               = 0                     # number of cmd line args
    @writer__iUserArgs              = []                    # user cmd line args
    @writer__iNumUserArgs           = 0                     # number of user cmd line args
  
    @writer__iSave                  = true                  # save generated code to disk
    @writer__iBackup                = true                  # make backups
  
    @writer__iOutputFolder          = WRITER__STRING_dot    # written code is output to this folder
    @writer__iBackupFolder          = WRITER__STRING_dot    # overwritten files are placed here
  
    @writer__iProperties            = {}                    # lookup table for compile time properties
    @writer__iPropertiesInit        = false                 # true => lookup table initialiased
  end  

  # Writer Variables >> #
  
  

  
  !<{support>
  # version 0.1 compatibility
  # section:support << 
  #

  !<support>

  #
  # section:support >> !<}support>



  !<{declare># section:declare <<
  #
  
  !<declare>
  
  #
  # section:declare >> !<}declare>
  
    
  
  # Execute.
  def $<main.CodeWriter>.main( pArgs )
    begin
      codeWriter = $<main.CodeWriter>.new
      codeWriter.writer__initialize()
      codeWriter.writer__handleArgs( pArgs )
      codeWriter.writer__write()
    rescue
      codeWriter.writer__handleException( WRITER__UITEXT_ExceptionIn + WRITER__UITEXT_Method + WRITER__UITEXT_Main, $! )      
    end
  end




  # Writer Services << #
  
  # Initialize.
  def writer__initialize()
    @writer__iCurrentFileIndex = 0
    writer__initInstanceVars()
    writer__setDefaults()
  end
  
  

  # Main file generation loop. Template script is placed here in the body section.
  def writer__write()

    # initialize
    writer__currentSection = "init"
  
  
    begin
  
      !<{init># section:init << 
      #
  
      !<init>
  
      #
      # section:init >> !<}init> 
  
  
      # write files loop
      writer__numFiles = _getNumFiles()
      writer__fileI    = 0
      for writer__fileI in 0...writer__numFiles

        begin
  
          !<{prewrite># section:prewrite << 
          # 
  
          writer__currentSection = "prewrite"
          !<prewrite>
  
          #
          # section:prewrite >> !<}prewrite> 
  
  
          if ! writer__startFile()
            next
          end
  
  
          !<{body># section:body << 
          #
  
          writer__currentSection = "body"
          !<body>
  
          #
          # section:body >> !<}body> 
  
  
          if ! writer__endFile()
            next
          end
  
  
          !<{postwrite># section:postwrite << 
          # 
  
          writer__currentSection = "postwrite"
          !<postwrite>
  
          #
          # section:postwrite >> !<}postwrite> 
  
  
        rescue
          writer__handleException( WRITER__UITEXT_ExceptionIn + WRITER__UITEXT_Section + writer__currentSection, $! )
        end
  
        writer__nextFile()       
      end
   
  
        !<{cleanup># section:cleanup << 
        #
   
        writer__currentSection = "cleanup"
        !<cleanup>
  
        #
        # section:cleanup >> !<}cleanup> 
  
    rescue
      writer__handleException( WRITER__UITEXT_ExceptionIn + WRITER__UITEXT_Section + writer__currentSection, $! )
    end
  end
  
  
  
  # Start writing a file.
  def writer__startFile()
    @writer__iCurrentText = WRITER__STRING_empty
    return true
  end
  
  
  
  # End writing a file.
  def writer__endFile()
    endOK = true
  
    fileName = _getFullFileName()
    filePath = _getOutputFolder() + WRITER__STRING_separator + fileName # CP!

    if @writer__iBackup
      begin
        writer__backup( filePath, fileName, @writer__iBackupFolder )
      rescue
        writer__handleException( WRITER__UITEXT_UnableToBackupFile + filePath + WRITER__UITEXT_ToBackupFolder + @writer__iBackupFolder, $! )
        endOK = false
      end
    end

    if( endOK && @writer__iSave )
      begin
        _saveTextFile( filePath, @writer__iCurrentText )
        writer__userMessage( WRITER__UITEXT_SavedFile + filePath + WRITER__UITEXT_NewLine )
  
      rescue
        writer__handleException( WRITER__UITEXT_UnableToSaveFile + filePath, $! )
        endOK = false
      end
    end
  
    return endOK
  end
  
  
  
  # Move to next file.
  def writer__nextFile()
    @writer__iCurrentFileIndex = @writer__iCurrentFileIndex + 1
  end
  
  
  
  # Handle command line arguments to CodeWriter.
  def writer__handleArgs( pArgs )
  
    # set arg names
    argName_OutputFolder           = WRITER__ARGUMENT_CONTROL_PREFIX + WRITER__ARGUMENT_OutputFolder
    argName_BackupFolder           = WRITER__ARGUMENT_CONTROL_PREFIX + WRITER__ARGUMENT_BackupFolder
    argName_NoBackup               = WRITER__ARGUMENT_CONTROL_PREFIX + WRITER__ARGUMENT_NoBackup
  
    # parse args
    # ...
  
    numArgs = pArgs.length
    argI    = 0
    for argI in 0...numArgs
      if( pArgs[argI] =~ /^#{argName_OutputFolder}(.*)/ )
        _setOutputFolder( $1 )

      elsif( pArgs[argI] =~ /^#{argName_BackupFolder}(.*)/ )
        _setBackupFolder( $1 )

      elsif( argName_NoBackup = pArgs[argI] )
        _backup( "$<lang.FalseString>" ); ## NOTE: -B => don't make backups
      end
    end
  
    writer__initArgs( pArgs.length, pArgs )
  
  end
  
  
  
  # Set defaults from configuration property set.
  def writer__setDefaults()

    $<{main.FileNameRoot>_setFileNameRoot( "$<\main.FileNameRoot>" );$<}main.FileNameRoot>
    $<{main.FileNamePrefix>_setFileNamePrefix( "$<\main.FileNamePrefix>" );$<}main.FileNamePrefix>
    $<{main.FileNameSuffix>_setFileNameSuffix( "$<\main.FileNameSuffix>" );$<}main.FileNameSufffix>

    $<{main.OutputFolder>_setOutputFolder( "$<\main.OutputFolder>" );$<}main.OutputFolder>

    $<{main.BackupFolder>_setBackupFolder( "$<\main.BackupFolder>" );$<}main.BackupFolder>
    $<{main.BackupPrefix>_setBackupPrefix( "$<\main.BackupPrefix>" );$<}main.BackupPrefix>
    $<{main.BackupSuffix>_setBackupSuffix( "$<\main.BackupSuffix>" );$<}main.BackupSufffix>
    _backup( "$<lang.TrueString>" == "$<jostraca.MakeBackup>" );

  end
  
  
  # Initialize command line arguments.
  def writer__initArgs( pNumArgs, pArgs )
    argI     = 0
    userArgI = 0

    @writer__iNumArgs     = pNumArgs
    @writer__iArgs        = pArgs
    @writer__iNumUserArgs = @writer__iNumArgs

    for argI in 0...@writer__iNumArgs
      if( @writer__iArgs[argI] =~ /^#{WRITER__ARGUMENT_CONTROL_PREFIX}/ )
        @writer__iNumUserArgs = @writer__iNumUserArgs - 1;
      end
    end

    for argI in 0...@writer__iNumArgs
      if( @writer__iArgs[argI] =~ /^#{WRITER__ARGUMENT_CONTROL_PREFIX}/ )
        next;
      else 
        @writer__iUserArgs[ userArgI ] = @writer__iArgs[ argI ];
        userArgI = userArgI + 1;
      end
    end     
  end
  
  
  # Print a user readable message.
  def writer__userMessage( pMessage )
    print( pMessage )
  end
  
  
  
  # Handle exceptions: print an explanation for user.
  def writer__handleException( pMessage, pException )
  
    userMsg = WRITER__UITEXT_ErrorHeader

    # CP!
    writerState = WRITER__STRING_empty
    begin
      writerState = writer__describeState()
    rescue 
      # leave empty
    end

    userMsg = userMsg + writerState + pMessage + WRITER__UITEXT_ColonNewLine
    userMsg = userMsg + pException.message + WRITER__UITEXT_NewLine
    userMsg = userMsg + pException.backtrace.join( WRITER__UITEXT_NewLine )
    userMsg = userMsg + WRITER__UITEXT_ErrorFooter
  
    writer__userMessage( userMsg )
  end
  
  
  
  # Provide a concise description of the state of the CodeWriter.
  def writer__describeState()
    currentState                                                     \
      = WRITER__UITEXT_CodeWriterState                               \
      + WRITER__UITEXT_GetFileIndexEquals    + _getFileIndex().to_s  \
      + WRITER__UITEXT_GetFullFileNameEquals + _getFullFileName()    \
      + WRITER__UITEXT_GetOutputFolderEquals + _getOutputFolder()    \
      + WRITER__UITEXT_NewLine
           
    return currentState
  end

  
    
  # Backup overwritten files, if they exist.
  # Backups have the format: [YYYYMMDDhhmmss][prefix][filename][suffix].
  def writer__backup( pFilePath, pFileName, pBackupFolder )
  
    backupFolder = pBackupFolder
  
    # check backup folder ( create if necessary )
    if( !( FileTest.exist?(backupFolder) ) )
      if( !( Dir.mkdir( backupFolder, 0700 ) ) )
        raise( WRITER__UITEXT_BackupFolderColon + backupFolder + WRITER__UITEXT_BackupFolderExistFailure )
      end
    end
    if( !( FileTest.directory?(backupFolder) ) )
      raise( WRITER__UITEXT_BackupFolderColon + backupFolder + WRITER__UITEXT_BackupFolderNotAFolder )
    end
    if( !( FileTest.writable?(backupFolder) ) )
      raise( WRITER__UITEXT_BackupFolderColon + backupFolder + WRITER__UITEXT_BackupFolderNotWritable )
    end
  

    # create backup file path
    calendar = Time.new

    year_yyyy = _align( calendar.year   ,"0", 4, 'r' )
    month_mm  = _align( calendar.month  ,"0", 2, 'r' )
    day_dd    = _align( calendar.day    ,"0", 2, 'r' )
    hour_hh   = _align( calendar.hour   ,"0", 2, 'r' )
    minute_mm = _align( calendar.min    ,"0", 2, 'r' )
    second_ss = _align( calendar.sec    ,"0", 2, 'r' )
    dateTime  = year_yyyy + month_mm + day_dd + hour_hh + minute_mm + second_ss

    backupFileName = dateTime + @writer__iBackupPrefix + pFileName + @writer__iBackupSuffix
    backupFilePath = backupFolder + WRITER__STRING_separator + backupFileName # CP!
      
    # save backup file
    if( FileTest.exist?( pFilePath ) )
      fileContents = _loadTextFile( pFilePath )
      _saveTextFile( backupFilePath, fileContents )
    end
  end
  
  
  
  # Set compile time properties.
  def writer__initProperties()
    $<{jostraca.properties.NameValueList>
    @writer__iProperties = { $<jostraca.properties.NameValueList> }
    @writer__iPropertiesInit = true
    $<}jostraca.properties.NameValueList>
  end
  
  # Writer Services >> #
  
  


  # Template Services (File Generation) << #
  
  # Set the prefix of the files to be generated. 
  def _setFileNamePrefix( pPrefix )
    @writer__iFileNamePrefix = pPrefix
  end
  
  

  # Get prefix of files to be generated.
  def _getFileNamePrefix()
    return @writer__iFileNamePrefix
  end
  
  
  
  # Set the suffix of the files to be generated.
  def _setFileNameSuffix( pSuffix )
    @writer__iFileNameSuffix = pSuffix
  end
  
  
  
  # Get suffix of files to be generated.
  def _getFileNameSuffix()
    return @writer__iFileNameSuffix
  end
  
  
  
  # Set the full name of the file to be generated. 
  # Prefix and Suffix are set to empty.
  def _setFullFileName( pName )
    _setFileNamePrefix( WRITER__STRING_empty )
    _setFileNameRoot(   pName )
    _setFileNameSuffix( WRITER__STRING_empty )
  end
  
  

  # Get the full name of current file being generated.
  def _getFullFileName()
      return _getFileNamePrefix() + _getFileNameRoot() + _getFileNameSuffix()
  end
  
  
  
  # Set the names of the files to be generated. 
  # Prefix and Suffix are set to empty.
  def _setFullFileNames( pNames )
      _setFileNamePrefix( WRITER__STRING_empty )
      _setFileNameRoots(  pNames )
      _setFileNameSuffix( WRITER__STRING_empty )
  end
  
  

  # Get the full names of the files to be generated.
  def _getFullFileNames()
  
      fileNameRoots  = _getFileNameRoots()
      numFiles       = fileNameRoots.length
      fullFileNames  = []
      fileNamePrefix = _getFileNamePrefix()
      fileNameSuffix = _getFileNameSuffix()
  
      fileI = 0
      for fileI in 0...numFiles
        fullFileNames[ fileI ] = fileNamePrefix + fileNameRoots[ fileI ] + fileNameSuffix
      end
  
      return fullFileNames
  end
  
  

  # Set the root of the name of the file to be generated. 
  def _setFileNameRoot( pFileNameRoot )
    _setFileNameRoots( [ pFileNameRoot ] )
  end
  
  

  # Get the root of the name of current file being generated.
  def _getFileNameRoot()
    if( nil == @writer__iFileNameRoots ) 
      return WRITER__STRING_empty
    else
      return @writer__iFileNameRoots[ @writer__iCurrentFileIndex ]
    end
  end



  # Set the roots of the names of the files to be generated. 
  def _setFileNameRoots( pFileNameRoots )
    @writer__iFileNameRoots = pFileNameRoots
    @writer__iNumFiles      = @writer__iFileNameRoots.length
  end

  

  # Get roots of the names of files to be generated.
  def _getFileNameRoots()
    return @writer__iFileNameRoots
  end
  
  
  
  # Get index of file currently being generated. 
  def _getFileIndex()
    return @writer__iCurrentFileIndex
  end
  
  

  # Get number of files to generate.
  def _getNumFiles
    return @writer__iNumFiles;
  end



  # Set output folder.
  def _setOutputFolder( pOutputFolder )
    @writer__iOutputFolder = pOutputFolder
  end
  
  
  
  # Get output folder.
  def _getOutputFolder()
    return @writer__iOutputFolder
  end
  
  
  
  # Set backup folder.
  def _setBackupFolder( pBackupFolder )
    @writer__iBackupFolder = @writer__iOutputFolder + "$<\jostraca.system.fileSeparator>" + pBackupFolder
  end
  
  
  
  # Get backup folder.
  def _getBackupFolder()
    return @writer__iBackupFolder
  end
  
  
  
  # Set the prefix of backup files.
  def _setBackupPrefix( pBackupPrefix )
    @writer__iBackupPrefix = pBackupPrefix
  end



  # Set the suffix of backup files.
  def _setBackupSuffix( pBackupSuffix )
    @writer__iBackupSuffix = pBackupSuffix
  end
  
  

  # Set to true if generated files are to be backed up to disk automatically.   
  def _backup( pBackup )
    @writer__iBackup = pBackup
  end


  
  # Set to true if generated files are to be saved to disk automatically. 
  def _save( pSave )
    @writer__iSave = pSave
  end
  
  

  # Save a text file.
  def _saveTextFile( pFilePath, pContent ) 
    file = open( pFilePath, "w" )
  	file.print pContent
    file.close()
  end
  
  

  # Load a text file.
  def _loadTextFile( pFilePath )
    content = ''
    file    = open( pFilePath, 'r' )
    file.readlines.each { |line| content += line }
    file.close
    return content
  end

  # Template Services (File Generation) >> #




  # Template Services (Control) << #

  # Get the value of a compile-time property.
  def _getProperty( pName )
  
    if ! @writer__iPropertiesInit
      writer__initProperties()
    end
  
    return @writer__iProperties[ pName ]
  end
  
  
  
  # Get first user arg.
  def _getFirstUserArg()
    return _getUserArg( 0 )
  end
  
  
  
  # Get second user arg.
  def _getSecondUserArg()
    return _getUserArg( 1 )
  end
  
  
  
  # Get third user arg.
  def _getThirdUserArg()
    return _getUserArg( 2 )
  end
  
  
  
  # Get nth (n=0,1,2,...) user arg (the nth arg with no WRITER__ARGUMENT_CONTROL_PREFIX).
  def _getUserArg( pOrdinal )
    if pOrdinal < _getNumUserArgs()
      userargs = _getUserArgs();
      return userargs[ pOrdinal ];
    else 
      return writer__STRING_empty;
    end
  end
  
  
  
  # Get user command line arguments to CodeWriter.
  def _getUserArgs()
    return @writer__iUserArgs;
  end



  # Get number of user command line arguments to CodeWriter.
  def _getNumUserArgs()
    return @writer__iNumUserArgs;
  end



  # Get command line arguments to CodeWriter. 
  def _getArgs()
    return @writer__iArgs
  end
  
  
  
  # Get number of command line arguments to CodeWriter.
  def _getNumArgs()
    return @writer__iNumArgs
  end
  
  # Template Services (Control) >> #
  



  # Template Services (Text Production) << #

  # Insert text into generated file. 
  def _insert( pText )
    text = pText.to_s
    @writer__iCurrentText = @writer__iCurrentText + text
  end
  
  
  
  # Create a String containing specified number of spaces.
  def _spaces( pNumSpaces )
    numSpaces = pNumSpaces.to_i
    return ' ' * numSpaces.abs
  end
  
  
  
  # Left align String with spaces. 
  def _left( pText, pColWidth )
    return _align( pText, " ", pColWidth, 'l' )
  end 
  
  
  
  # Right align String with spaces. 
  def _right( pText, pColWidth )
    return _align( pText, " ", pColWidth, 'r' )
  end 
  
  
  
  # Center align String with spaces. 
  def _center( pText, pColWidth )
    return _align( pText, " ", pColWidth, 'c' )
  end 
  
  
  
  # Align text within background text with specified column width.
  # Alignment can be 'l': left, 'c': center, 'r': right
  def _align( pText, pBackText, pColWidth, pAlignment )
    text     = pText.to_s
    backText = pBackText.to_s

    result   = text
 
    begin
      textLen = text.length
      if( pColWidth > textLen ) then
        backTextLen     = backText.length
        remainWidth     = pColWidth - textLen
        backTextRepeats = remainWidth / backTextLen;
        backTextRemain  = remainWidth % backTextLen;
        back            = WRITER__STRING_empty
        backTextI       = 0
        for backTextI in 0...backTextRepeats
          back += backText
        end
        back += backText[0...backTextRemain];
        
        if( 'l' == pAlignment ) then
          result = result + back
          
        elsif( 'c' == pAlignment ) then
          result = back[0...((back.length)/2)] + result + back[ (((back.length)/2))...back.length ];

        elsif( 'r' == pAlignment ) then
          result = back + result;

        end
      end
    rescue
      result = text
    end

    return result
  end



  # Set text of file currently being generated.
  def _setText( pCurrentText )
    @writer__iCurrentText = pCurrentText
  end



  # Get text of file currently being generated.
  def _getText()
    return @writer__iCurrentText
  end

  # Template Services (Text Production) >> */

end




# Start execution.
$<main.CodeWriter>.main( ARGV )
exit( 0 )



!<footer>
