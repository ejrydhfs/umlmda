<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
   <modelVersion>4.0.0</modelVersion>
   <parent>
      <groupId>org.umlmda</groupId>
      <artifactId>org.umlmda.releng</artifactId>
      <version>3.0.0-SNAPSHOT</version>
   </parent>
   <artifactId>org.umlmda.runtime.releng</artifactId>
   <packaging>pom</packaging>
   <version>2.1.0-SNAPSHOT</version>
   <name>UMLMDA runtime pom</name>
   <description>UMLMDA maven project for umlmda runtime modules.</description>

   <!-- inherited property values -->
   <properties>
      <spring.version>1.2.7</spring.version>
      <gwt.version>1.5.M2</gwt.version>
      <google.webtoolkit.home>${env.GWT_HOME}</google.webtoolkit.home>
   </properties>

   <dependencyManagement>
      <dependencies>
         <dependency>
            <groupId>com.google.gwt</groupId>
            <artifactId>gwt-user</artifactId>
            <scope>provided</scope>
            <version>${gwt.version}</version>
         </dependency>
         <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>servlet-api</artifactId>
            <version>2.4</version>
            <scope>provided</scope>
         </dependency>
         <dependency>
            <groupId>com.google.gwt</groupId>
            <artifactId>gwt-servlet</artifactId>
            <version>${gwt.version}</version>
         </dependency>
      </dependencies>
   </dependencyManagement>

   <modules>
      <module>../org.umlmda.runtime.gwt.jreemul</module>
      <module>../org.umlmda.runtime.core</module>
      <module>../org.umlmda.runtime.common</module>
      <module>../org.umlmda.runtime.sdo.sync</module>
      <module>../org.umlmda.runtime.sdo.sync.gwtclient</module>
      <module>../org.umlmda.runtime.sdo.sync.gwtserver</module>
      <!-- Test stuff -->
      <module>../org.umlmda.runtime.sdo.sync.test.pim</module>
      <module>../org.umlmda.runtime.sdo.sync.test.gwt</module>
      <module>../org.umlmda.runtime.sdo.sync.test.java</module>
      <module>../org.umlmda.runtime.sdo.sync.test</module>
      <!--module>../org.umlmda.runtime.sdo.sync.gwttest</module-->
   </modules>
   
   <repositories>
      <repository>
         <id>artifactory</id>
         <url>http://coding.ds2k.de/artifactory/repo</url>
         <releases>
            <enabled>true</enabled>
         </releases>
         <snapshots>
            <enabled>true</enabled>
         </snapshots>
      </repository>
   </repositories>
</project>