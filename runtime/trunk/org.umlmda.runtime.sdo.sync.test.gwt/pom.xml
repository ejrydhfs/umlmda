<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>
   <parent>
      <artifactId>org.umlmda.runtime.releng</artifactId>
      <groupId>org.umlmda</groupId>
      <version>2.0.0-SNAPSHOT</version>
   </parent>
   <modelVersion>4.0.0</modelVersion>
   <groupId>org.umlmda</groupId>
   <artifactId>org.umlmda.runtime.sdo.sync.test.gwt</artifactId>
   <name>UMLMDA SDO Sync-Service Test GWT Client Model</name>
   <description />

   <dependencies>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.gwt.jreemul</artifactId>
         <version>${pom.version}</version>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.core</artifactId>
         <version>${pom.version}</version>
      </dependency>
      <dependency>
         <groupId>${pom.groupId}</groupId>
         <artifactId>org.umlmda.runtime.sdo</artifactId>
         <version>${pom.version}</version>
      </dependency>
   </dependencies>

   <build>
      <plugins>
         <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
               <execution>
                  <id>add-source</id>
                  <phase>process-sources</phase>
                  <goals>
                     <goal>add-source</goal>
                  </goals>
                  <configuration>
                     <sources>
                        <source>${basedir}/src/generated/java</source>
                     </sources>
                  </configuration>
               </execution>
            </executions>
         </plugin>
         <!-- JRE Emulation mst be first in classpath -->
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
               <compilerArguments>
                  <bootclasspath>
                     ${basedir}/../org.umlmda.runtime.gwt.jreemul/target/classes;${java.home}/lib/rt.jar
                  </bootclasspath>
               </compilerArguments>
            </configuration>
         </plugin>
      </plugins>
   </build>

</project>