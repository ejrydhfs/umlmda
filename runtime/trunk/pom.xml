<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.umlmda</groupId>
		<artifactId>org.umlmda.releng</artifactId>
		<version>3.7</version>
	</parent>
	<artifactId>org.umlmda.runtime</artifactId>
	<packaging>pom</packaging>
	<version>3.23-SNAPSHOT</version>
	<name>UMLMDA runtime pom</name>
	<description>
		UMLMDA maven project for umlmda runtime modules.
	</description>

	<!-- inherited property values -->
	<properties>
		<spring.version>1.2.7</spring.version>
		<gwt.version>1.5.M2</gwt.version>
		<google.webtoolkit.home>${env.GWT_HOME}</google.webtoolkit.home>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.google.gwt</groupId>
				<artifactId>gwt-user</artifactId>
				<scope>provided</scope>
				<version>${gwt.version}</version>
			</dependency>
			<dependency>
				<groupId>javax.servlet</groupId>
				<artifactId>servlet-api</artifactId>
				<version>2.4</version>
				<scope>provided</scope>
			</dependency>
			<dependency>
				<groupId>com.google.gwt</groupId>
				<artifactId>gwt-servlet</artifactId>
				<version>${gwt.version}</version>
			</dependency>
			<dependency>
				<groupId>${pom.groupId}</groupId>
				<artifactId>org.umlmda.runtime.core</artifactId>
				<version>${pom.version}</version>
			</dependency>
			<dependency>
				<groupId>${pom.groupId}</groupId>
				<artifactId>org.umlmda.runtime.common</artifactId>
				<version>${pom.version}</version>
			</dependency>
			<dependency>
				<groupId>${pom.groupId}</groupId>
				<artifactId>org.umlmda.runtime.gwt.jreemul</artifactId>
				<version>${pom.version}</version>
			</dependency>
			<dependency>
				<groupId>${pom.groupId}</groupId>
				<artifactId>org.umlmda.runtime.gwt.jeeemul</artifactId>
				<version>${pom.version}</version>
			</dependency>
			<dependency>
				<groupId>oro</groupId>
				<artifactId>oro</artifactId>
				<version>2.0.8</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<modules>
		<module>org.umlmda.runtime.gwt.jreemul</module>
		<module>org.umlmda.runtime.gwt.jeeemul</module>
		<module>org.umlmda.runtime.core</module>
		<module>org.umlmda.runtime.common</module>
	</modules>
	
   <scm>
      <connection>scm:svn:https://umlmda.svn.sourceforge.net/svnroot/umlmda/runtime/trunk</connection>
      <developerConnection>scm:svn:https://umlmda.svn.sourceforge.net/svnroot/umlmda/runtime/trunk</developerConnection>
   </scm>

   <repositories>
      <repository>
         <id>artifactory</id>
         <url>http://coding.ds2k.de/artifactory/repo</url>
         <releases>
            <enabled>true</enabled>
         </releases>
         <snapshots>
            <enabled>true</enabled>
         </snapshots>
      </repository>
      <repository>
         <id>cor-artifactory</id>
         <url>http://cor-health-dev1:8090/artifactory/repo</url>
         <releases>
            <enabled>true</enabled>
         </releases>
         <snapshots>
            <enabled>true</enabled>
         </snapshots>
      </repository>
   </repositories>

</project>