<?xml version="1.0" encoding="UTF-8"?>
<workflow>

    <property file="workflow.properties"/>
    <property name="slot" value="test"/>

    <!-- initializes resourcemaps, urimaps, etc. -->
    <component class="org.openarchitectureware.adapter.rsdp.workflow.RSASetup" >
        <!-- Standard profiles -->
		<pathMapEntry>
			<alias value="UMLMDA_PROFILE"/>
			<path value="${umlmda.plugin.path}/org.umlmda.uml2.profile_2.1.0.200801142220/profiles"/>
		</pathMapEntry>
        <pathMapEntry>
            <alias value="UML2_MSL_PROFILES"/>
            <path value="${basedir}/profiles/rsm/3rd/ibm"/>
        </pathMapEntry>
    	<init value="true"/>
    </component> 

    <!-- Loading UMLMDA generation sets -->
	<component id="generationSetLoader"
			class="org.umlmda.oaw.generator.workflow.GenerationSetLoader">
		<generationSet value="${model.project}/etc/umlmda/self/set/SyncTestModelClient.ums"/>
		<generationSetSlot value="gs_gwtclient"/>
	</component>
	<component id="generationSetLoader"
			class="org.umlmda.oaw.generator.workflow.GenerationSetLoader">
		<generationSet value="${model.project}/etc/umlmda/self/set/SyncTestModelServer.ums"/>
		<generationSetSlot value="gs_gwtserver"/>
	</component>

	<!-- Read the uml model -->
	<component class="org.openarchitectureware.emf.XmiReader">
		<modelFile value="${model}" />
		<outputSlot value="uml_model_${slot}" />
	</component>

	<cartridge file="org/umlmda/oaw/generator/workflow/gwtModel.oaw">
	    <profile value="${profile.java}"/>
	    <slotPostfix value="${slot}"/>
	</cartridge>

	<!-- Generate gwt client side java code -->
	<cartridge file="org/umlmda/oaw/generator/workflow/gwtClientModel.oaw">
		<javaNoGenPath value="${javaNoGenPath.gwt}"/>
		<javaGenPath value="${javaGenPath.gwt}"/>
		<javaGenEntryPoint value="javaModel"/>
	    <profile value="${profile.gwt}"/>
	    <slotPostfix value="${slot}"/>
        <dateMapping value="${dateMapping.gwt}"/>
        <decimalMapping value="${decimalMapping.gwt}"/>
        <basedir value="${basedir}"/>
	</cartridge>
	
	<!-- Generate gwt client side java code -->
	<cartridge file="org/umlmda/oaw/generator/workflow/gwtServerModel.oaw">
		<javaNoGenPath value="${javaNoGenPath.java}"/>
		<javaGenPath value="${javaGenPath.java}"/>
		<javaGenEntryPoint value="javaModel"/>
	    <profile value="${profile.java}"/>
	    <slotPostfix value="${slot}"/>
        <dateMapping value="${dateMapping.java}"/>
        <decimalMapping value="${decimalMapping.java}"/>
        <basedir value="${basedir}"/>
	</cartridge>
	
</workflow>
