<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>

   <modelVersion>4.0.0</modelVersion>
   <parent>
      <artifactId>org.umlmda.runtime.releng</artifactId>
      <groupId>org.umlmda</groupId>
      <version>2.0.0-SNAPSHOT</version>
   </parent>
   <artifactId>org.umlmda.runtime.sdo.sync.test.pim</artifactId>
   <description></description>
   <packaging>pom</packaging>

   <properties>
      <version.oaw>4.2.0</version.oaw>
      <version.umlmda.common>3.1.0-SNAPSHOT</version.umlmda.common>
      <version.umlmda.oaw>3.1.1-SNAPSHOT</version.umlmda.oaw>
   </properties>

   <dependencies>
      <!-- oAW -->
      <dependency>
         <groupId>org.fornax.openarchitectureware</groupId>
         <artifactId>oaw-uml2</artifactId>
         <version>${version.oaw}</version>
         <type>pom</type>
      </dependency>
      <dependency>
         <groupId>org.openarchitectureware.adapter</groupId>
         <artifactId>adapter-rsdp</artifactId>
         <version>${version.oaw}</version>
      </dependency>

      <!-- UMLMDA -->
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.generator.model</artifactId>
         <version>${version.umlmda.common}</version>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.generator.profile</artifactId>
         <version>${version.umlmda.common}</version>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.generator.uml.psm</artifactId>
         <version>${version.umlmda.common}</version>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.model.profile</artifactId>
         <version>${version.umlmda.common}</version>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.umlmodel.uml2</artifactId>
         <version>${version.umlmda.common}</version>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.umlmodel</artifactId>
         <version>${version.umlmda.common}</version>
      </dependency>

      <!-- UMLMDA oAW -->
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.generator.uml.oaw</artifactId>
         <version>${version.umlmda.oaw}</version>
      </dependency>

      <!-- Apache stuff -->
      <dependency>
         <groupId>commons-lang</groupId>
         <artifactId>commons-lang</artifactId>
         <scope>runtime</scope>
      </dependency>
      <dependency>
         <groupId>oro</groupId>
         <artifactId>oro</artifactId>
         <version>2.0.8</version>
      </dependency>


   </dependencies>

   <build>
      <resources>
         <resource>
            <directory>src</directory>
         </resource>
      </resources>
      <plugins>
         <plugin>
            <artifactId>maven-clean-plugin</artifactId>
            <configuration>
               <filesets>
                  <fileset>
                     <directory>etc/umlmda/3rd</directory>
                  </fileset>
                  <fileset>
                     <directory>model/rsm/3rd</directory>
                  </fileset>
                  <fileset>
                     <directory>profiles/rsm/3rd</directory>
                  </fileset>
               </filesets>
            </configuration>
         </plugin>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
               <!-- Auspacken von UML Profilen, UMLMDA Generatorprofilen und -sets -->
               <execution>
                  <id>unpack</id>
                  <phase>initialize</phase>
                  <goals>
                     <goal>unpack</goal>
                  </goals>
                  <configuration>
                     <artifactItems>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.generator.profiles</artifactId>
                           <version>3.0.0-SNAPSHOT</version>
                           <type>zip</type>
                           <classifier>java-ump</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/etc/umlmda/3rd/profile</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.generator.profiles</artifactId>
                           <version>3.0.0-SNAPSHOT</version>
                           <type>zip</type>
                           <classifier>gwt-ump</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/etc/umlmda/3rd/profile</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>uml2_profile</artifactId>
                           <version>2.1.0</version>
                           <type>zip</type>
                           <overWrite>false</overWrite>
                           <outputDirectory>
                              ${basedir}/profiles/rsm/3rd/org.umlmda.uml2.profile_2.1.0.200801142220/profiles
                           </outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>com.ibm.xtools.uml.msl</groupId>
                           <artifactId>uml2_profiles</artifactId>
                           <version>7.1.200</version>
                           <type>zip</type>
                           <overWrite>false</overWrite>
                           <outputDirectory>
                              ${basedir}/profiles/rsm/3rd/ibm
                           </outputDirectory>
                        </artifactItem>
                     </artifactItems>
                     <overWriteReleases>false</overWriteReleases>
                     <overWriteSnapshots>true</overWriteSnapshots>
                  </configuration>
               </execution>
            </executions>
         </plugin>

         <plugin>
            <groupId>org.fornax.toolsupport</groupId>
            <artifactId>fornax-oaw-m2-plugin</artifactId>
            <version>2.0.0</version>
            <configuration>
               <defaultOawResourceDir>${basedir}/src/main/resources</defaultOawResourceDir>
               <properties>
                  <model.name>SyncTestModel.emx</model.name>
               </properties>
               <property file="${basedir}/src/main/resources/workflow.properties" />
            </configuration>
            <executions>
               <execution>
                  <id>run-oaw-workflow</id>
                  <phase>generate-sources</phase>
                  <goals>
                     <goal>run-workflow</goal>
                  </goals>
               </execution>
            </executions>
         </plugin>
      </plugins>
   </build>
</project>