<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

   <modelVersion>4.0.0</modelVersion>
   <parent>
      <groupId>org.umlmda</groupId>
      <artifactId>org.umlmda.releng</artifactId>
      <version>3.0.0-SNAPSHOT</version>
   </parent>
   <artifactId>org.umlmda.uml2.profiles</artifactId>
   <description></description>
   <packaging>pom</packaging>
   <version>2.2.0</version>
   
   <build>
      <plugins>
         <!-- Pack RSx/UML2 Profiles -->
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
               <execution>
                  <id>model2java</id>
                  <phase>package</phase>
                  <configuration>
                     <tasks>
                        <mkdir dir="${project.build.directory}"/>
                        <zip destfile="${project.build.directory}/umlmda-std-profiles.zip">
                           <fileset dir="${basedir}/profiles">
                              <include name="UMLMDAProfile.epx"/>
                              <include name="UMLMDATypes.emx"/>
                           </fileset>
                        </zip>
                        <zip destfile="${project.build.directory}/umlmda-sdo-profiles.zip">
                           <fileset dir="${basedir}/profiles">
                              <include name="UMLMDASDOProfile.epx"/>
                           </fileset>
                        </zip>
                     </tasks>
                  </configuration>
                  <goals>
                     <goal>run</goal>
                  </goals>
               </execution>
            </executions>
         </plugin>
                  
         <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
               <execution>
                  <id>attach-artifacts</id>
                  <phase>package</phase>
                  <goals>
                     <goal>attach-artifact</goal>
                  </goals>
                  <configuration>
                     <artifacts>
                        <artifact>
                           <file>
                              ${project.build.directory}/umlmda-std-profiles.zip
                           </file>
                           <type>zip</type>
                           <classifier>std</classifier>
                        </artifact>
                        <artifact>
                           <file>
                              ${project.build.directory}/umlmda-sdo-profiles.zip
                           </file>
                           <type>zip</type>
                           <classifier>sdo</classifier>
                        </artifact>
                     </artifacts>
                  </configuration>
               </execution>
            </executions>
         </plugin>
      </plugins>
   </build>

</project>