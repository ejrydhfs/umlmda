  <packagedElement xmi:type="uml:Stereotype" xmi:id="_-NUFkMLMEd2dvJAjhl6k2g" name="Bitemporal">
    <eAnnotations xmi:id="_FZsXVMLOEd2dvJAjhl6k2g" source="uml2.extensions">
