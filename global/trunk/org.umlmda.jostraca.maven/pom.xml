<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
   <parent>
      <groupId>org.umlmda</groupId>
      <artifactId>org.umlmda.releng</artifactId>
      <version>3.3.0</version>
   </parent>
   <modelVersion>4.0.0</modelVersion>
   <groupId>org.umlmda</groupId>
   <artifactId>org.umlmda.jostraca.maven</artifactId>
   <packaging>maven-plugin</packaging>
   <name>UMLMDA jostraca maven plugin</name>
   <version>3.1-SNAPSHOT</version>
   <url>http://maven.apache.org</url>
   <dependencies>
      <dependency>
         <groupId>org.apache.maven</groupId>
         <artifactId>maven-plugin-api</artifactId>
         <version>2.0</version>
      </dependency>
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.jostraca</artifactId>
         <version>0.3.3</version>
      </dependency>
      <dependency>
         <groupId>log4j</groupId>
         <artifactId>log4j</artifactId>
         <version>1.2.14</version>
         <scope>test</scope>
      </dependency>
   </dependencies>
   
   <scm>
      <connection>scm:svn:https://umlmda.svn.sourceforge.net/svnroot/umlmda/global/trunk/org.umlmda.jostraca.maven</connection>
      <developerConnection>scm:svn:https://umlmda.svn.sourceforge.net/svnroot/umlmda/global/trunk/org.umlmda.jostraca.maven</developerConnection>
   </scm>
   
   <build>
      <plugins>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
               <!-- Unpack jostraca configuration -->
               <execution>
                  <id>unpack</id>
                  <phase>process-test-resources</phase>
                  <goals>
                     <goal>unpack</goal>
                  </goals>
                  <configuration>
                     <artifactItems>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.jostraca</artifactId>
                           <version>${jostraca.version}</version>
                           <type>zip</type>
                           <classifier>conf</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/etc/jostraca</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.jostraca</artifactId>
                           <version>${jostraca.version}</version>
                           <type>zip</type>
                           <classifier>format</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/etc/jostraca</outputDirectory>
                        </artifactItem>
                     </artifactItems>
                     <overWriteReleases>false</overWriteReleases>
                     <overWriteSnapshots>true</overWriteSnapshots>
                  </configuration>
               </execution>
            </executions>
         </plugin>
      </plugins>
   </build>

   <repositories>
      <repository>
         <id>artifactory</id>
         <url>http://coding.ds2k.de/artifactory/repo</url>
         <releases>
            <enabled>true</enabled>
         </releases>
         <snapshots>
            <enabled>true</enabled>
         </snapshots>
      </repository>
      <repository>
         <id>cor-artifactory</id>
         <url>http://cor-health-dev1/artifactory/repo</url>
         <releases>
            <enabled>true</enabled>
         </releases>
         <snapshots>
            <enabled>true</enabled>
         </snapshots>
      </repository>
   </repositories>

</project>