      </eAnnotations>
    </generalization>
  </packagedElement>
  <packagedElement xmi:type="uml:Stereotype" xmi:id="_eWEKsMLNEd2dvJAjhl6k2g" name="Temporal">
    <eAnnotations xmi:id="_FZsXWMLOEd2dvJAjhl6k2g" source="uml2.extensions">
      <details xmi:id="_FZsXWcLOEd2dvJAjhl6k2g" key="addedInVersion" value="1"/>
