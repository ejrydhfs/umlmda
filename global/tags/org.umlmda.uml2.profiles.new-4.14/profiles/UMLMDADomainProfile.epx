  <packagedElement xmi:type="uml:Stereotype" xmi:id="_f8HnkMRDEd28n7ofFGqNfw" name="ValueObject">
    <eAnnotations xmi:id="_nGUkeMRDEd28n7ofFGqNfw" source="uml2.extensions">
