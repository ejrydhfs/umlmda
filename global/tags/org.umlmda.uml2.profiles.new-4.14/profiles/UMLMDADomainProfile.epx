    <ownedComment xmi:id="_VfxZ4MUGEd28n7ofFGqNfw" annotatedElement="_f8HnkMRDEd28n7ofFGqNfw">
      <eAnnotations xmi:id="_5fV_usUGEd28n7ofFGqNfw" source="uml2.extensions">
        <details xmi:id="_5fV_u8UGEd28n7ofFGqNfw" key="addedInVersion" value="7"/>
      </eAnnotations>
      <body>&lt;HTML>&lt;HEAD>&#xD;
&lt;META content=&quot;MSHTML 6.00.2900.3199&quot; name=GENERATOR>&lt;/HEAD>&#xD;
&lt;BODY>A value object is a domain class with has no identity. Usualy value classes should be modelled immutable to be shared.&lt;/BODY>&lt;/HTML></body>
