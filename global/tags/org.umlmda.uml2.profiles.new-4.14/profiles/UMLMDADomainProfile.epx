    <ownedComment xmi:id="_FcotcMUGEd28n7ofFGqNfw" annotatedElement="_1OpmgMRCEd28n7ofFGqNfw">
      <eAnnotations xmi:id="_5fV_tsUGEd28n7ofFGqNfw" source="uml2.extensions">
