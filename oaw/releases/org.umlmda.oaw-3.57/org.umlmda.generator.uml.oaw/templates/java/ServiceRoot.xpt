«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::uml::generator»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::oaw::generator::model::java»

«DEFINE Root FOR JavaModel»
    «REM» Define standard service artifacts«ENDREM»
    «ERROR "Root called on <<Model>> "+name»
    «EXPAND java::Root::initArtefacts FOR this»
	«EXPAND Root FOREACH this.packages.typeSelect(ModelPackage)»
«ENDDEFINE»

«DEFINE Root FOR JavaBusinessException»
   «EXPAND java::Root::Root FOR this»
«ENDDEFINE»

«DEFINE Root FOR JavaBusinessObject»
   «EXPAND java::Root::Root FOR this»
«ENDDEFINE»

«DEFINE Root FOR JavaBusinessService»
   «EXPAND java::Root::Root FOR this»
«ENDDEFINE»

«DEFINE Root FOR JavaEnumeration»
   «EXPAND java::Root::Root FOR this»
«ENDDEFINE»

«DEFINE Root FOR JavaBusinessComponent»
	«EXPAND Root FOREACH classes.typeSelect(ModelClass)»
   «EXPAND JavaArtefact FOR this»
«ENDDEFINE»

«DEFINE JavaArtefact FOR JavaBusinessComponent»
   «EXPAND java::Root::JavaArtefact FOR this»
   «EXPAND java::ConstraintIteration::Root FOR this»
   «EXPAND java::VisitableIterator::Root FOR this»
«ENDDEFINE»

«DEFINE Root FOR JavaModelPackage»
   «ERROR "Root called on <<Package>> "+name»
   «EXPAND Root FOREACH classes.typeSelect(ModelClass)»
«ENDDEFINE»

«DEFINE Root FOR ModelElement»
	«ERROR "Root should not be called on <<Object>>: "+name+" ("+metaType+")"»
«ENDDEFINE»
