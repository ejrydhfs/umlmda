«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::uml::generator::j2ee»
«IMPORT org::umlmda::oaw::generator::util»
«IMPORT org::umlmda::oaw::generator::model::j2ee»
«EXTENSION java::UMLMDA»

«DEFINE IbmEjbJarBndXmi FOR J2EEBusinessComponent»
«LET generatedName(this, "j2ee.IbmEjbJarBndXmi") AS interfaceName»
«FILE generatedPath+"META-INF/ibm-ejb-jar-bnd.xmi"»<?xml version="1.0" encoding="ISO-8859-1"?>

<ejbbnd:EJBJarBinding xmi:version="2.0"
	xmlns:xmi="http://www.omg.org/XMI"
	xmlns:ejbbnd="ejbbnd.xmi"
	xmlns:ejb="ejb.xmi"
	xmlns:commonbnd="commonbnd.xmi"
	xmlns:common="common.xmi"
	xmi:id="EJBJarBinding_1">
	<ejbJar href="META-INF/ejb-jar.xml#ejb-jar_ID"/>

	<!-- Session Beans -->
	«FOREACH businessServices.typeSelect(J2EEBusinessService) AS businessService»
		«EXPAND sessionBeanDecl FOR businessService»
	«ENDFOREACH»      

	<!-- UserSection-Begin enterprise-beans -->
	<!-- UserSection-End enterprise-beans -->
   
</ejbbnd:EJBJarBinding>
«ENDFILE»
«ENDLET»
«ENDDEFINE»

«DEFINE sessionBeanDecl FOR J2EEBusinessService»
	<ejbBindings xmi:id="«name»" jndiName="«jndiName»">
		<enterpriseBean xmi:type="ejb:Session" href="META-INF/ejb-jar.xml#«name»"/>		
	</ejbBindings>
«ENDDEFINE»