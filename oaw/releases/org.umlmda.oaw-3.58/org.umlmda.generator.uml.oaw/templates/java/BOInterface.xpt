«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::oaw::generator::model::java»
«IMPORT org::umlmda::oaw::generator::util»
«IMPORT org::umlmda::oaw::generator::model::java»

«EXTENSION java::UMLMDA»
«EXTENSION java::JmiReflect»
«EXTENSION org::umlmda::uml::java::Artefact»
«EXTENSION org::umlmda::uml::java::Attribute»
«EXTENSION org::umlmda::uml::java::DataType»
«EXTENSION org::umlmda::uml::java::ModelClass»
«EXTENSION org::umlmda::uml::java::Parameter»

«DEFINE BOInterface FOR JavaModelClass»
	«LET generatedName(this, getDefaultArtefact()) AS interfaceName»
	«this.resetImports()»
	«IF superClass != null»
		«this.registerImport(superClass.getDefaultArtefact(), (JavaModelClass)superClass)»
	«ENDIF»
	«this.registerImports(getDefaultArtefact("BusinessObject"), referencedTypes, "BusinessObject")»
	«this.registerImports(getDefaultArtefact("BusinessException"), referencedTypes, "BusinessException")»
	«this.registerImports(getDefaultArtefact("Enumeration"), referencedTypes, "Enumeration")»
	«FILE generatedPath+"/"+interfaceName+".java"»
		package «generatorPackage.getQualifiedPackageName(getDefaultArtefact())»;
		
		«EXPAND standardImports»
		«this.registeredImports()»
		
		/**
		 * «documentation»
		 */
		«EXPAND interfaceDecl(interfaceName)» 
		{
			«EXPAND keyDecl»
			
         «EXPAND constantDecl(true) FOREACH constants.typeSelect(JavaModelAttribute).select( a | a.initialValue!=null )»
			
			«EXPAND propertyNameConstantDecl(true) FOREACH javaAttributes()»
			«EXPAND propertyNameConstantDecl(true) FOREACH associations.typeSelect(JavaModelAssociation)»
	
			«EXPAND handleAttributes»
			«EXPAND handleAssociations»		
			
			«EXPAND handleMethod(true) FOREACH methods.typeSelect(JavaModelMethod)»
		}
	«ENDFILE»
   «EXPAND jeeInterfaces(interfaceName)»
	«ENDLET»
«ENDDEFINE»

«DEFINE jeeInterfaces(String interfaceName) FOR JavaModelClass»
«ENDDEFINE»

«DEFINE jeeInterfaces(String interfaceName) FOR JavaBusinessService»
	«FILE generatedPath+"/"+interfaceName+"Local.java"»
	   package «generatorPackage.getQualifiedPackageName(getDefaultArtefact())»;
	   
	   /** 
	    * Local jee interface
	    */
	   @javax.ejb.Local
	   public interface «interfaceName»Local extends «interfaceName» {
	   }
	«ENDFILE»
   «FILE generatedPath+"/"+interfaceName+"Remote.java"»
      package «generatorPackage.getQualifiedPackageName(getDefaultArtefact())»;
      
	   /** 
	    * Local jee interface
	    */
	   @javax.ejb.Remote
	   public interface «interfaceName»Remote extends «interfaceName» {
	      
	     /**
	      * The name in the global jndi of the remote ejb
	      */ 
	     public final String JNDI_NAME = "«component.getStereotypeProperty("EJBComponent")»«name»";
	   }
   «ENDFILE»   
«ENDDEFINE»

«DEFINE interfaceDecl(String interfaceName) FOR JavaModelClass»
	public interface «interfaceName» «EXPAND extendsDecl»
«ENDDEFINE»

«DEFINE interfaceDecl(String interfaceName) FOR JavaBusinessService»
	public interface «interfaceName» «EXPAND extendsDecl»
«ENDDEFINE»

«DEFINE standardImports FOR JavaModelClass»
«ENDDEFINE»


«DEFINE handleAttributes FOR JavaModelClass»
	«FOREACH javaAttributes() AS attr»
		«EXPAND handleAttribute(true) FOR attr»
	«ENDFOREACH»
«ENDDEFINE»

«DEFINE handleAttribute(Boolean forInterface) FOR JavaModelAttribute»
   «EXPAND attrGetterDecl(forInterface)»;
   «EXPAND attrSetterDecl(forInterface)»;
«ENDDEFINE»
«DEFINE handleAttribute FOR JavaModelAttribute»
	«EXPAND handleAttribute(false)»
«ENDDEFINE»


«DEFINE handleMethod(Boolean forInterface) FOR JavaModelMethod»
	«EXPAND methodDecl(forInterface)»;
«ENDDEFINE»
«DEFINE handleMethod FOR JavaModelMethod»
   «EXPAND handleMethod(false)»
«ENDDEFINE»


«DEFINE handleAssociations FOR JavaModelClass»
	«FOREACH associations.typeSelect(JavaModelAssociation) AS assoc»
		«EXPAND handleAssociation(true) FOR assoc»
	«ENDFOREACH»
«ENDDEFINE»

«DEFINE handleAssociation(Boolean forInterface) FOR JavaModelAssociation»
	«EXPAND assocGetterDecl(forInterface)»;
	«EXPAND assocSetterDecl(forInterface)»;
«ENDDEFINE»
«DEFINE handleAssociation FOR JavaModelAssociation»
   «EXPAND handleAssociation(false)»
«ENDDEFINE»


// Superclasses
«DEFINE extendsDecl FOR JavaBusinessObject»
	extends
	«IF javaExtentedInterfaces().size > 0» 
		«FOREACH javaExtentedInterfaces() AS superClass SEPARATOR ","»
			«this.getScopedName(superClass.getDefaultArtefact(scopeInterface()), superClass)»
		«ENDFOREACH»
	«ELSE»
		«EXPAND standardBaseInterface»
	«ENDIF»
«ENDDEFINE»

«DEFINE extendsDecl FOR JavaModelClass»
	«IF javaExtentedInterfaces().size > 0» 
		extends
		«FOREACH javaExtentedInterfaces() AS superClass SEPARATOR ","»
			«IF superClass.hasStereotype("NativeClass") == false»
				«this.getScopedName(getDefaultArtefact(this), superClass)»
			«ENDIF»
		«ENDFOREACH»
	«ENDIF»
«ENDDEFINE»

«DEFINE standardBaseInterface FOR JavaBusinessObject»
	org.umlmda.runtime.model.ModeledElement, «EXPAND propertyChangeBaseInterface»
«ENDDEFINE»

«DEFINE propertyChangeBaseInterface FOR JavaBusinessObject»
	org.umlmda.runtime.bean.IPropertyChangeSupport
«ENDDEFINE»


«REM» Parameter defines if the constant is generated for an interface (true) or a class (false) «ENDREM»
«DEFINE constantDecl(Boolean forInterface) FOR JavaModelAttribute»
   /**
   * Constant «name»«IF documentation!=null && documentation.length>0», «documentation»«ENDIF»
   */
   «IF ! forInterface»public static final «ENDIF»«javaTypeName()» «name» = «IF javaType=="String"»"«ENDIF»«initialValue»«IF javaType=="String"»"«ENDIF»;
«ENDDEFINE»
«REM» Kept for compatibility reasons. «ENDREM»
«DEFINE constantDecl FOR JavaModelAttribute»
   «EXPAND constantDecl(false)»
«ENDDEFINE»


«DEFINE attrGetterDecl FOR JavaModelAttribute»
	«EXPAND attrGetterDecl(false, "")»
«ENDDEFINE»
«DEFINE attrGetterDecl(Boolean forInterface) FOR JavaModelAttribute»
   «EXPAND attrGetterDecl(forInterface, "")»
«ENDDEFINE»
«DEFINE attrGetterDecl(String context) FOR JavaModelAttribute»
   «EXPAND attrGetterDecl(false, context)»
«ENDDEFINE»
«DEFINE attrGetterDecl(Boolean forInterface, String context) FOR JavaModelAttribute»
   /**
   * Get«context» «name»«IF getDocumentation("GETTER").length>0», «getDocumentation("GETTER")»«ENDIF»
   */
   «IF !forInterface»public«ENDIF» «javaTypeName()» «getter»()
«ENDDEFINE»


«DEFINE attrSetterDecl FOR JavaModelAttribute»
	«EXPAND attrSetterDecl(false, "")»
«ENDDEFINE»
«DEFINE attrSetterDecl(Boolean forInterface) FOR JavaModelAttribute»
   «EXPAND attrSetterDecl(forInterface, "")»
«ENDDEFINE»
«DEFINE attrSetterDecl(String context) FOR JavaModelAttribute»
   «EXPAND attrSetterDecl(false, context)»
«ENDDEFINE»
«DEFINE attrSetterDecl(Boolean forInterface, String context) FOR JavaModelAttribute»
«IF readOnly == false»
  /**
   * Set«context» «name»«IF getDocumentation("SETTER").length>0», «getDocumentation("SETTER")»«ENDIF»
   */
   «IF !forInterface»public«ENDIF» void «setter»(«javaTypeName()» «name»)
«ENDIF»
«ENDDEFINE»


«DEFINE assocGetterDecl FOR JavaModelAssociation»
   «EXPAND assocGetterDecl(false)»
«ENDDEFINE»
«DEFINE assocGetterDecl(Boolean forInterface) FOR JavaModelAssociation»
   /**
    * «getDocumentation("GETTER")»
    */
   «IF !forInterface»public«ENDIF» «interfaceType» «getter»()
«ENDDEFINE»


«DEFINE assocSetterDecl FOR JavaModelAssociation»
   «EXPAND assocSetterDecl(false)»
«ENDDEFINE»
«DEFINE assocSetterDecl(Boolean forInterface) FOR JavaModelAssociation»
«IF readOnly == false»
	/**
	 * «getDocumentation("SETTER")»
	 *
	 * @param «name»
	 *		New value for assocation «name» 
	 */
   «IF !forInterface»public«ENDIF» void «setter»(«interfaceType» «name»)
«ENDIF»
«ENDDEFINE»


«DEFINE methodDecl FOR JavaModelMethod»
    «EXPAND methodDecl(false)»
«ENDDEFINE»
«DEFINE methodDecl(Boolean forInterface) FOR JavaModelMethod»
   /**
    * «documentation»
    */
    «IF forInterface»«EXPAND methodDecl("")»«ELSE»«EXPAND methodDecl("public")»«ENDIF»
«ENDDEFINE»


«DEFINE methodDecl(String modifier) FOR JavaModelMethod»
   «modifier» «javaType» «name»(
	«FOREACH parameters.typeSelect(JavaModelParameter) AS parameter SEPARATOR "," »
	    «parameter.javaTypeName()» «parameter.name»
	«ENDFOREACH»   
   )
   «IF exceptions.size > 0»
   		throws 
   		«FOREACH exceptions.typeSelect(JavaModelClass) AS e SEPARATOR  "," »
   			«((JavaModelClass)owner).getScopedName("java.BusinessException", e)»
   		«ENDFOREACH»
   «ENDIF»
«ENDDEFINE»


«DEFINE keyDecl FOR JavaModelClass»
	«IF this.owningAPKey»
	   «EXPAND keyInterfaceDecl»
	«ENDIF»
«ENDDEFINE»


«DEFINE keyInterfaceDecl FOR JavaModelClass»
    public interface PKey extends java.io.Serializable {
        «FOREACH keyAttributes.typeSelect(JavaModelAttribute) AS keyAttr»
            «EXPAND attrGetterDecl(true, " key attribute") FOR keyAttr»;
            «EXPAND attrSetterDecl(true, " key attribute") FOR keyAttr»;
        «ENDFOREACH»   
    }
    
    «FOREACH inheritedKeyAttributes.typeSelect(JavaModelAttribute) AS keyAttr»
        «EXPAND attrGetterDecl(true, " parent key attribute") FOR keyAttr»;
    «ENDFOREACH»
    
    /**
     * Getter for the primaryKey
     */   
    public PKey get«name»Pkey();
       
    /**
     * Setter for the primaryKey
     */   
    public void set«name»Pkey(PKey pkey);
«ENDDEFINE»


«REM» Parameter defines if the constant is generated for an interface (true) or a class (false) «ENDREM»
«DEFINE propertyNameConstantDecl(Boolean forInterface) FOR JavaModelStructuraleFeature»
   «IF !forInterface»public static final «ENDIF»String «EXPAND java::BOInterface::propertyNameConstant» = "«name»";
«ENDDEFINE»»
«REM» Kept for compatibility reasons. «ENDREM»
«DEFINE propertyNameConstantDecl FOR JavaModelStructuraleFeature»
   «EXPAND java::BOInterface::propertyNameConstantDecl(false)»
«ENDDEFINE»»


«DEFINE propertyNameConstant FOR JavaModelStructuraleFeature»
	PROPERTY_«upperCaseIdentifier»
«ENDDEFINE»

