«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::oaw::generator::model::java»
«IMPORT org::umlmda::oaw::generator::util»
«IMPORT org::umlmda::oaw::generator::model::java»

«EXTENSION java::UMLMDA»
«EXTENSION org::umlmda::uml::java::Artefact»
«EXTENSION org::umlmda::uml::java::Attribute»
«EXTENSION org::umlmda::uml::java::DataType»
«EXTENSION org::umlmda::uml::java::ModelClass»
«EXTENSION org::umlmda::uml::java::Parameter»

«DEFINE Root FOR JavaBusinessService»
	«EXPAND ServiceInterface(getDefaultArtefact("BusinessObject")) FOR this»
	«EXPAND AsyncServiceInterface("gwt.AsyncServiceInterface") FOR this»
«ENDDEFINE»

«DEFINE ServiceInterface(String artefact) FOR JavaBusinessService»
	«LET generatedName(this, artefact) AS interfaceName»
	«EXPAND registerStandardImports(artefact) FOR this»
	«FILE generatedPath+"/"+interfaceName+".java"»
		package «generatorPackage.getQualifiedPackageName(artefact)»;
		
		import com.google.gwt.core.client.GWT;
		import com.google.gwt.user.client.rpc.RemoteService;
		import com.google.gwt.user.client.rpc.ServiceDefTarget;

		«this.registeredImports()»
		
		/**
		 * «documentation»
		 */
		public interface «interfaceName» «EXPAND java::BOInterface::extendsDecl FOR this»
		{
			/**
			 * Utility class for simplifying access to the instance of async service.
			 */
			public static class Util {
				private static «getScopedName("gwt.AsyncServiceInterface")» instance;
				public static «getScopedName("gwt.AsyncServiceInterface")» getInstance(){
					if (instance == null) {
						instance = («getScopedName("gwt.AsyncServiceInterface")») GWT.create(«getScopedName("gwt.ServiceInterface")».class);
						ServiceDefTarget target = (ServiceDefTarget) instance;
						target.setServiceEntryPoint(GWT.getModuleBaseURL() + "«name»");
					}
					return instance;
				}
			}

		«FOREACH methods.typeSelect(JavaModelMethod) AS method»
			«EXPAND java::BOInterface::methodDecl FOR method»;
		«ENDFOREACH»
		}
	«ENDFILE»
	«ENDLET»
«ENDDEFINE»

«DEFINE AsyncServiceInterface(String artefact) FOR JavaBusinessService»
	«LET generatedName(this, artefact) AS interfaceName»
	«EXPAND registerStandardImports(artefact) FOR this»
	«FILE generatedPath+"/"+interfaceName+".java"»
		package «generatorPackage.getQualifiedPackageName(artefact)»;
		
		import com.google.gwt.user.client.rpc.AsyncCallback;

		«this.registeredImports()»
		
		/**
		 * «documentation»
		 */
		public interface «interfaceName» «EXPAND java::BOInterface::extendsDecl FOR this»
		{

		«FOREACH methods.typeSelect(JavaModelMethod) AS method»
			«EXPAND asyncMethodDecl FOR method»;
		«ENDFOREACH»
		}
	«ENDFILE»
	«ENDLET»
«ENDDEFINE»

«DEFINE registerStandardImports(String artefact) FOR JavaBusinessService»
	«this.resetImports()»
	«IF superClass != null»
		«this.registerImport(artefact, (JavaModelClass)superClass)»
	«ENDIF»
	«this.registerImports(getDefaultArtefact("BusinessObject"), referencedTypes, "BusinessObject")»
	«this.registerImports(getDefaultArtefact("BusinessException"), referencedTypes, "BusinessException")»
	«this.registerImports(getDefaultArtefact("Enumeration"), referencedTypes, "Enumeration")»
«ENDDEFINE»

«DEFINE asyncMethodDecl FOR JavaModelMethod»
   /**
    * «documentation»
    */
   public void «name»(
	«FOREACH parameters.typeSelect(JavaModelParameter) AS parameter SEPARATOR "," »
	    «parameter.javaTypeName()» «parameter.name»
	«ENDFOREACH»
	«IF parameters.size > 0»
		,
	«ENDIF»
	AsyncCallback callback   
   )
«ENDDEFINE»