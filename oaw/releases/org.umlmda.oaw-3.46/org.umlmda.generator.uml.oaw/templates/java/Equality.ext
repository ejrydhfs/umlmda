/**
 * Standard Xtend Library for UML2 base generation on domain models. Extensions for ModelClass
 */
import java::util;
import org::umlmda::generator::model::uml;
import org::umlmda::profile;
import org::umlmda::model::uml;
import org::umlmda::uml::generator;
import org::umlmda::uml::generator::java;
import org::umlmda::oaw::generator::util;
import org::umlmda::oaw::generator::model::java;

cached List[JavaModelStructuraleFeature] features(JavaModelClass class) :
    let features = {} :
    
    features.addAll(class.implementedAttributes.typeSelect(JavaModelAttribute).select(e|e.derived == false && e.hasStereotype("Id") == false)) ->
    features.addAll(class.implementedAssociations.typeSelect(JavaModelAssociation).select(e|e.derived == false && e.composition == false)) ->
    features
;    