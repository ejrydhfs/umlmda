«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::uml::generator»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::oaw::generator::util»
«IMPORT org::umlmda::oaw::generator::model::java»

«EXTENSION jee::Method»
«EXTENSION java::UMLMDA»
«EXTENSION java::NamingConventions»
«EXTENSION org::umlmda::uml::java::Artefact»
«EXTENSION org::umlmda::uml::java::Attribute»
«EXTENSION org::umlmda::uml::java::Association»
«EXTENSION org::umlmda::uml::java::DataType»
«EXTENSION org::umlmda::uml::java::ModelClass»
«EXTENSION org::umlmda::uml::java::StructuralFeature»

«DEFINE AbstractBeanContract FOR JavaBusinessService»
   «LET generatedName(this, "jee.AbstractBeanContract") AS className»
   «this.resetImports()»
   «this.registerImport("java.BusinessServiceInterface")»
   «FILE generatedPath+"/"+className+".java"»
   
   package «generatorPackage.getQualifiedPackageName("jee.AbstractBeanContract")»;
         
   «this.registeredImports()»
   
   public abstract class «generatedName» implements «getScopedName("java.BusinessServiceInterface")» {
   
   «FOREACH methods.typeSelect(JavaModelMethod) AS method»
      /**
       * «method.documentation»
       */
      «method.ejbTransactionAnnotation()» 
      «EXPAND java::BOInterface::methodDecl("public abstract") FOR method»;
   «ENDFOREACH»
   }
   «ENDFILE»
   «ENDLET»
«ENDDEFINE»