			«EXPAND BOFactory::createBODecl FOR bo»
			«EXPAND createBOBody FOR bo»
		«ENDIF»
	«ENDFOREACH»
	
	«EXPAND additionalMethods FOR this»
}
«ENDFILE»
«ENDLET»
«ENDDEFINE»

«DEFINE standardImports FOR JavaBusinessComponent»
