«ENDFOREACH»
«this.registerImport("java.BusinessObjectFactory")»
«this.registeredImports()»

/**
 * Business object factory implementation for «qualifiedName». «documentation»
 */
public class «className» «EXPAND standardImplementsDecl FOR this»
{
	«EXPAND standardCtor FOR this»
	
	«FOREACH businessObjects.typeSelect(JavaBusinessObject) AS bo»
