«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::uml::generator::j2ee»
«IMPORT org::umlmda::oaw::generator::util»
«IMPORT org::umlmda::oaw::generator::model::java»
«IMPORT org::umlmda::oaw::generator::model::j2ee»
«EXTENSION java::UMLMDA»

«DEFINE EjbJarXml FOR J2EEBusinessComponent»
«LET generatedName(this, "j2ee.EjbJarXml") AS interfaceName»
«FILE generatedPath+"META-INF/ejb-jar.xml"»<?xml version="1.0" encoding="ISO-8859-1"?>
<!-- Generated file, please edit UserSections only -->
<ejb-jar id="ejb-jar_ID" 
         version="2.1" xmlns="http://java.sun.com/xml/ns/j2ee" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/ejb-jar_2_1.xsd">

   <description>Sessionbeans for services from model </description>
<!-- UserSection-Begin display-name -->
   <display-name>Generated by UMLMDA</display-name>
<!-- UserSection-End display-name -->

   <enterprise-beans>

      <!-- Session Beans -->
«FOREACH businessServices.typeSelect(J2EEBusinessService) AS businessService»
	«EXPAND sessionBeanDecl FOR businessService»
«ENDFOREACH»      

<!-- UserSection-Begin enterprise-beans -->
<!-- UserSection-End enterprise-beans -->
   </enterprise-beans>
   
   <!-- Assembly Descriptor -->
   <assembly-descriptor >
<!-- UserSection-Begin assembly-descriptor-security -->   
<!-- UserSection-End assembly-descriptor-security -->

     <!-- transactions -->
     «FOREACH transactionTypes.typeSelect(String) AS transactionType»
     
     	<!-- «transactionType» -->
     	<container-transaction>
     	«FOREACH businessServices.typeSelect(J2EEBusinessService) AS businessService»
     		«FOREACH getMethods(businessService, transactionType).typeSelect(JavaModelMethod) AS method»
     			«EXPAND methodDecl FOR method»
     		«ENDFOREACH»
     	«ENDFOREACH»
     		<trans-attribute>«transactionType»</trans-attribute>
     	</container-transaction>
     «ENDFOREACH»
<!-- UserSection-Begin assembly-descriptor -->
<!-- UserSection-End assembly-descriptor -->
   </assembly-descriptor>
   
</ejb-jar>
«ENDFILE»
«ENDLET»
«ENDDEFINE»

«DEFINE sessionBeanDecl FOR J2EEBusinessService»
	<session id="«name»">
    	<description><![CDATA[
			]]>
		</description>

		<ejb-name>«name»</ejb-name>
		<home>«getQualifiedName("j2ee.HomeInterface")»</home>
		<remote>«getQualifiedName("j2ee.RemoteInterface")»</remote>
		<local-home>«getQualifiedName("j2ee.LocalHomeInterface")»</local-home>
		<local>«getQualifiedName("j2ee.LocalInterface")»</local>
		<ejb-class>«getQualifiedName("j2ee.SessionBean")»</ejb-class>
		<session-type>Stateless</session-type>
		<transaction-type>Container</transaction-type>
<!-- UserSection-Begin «name» -->
<!-- UserSection-End «name» -->
	</session>
«ENDDEFINE»

«DEFINE methodDecl FOR JavaModelMethod»
	<method>
		<ejb-name>«owner.name»</ejb-name>
		<method-intf>Remote</method-intf>
		<method-name>«name»</method-name>
		«IF parameters.size > 0»
			<method-params>
			«FOREACH parameters.typeSelect(JavaModelParameter) AS parameter»
				<method-param>«parameter.javaType»</method-param>
			«ENDFOREACH»
			</method-params>
         «ENDIF»
	</method>
«ENDDEFINE»
