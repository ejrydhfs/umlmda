«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::uml::generator»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::oaw::generator::util»
«IMPORT org::umlmda::oaw::generator::model::java»

«EXTENSION java::UMLMDA»
«EXTENSION java::NamingConventions»
«EXTENSION java::Visitor»
«EXTENSION org::umlmda::uml::java::Sdo»

«DEFINE Root FOR JavaBusinessComponent»
«LET generatedName(this, "java.ConstraintIteration") AS className»
«FILE generatedPath+"/"+className+".java"»
package «getQualifiedPackageName("java.ConstraintVisitor")»;

import org.umlmda.runtime.constraint.ConstraintVisitorContext;
import org.umlmda.runtime.visitor.AbstractVisitableIteration;
import org.umlmda.runtime.visitor.VisitableIterator;

«resetImports()»
«registerImport("java.VisitableIterator")»
«FOREACH referencedPackages.typeSelect(JavaBusinessComponent) AS refPackage»
   «registerImport("java.ConstraintVisitor", refPackage)»
«ENDFOREACH»
«registerImport("java.ConstraintVisitor")»
«registeredImports()»

/**
 * Constraint visitor for the business objects of «qualifiedName» 
 */
public class «generatedName» extends AbstractVisitableIteration {

   /**
    * Ctor to start the constraint check.
    * @param object Startpoint of the iteration
    */
   public «generatedName»(Object object) {
      this(new «getScopedName("java.VisitableIterator")»(object));
   }

   /**
    * Ctor to continue the constraint check in a child element of the start point.
    * Usually used only internal.
    * @param iterator Iterator for the child element
    */
   public «generatedName»(VisitableIterator iterator) {
      super(iterator, new ConstraintVisitorContext());
    
«FOREACH referencedPackages.typeSelect(JavaBusinessComponent) AS refPackage»
      registerVisitor(new «getScopedName("java.ConstraintVisitor", refPackage)»());
«ENDFOREACH»
      registerVisitor(new «getScopedName("java.ConstraintVisitor")»());
   }
}
«ENDFILE»
«ENDLET»
«ENDDEFINE»
