//@@Generated file, please edit UserSections only
//@@UserSection-Begin RCSHeader
<%=RcsHelper.writeHeader("// ")%>
//@@UserSection-End RCSHeader
<% @conf 
main.JostracaVersion       = 0.3
main.CodeWriter            = IDLWriter
main.CodeWriterFormat	   = format\\ParentJavaWriterFormat.jwf
java.CodeWriter.package    = org.umlmda.uml.generator.idl.writer
java.CodeWriter.extends    = org.umlmda.uml.generator.idl.AbstractIDLWriter
%>
<% import!
import org.umlmda.generator.model.util.RcsHelper;
import org.umlmda.model.uml.*;
import org.umlmda.generator.model.uml.*;
import java.util.Iterator;
// ==== End of generation header ===============================================
%>
<% @section declare %><%
%><% @section %>

<% for ( Iterator iter = getReferencedPackages().iterator(); iter.hasNext(); ) {
      ModelPackage modelpackage = (ModelPackage)iter.next();
%>#include <<%=modelpackage.getName()%>.idl>
<% }
%><%= beginUserSection("Includes", COMMON) %>
<%= endUserSection("Includes", COMMON) %>

module <%=getModuleName()%> {

<% // CORBA-Exceptions
   for ( Iterator ia = getModelPackage().getClasses().iterator(); ia.hasNext(); ) {
	   ModelClass modelClass = (ModelClass)ia.next();

     if ( modelClass.hasStereotype("BusinessException") ) {
     		runWriter((GeneratorClass)modelClass);
     }
   }  

   // CORBA-Structures
   for ( Iterator ia = getModelPackage().getClasses().iterator(); ia.hasNext(); ) {
	   ModelClass modelClass = (ModelClass)ia.next();

     if ( modelClass.hasStereotype("BusinessObject") ) {
     		runWriter((GeneratorClass)modelClass);
     }
   }  

   // CORBA-Interfaces
   for ( Iterator ia = getModelPackage().getClasses().iterator(); ia.hasNext(); ) {
	   ModelClass modelClass = (ModelClass)ia.next();

     if ( modelClass.hasStereotype("BusinessService") ) {
     		runWriter((GeneratorClass)modelClass);
     }
   }  
%>	    

}; // module <%=getModuleName()%>

//@@UserSection-Begin RCSLog
<%=RcsHelper.writeLog("// ")%>
//@@UserSection-End RCSLog
