   */
   public void set<%=StringUtil.firstToUpperCase(attribute.getName())%>(<%=attribute.getType()%> <%=attribute.getName()%>) {
      this.<%=attribute.getName()%> = <%=attribute.getName()%>;	
   }

<% } // for %>
<%   // Associations-Accessors
   for ( Iterator ia = modelClass.getAssociations(true).iterator(); ia.hasNext(); ) {
      ModelAssociation association = (ModelAssociation)ia.next();
      if ( !association.isUnspecified() ) {
         if ( association.isMultiple() ) {
%>
   public java.util.Iterator get<%=StringUtil.firstToUpperCase(association.getName())%>Iterator() throws RemoteException;

   public void add<%=StringUtil.firstToUpperCase(association.getName())%>(<%=association.getTarget()%> toAdd) throws RemoteException;

<%       } else {
%>
   public <%=association.getTarget()%> get<%=StringUtil.firstToUpperCase(association.getName())%>() throws RemoteException;

   public void set<%=StringUtil.firstToUpperCase(association.getName())%>(<%=association.getTarget()%> <%=association.getName()%>) throws RemoteException;
<%       }
     }
   }
   // Modelled Methods
   for ( Iterator ia = modelClass.getImplementedMethods().iterator(); ia.hasNext(); ) {
	   J2EEModelMethod method = (J2EEModelMethod)ia.next();
%>   /**
    * <%=method.getDocumentation()%>
    */
   public <%=method.getSignature()%> {
      <%=method.traceEntry(2)%>
      try {
         <%=getCallDelegateSignature("delegate", method)%>
      } catch ( RuntimeException e ) {
         <%=logging.logException("e")%>
         <%=method.logParameters(LoggingWriter.ERROR, 3)%>
         throw e;
      } finally {
         <%=logging.traceMethodExit(method)%>
      }
   }

<% }
   if ( genClass.isAbstract() == false ) {
%>   public void <%=createMethod%>() throws javax.ejb.CreateException {
<%    if ( springSupport ) {   
         String factoryClass = genClass.getScopedName(JavaArtefacts.BUSINESS_FACTORY, (J2EEModelPackage)genClass.getPackage());
         String factoryName  = ((J2EEModelPackage)(genClass.getPackage())).getGeneratedName(JavaArtefacts.BUSINESS_FACTORY);
%>      <%=factoryClass%> factory;

<%       if ( stateful ) {
%>      super.loadBeanFactory();
<%       }
%>      factory = (<%=factoryClass%>) getBeanFactory().getBean("<%=factoryName%>", <%=factoryClass%>.class);
      if ( factory != null ) {
         setDelegate(factory.create<%=genClass.getName()%>());
      }
      else {
         String msg = "Unable to create an instance of "+<%=factoryClass%>.class+" from bean factory";
         <%=logging.warn("msg")%>
         throw new javax.ejb.CreateException(msg);
      }
<%    }      
%><%= beginUserSection("ejbCreate", COMMON) %>
<%= endUserSection("ejbCreate", COMMON) %>      
   }

