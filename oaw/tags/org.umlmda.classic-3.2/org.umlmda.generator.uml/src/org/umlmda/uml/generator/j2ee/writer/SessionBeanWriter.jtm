   LoggingWriter logging = genModel.getLoggingWriter();
   boolean springSupport = Boolean.valueOf(genModel.getProperties().getProperty("SpringSupport", "false")).booleanValue();
   boolean stateful = genClass.isStateful();
   String createMethod = springSupport && !stateful ? "onEjbCreate" : "ejbCreate";
   String abstractExpression = genClass.isAbstract() ? "abstract " : "";
   String superClassBeanImpl = null;
   
   genClass.resetImports();
   if ( superClass != null ) {
      genClass.registerImport(J2EEArtefacts.SESSION_BEAN, superClass);
   }
   genClass.registerImport(JavaArtefacts.BUSINESS_SERVICE_INTERFACE);
   if ( genClass.isAbstract() == false ) {
      genClass.registerImport(JavaArtefacts.BUSINESS_FACTORY, (J2EEModelPackage)genClass.getPackage());
   }
   genClass.registerImports(JavaArtefacts.BUSINESS_OBJECT_INTERFACE, genClass.getReferencedTypes(), ModelStereotype.BUSINESS_OBJECT);

   if ( superClass != null ) {
      superClassBeanImpl = genClass.getScopedName(J2EEArtefacts.SESSION_BEAN, superClass);
   }
   else if ( springSupport ) {
      superClassBeanImpl = stateful ? "AbstractStatefulSessionBean" : "AbstractStatelessSessionBean";
   }
%>//@@Generated file, please edit UserSections only
//@@UserSection-Begin RCSHeader
<%=RcsHelper.writeHeader("// ")%>
//@@UserSection-End RCSHeader
   
package <%=getPackageName()%>;

