«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::uml::generator»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::oaw::generator::util»
«IMPORT org::umlmda::oaw::generator::model::java»

«EXTENSION java::UMLMDA»
«EXTENSION java::NamingConventions»
«EXTENSION java::Visitor»
«EXTENSION org::umlmda::uml::java::Sdo»

«DEFINE Root FOR JavaBusinessComponent»
«LET generatedName(this, "java.ConstraintVisitor") AS className»
«FILE generatedPath+"/"+className+".java"»
package «getQualifiedPackageName("java.ConstraintVisitor")»;

import org.umlmda.runtime.constraint.ConstraintVisitorContext;

«resetImports()»
«registerImport("java.AbstractVisitor")»
«registerImports("java.BusinessObjectInterface", classes, "BusinessObject")»
«registeredImports()»

/**
 * Constraint visitor for the business objects of «qualifiedName» 
 */
public class «generatedName» extends «getScopedName("java.AbstractVisitor")» implements «getScopedName("java.Visitor")» {

   /**
    * @param context
    */
   public «generatedName»() {
      super();
   }

   public ConstraintVisitorContext getConstraintContext() {
      return (ConstraintVisitorContext) getContext();
   }
   
   «FOREACH visitedClasses() AS visitedClass»
		public void visit(«getScopedName("java.BusinessObjectInterface", visitedClass)» a«visitedClass.name») {
		«FOREACH visitedClass.javaAttributes.typeSelect(JavaModelAttribute) AS attr»
			«IF attr.javaPrimitiveType == false && attr.isRelevantForGeneratedSdoPeer()»
				getConstraintContext().checkMultiplicityContraint(a«visitedClass.name».getClass().getName()+".«attr.name»", «attr.multiplicity.lower», «attr.multiplicity.upper», a«visitedClass.name».«attr.getter»());
			«ENDIF»
		«ENDFOREACH»
		«FOREACH visitedClass.javaAssociations.typeSelect(JavaModelAssociation) AS assoc»
			«IF assoc.optional == false && assoc.isRelevantForGeneratedSdoPeer()»
				getConstraintContext().checkMultiplicityContraint(a«visitedClass.name».getClass().getName()+".«assoc.name»", «assoc.multiplicity.lower», «assoc.multiplicity.upper», a«visitedClass.name».«assoc.getter»());
			«ENDIF»
		«ENDFOREACH»
   }
   
   «ENDFOREACH»
}
«ENDFILE»
«ENDLET»
«ENDDEFINE»
