/**
 * Standard Xtend Library for UML2 base generation. Extensions for ModelAssociation
 */
import org::umlmda::model::uml;
import org::umlmda::uml::generator::java;

extension org::umlmda::uml::java::DataType;

cached String javaTypeName(JavaModelAssociation assoc) :
	((JavaModelClass)assoc.target).javaType;
	
cached String javaType(JavaModelAssociation assoc) :
	assoc.interfaceType
;		