/**
 * Standard Xtend Library for UML2 base generation. Extensions for ModelStructuralFeature
 */
import org::umlmda::model::uml;
import org::umlmda::uml::generator::java;

// and we also load the io extensions, for the purpose of
// debugging, in case we need it   
extension org::openarchitectureware::util::stdlib::io;   
extension org::openarchitectureware::util::stdlib::issues;   

cached boolean isSDOClientOnly(ModelElement feature) :
	feature.hasStereotype("Client")
;				

cached boolean isSDOClientOnly(ModelAssociation feature) :
	feature.hasStereotype("Client")
;				

cached boolean isSDOServerOnly(ModelElement feature) :
	feature.hasStereotype("Server")
;		

Void logStereotypeProperties(ModelElement feature) :
    JAVA org.umlmda.oaw.generator.util.ElementUtils.logStereotypeProperties(org.umlmda.model.uml.ModelElement)
;	