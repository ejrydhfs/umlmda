«AROUND java::BOImpl::methodBody(ModelClass generatedClass) FOR ModelMethod»
	boolean queuingSwitchedOn = propertyChangeSupport.startQueuing();
	
	try {
	«IF isSDOServerOnly()»
		«IF returnType != null »
			return («((JavaModelClassifier)returnType).javaType»)
		«ENDIF»
		recorder.recordInvoke(this, "«name»"
		«IF parameters.size > 0»
			,
			«FOREACH parameters.typeSelect(JavaModelParameter) AS param SEPARATOR ","»
				«param.name»
			«ENDFOREACH»
		«ENDIF»
		);
	«ELSE»
		«targetDef.proceed()»
	«ENDIF»
	} finally {
		if ( queuingSwitchedOn ) {
			propertyChangeSupport.finishQueuing();
		} 
	}
«ENDAROUND»

«AROUND java::BOImpl::callPostSetMethod FOR JavaModelStructuraleFeature»
	this.recorder.recordChange(this, PROPERTY_«upperCaseIdentifier», «name»);
	«targetDef.proceed()»
«ENDAROUND»

«AROUND java::BOImpl::assocDecl FOR JavaModelAssociation»
	«IF derived == false»
