<?xml version="1.0" encoding="UTF-8"?>
<workflow>

    <!-- Verify the model -->
   <component id="umlIntegrityCheck" class="org.umlmda.oaw.generator.workflow.ModelIntegrityChecker">
      <modelSlot value="uml_model_${slotPostfix}"/>
   </component>
   
	<!-- Generate UMLMDA Pim from uml model -->
	<component id="pimLoader_${slotPostfix}"
			class="org.umlmda.oaw.generator.workflow.ModelLoader">
		<modelFactory class="org.umlmda.oaw.generator.workflow.Uml2ModelFactory">
		   <umlmodelSlot value="uml_model_${slotPostfix}"/>
		</modelFactory>   
		<modelSlot value="umlmda_pim_${slotPostfix}"/>
	</component>
   
    <!-- Creating UMLMDA Java PSM -->
	<component id="javaPsmCreator"
			class="org.umlmda.oaw.generator.workflow.PsmCreator">
		<adapterFactory value="org.umlmda.oaw.generator.model.java.JavaModelAdapterFactory"/>
		<pimModelSlot value="umlmda_pim_${slotPostfix}"/>
		<psmModelSlot value="javaModel"/>
		<generationSetSlot value="gs"/>
		<generationProfile value="${profile}"/>
	</component>

	<component id="dirCleaner"
			class="org.openarchitectureware.workflow.common.DirectoryCleaner" skipOnErrors="true">
		<directories value="${javaGenPath}"/>
	</component>

	<component id="generator" class="org.openarchitectureware.xpand2.Generator" skipOnErrors="true">
	   <metaModel class="org.openarchitectureware.type.impl.java.JavaMetaModel">
	   		<typeStrategy class="org.openarchitectureware.type.impl.java.beans.JavaBeansStrategy" />
	   </metaModel>
	   <fileEncoding value="ISO-8859-1"/>
	   <expand value="java::Root::Root FOR ${javaGenEntryPoint}"/>

       <prSrcPaths value="${javaGenPath}/"/>
       <prDefaultExcludes value="false"/>

		<!-- Generated sources -->
 		<outlet path="${javaGenPath}/">
	    	<postprocessor class="org.openarchitectureware.xpand2.output.JavaBeautifier">
	    		<configFile value="${basedir}/etc/eclipse/formatting.xml"/>
	    	</postprocessor>
		</outlet>
		<!-- Templates for manual writen sources -->
		<outlet name="delegateImpl" path="${javaNoGenPath}/" overwrite="false">
	    	<postprocessor class="org.openarchitectureware.xpand2.output.JavaBeautifier">
	    		<configFile value="${basedir}/etc/eclipse/formatting.xml"/>
	    	</postprocessor>
		</outlet>

	   	<globalVarDef name="jmiPackage" value="${jmiPackage}"/>
	   	<globalVarDef name="generateClient" value="true"/>
	   	<globalVarDef name="generateServer" value="true"/>
	   	<globalVarDef name="dateMapping" value="${dateMapping}"/>
	   	<globalVarDef name="decimalMapping" value="${decimalMapping}"/>
	   	<globalVarDef name="javaGenerics" value="'true'"/>
        <globalVarDef name="GWTSupport" value="${GWTSupport}"/>
        <globalVarDef name="VisitorSupport" value="${VisitorSupport}"/>

	</component>

</workflow>
