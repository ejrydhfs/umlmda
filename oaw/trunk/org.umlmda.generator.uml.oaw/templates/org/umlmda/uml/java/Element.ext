import org::umlmda::model::uml;
import org::umlmda::uml::generator::java;

cached boolean isSDOClientOnly(ModelElement feature) :
	feature.hasStereotype("SDOClient")
;				

cached boolean isSDOServerOnly(ModelElement feature) :
	feature.hasStereotype("SDOServer")
;				