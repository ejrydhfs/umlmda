/**
 * Standard Xtend Library for UML2 base generation. Extensions for ModelAssociation
 */
import java::util;
import org::umlmda::generator::model::uml;
import org::umlmda::profile;
import org::umlmda::model::uml;
import org::umlmda::uml::generator;
import org::umlmda::uml::generator::java;
import org::umlmda::oaw::generator::util;
import org::umlmda::oaw::generator::model::java;

extension org::umlmda::uml::java::Artefact;

cached List[String] persistenceAttributes(JavaModelAssociation assoc) :
    let attributes = {} :
    let targetArtefact = assoc.target.getDefaultArtefact(scopeImplementation()) :
    let targetImpl = ((JavaModelClass)assoc.target).getScopedName(targetArtefact) :

    assoc.composition ? attributes.add("cascade=CascadeType.ALL") : true ->
    assoc.composition ? attributes.add("fetch=FetchType.EAGER") : attributes.add("fetch=FetchType.LAZY") ->
    // optional only on OneToOne
    assoc.optional || assoc.multiple ? true : attributes.add("optional=false") ->
    // mapped by
    assoc.isBidirectional() && assoc.isOwner() ? attributes.add("mappedBy=\""+assoc.reverse.name+"\"") : true ->
    assoc.multiple ? attributes.add("targetEntity="+targetImpl+".class") : true ->
    attributes
;    

cached String implDeclType(JavaModelAssociation assoc) :
    assoc.multiple ? assoc.collectionInterfaceType : assoc.implementationInterfaceType
;
    
cached Boolean isBidirectional(JavaModelAssociation assoc) :
    assoc.navigatableToTarget && assoc.reverse.navigatableToTarget
;    

cached Boolean isOwner(JavaModelAssociation assoc) :
    assoc.composition || assoc.aggregation
;     