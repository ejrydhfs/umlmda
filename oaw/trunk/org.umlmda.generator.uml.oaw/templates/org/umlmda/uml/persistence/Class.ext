/**
 * Standard Xtend Library for UML2 base generation. Extensions for ModelAssociation
 */
import java::util;
import org::umlmda::generator::model::uml;
import org::umlmda::profile;
import org::umlmda::model::uml;
import org::umlmda::uml::generator;
import org::umlmda::uml::generator::java;
import org::umlmda::oaw::generator::util;
import org::umlmda::oaw::generator::model::java;

String pkeyInterface(JavaModelClass class) :
    class.getScopedName("java.BusinessObjectInterface")+".PKey"
;

String pkeyGetter(JavaModelClass class) :
    "get"+class.name+"Pkey"
;    

cached List[ModelAttribute] domainKeys(ModelClass class) :
/*
   TODO:

    This is wrong!    
    Normally we shouldn't check with "attr.owningClass==class" but with getStereotypeProperty("domainAttribute").
    Only problem is: this doesn't really work... !?!
*/

    class.keyAttributes.typeSelect(ModelAttribute).select(attr | attr.owningClass == class)
;
