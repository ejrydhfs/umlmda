/**
 * Standard Xtend Library for UML2 base generation. Extensions for ModelAssociation
 */
import java::util;
import org::umlmda::generator::model::uml;
import org::umlmda::profile;
import org::umlmda::model::uml;
import org::umlmda::uml::generator;
import org::umlmda::uml::generator::java;
import org::umlmda::oaw::generator::util;
import org::umlmda::oaw::generator::model::java;

extension org::umlmda::uml::persistence::Attribute;

String pkeyInterface(JavaModelClass class) :
    class.getScopedName("java.BusinessObjectInterface")+".PKey"
;

String pkeyGetter(JavaModelClass class) :
    "get"+class.name+"Pkey"
;    

cached List[ModelAttribute] domainKeys(ModelClass class) :
    class.keyAttributes.typeSelect(ModelAttribute).select(attr|attr.derived == false).select(attr | attr.getStereotypeProperty("domainAttribute", "true") == "true")
;

cached List[ModelAttribute] implementedDomainAttributes(JavaModelClass class) :
    class.implementedAttributes.typeSelect(ModelAttribute).select(e|!e.hasStereotype("PKey")).select(e|e.isDomainAttribute())
;
    
cached Boolean hasDomainKey(ModelClass class) :
    class.domainKeys().isEmpty == false
;
    
cached Boolean noneGeneratedCodeRequired(JavaModelClass class) :
    class.implementedMethods.isEmpty == false 
 || class.implementedAttributes.typeSelect(ModelAttribute).exists(e|e.derived)    
 || class.implementedAssociations.typeSelect(ModelAssociation).exists(e|e.derived)    
;

/**
 * Checks if a key class is required
 */
cached Boolean isKeyClassRequired(JavaModelClass class) :
   class.keyAttributes.size > 1 && (class.superClass == null || !class.superClass.hasStereotype("PersistentEntity")) && class.hasStereotype("PersistentEntity")
;

cached Boolean isPersistable(ModelClass class) :
    class.hasStereotype("PersistentEntity") || class.hasStereotype("PersistableSuperClass")
;    