«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::uml::generator»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::oaw::generator::model::java»

«EXTENSION java::UMLMDA»
«EXTENSION java::NamingConventions»
«EXTENSION java::gwt::BeanDescriptor»

«EXTENSION org::umlmda::uml::java::Artefact»
«EXTENSION org::umlmda::uml::java::Attribute»
«EXTENSION org::umlmda::uml::java::Association»
«EXTENSION org::umlmda::uml::java::DataType»
«EXTENSION org::umlmda::uml::java::Element»
«EXTENSION org::umlmda::uml::java::ModelClass»
«EXTENSION org::umlmda::uml::java::StructuralFeature»

«DEFINE Impl FOR JavaBusinessObject»
«LET generatedName(this, "gwt.BeanDescriptor") AS className»
«this.resetImports()»
«this.registerImport(getDefaultArtefact("BusinessObject"))»
«this.registerImports(getDefaultArtefact("BusinessObject"), referencedTypes, "BusinessObject")»
«this.registerImports(getDefaultArtefact("BusinessException"), referencedTypes, "BusinessException")»
«this.registerImports(getDefaultArtefact("Enumeration"), referencedTypes, "Enumeration")»
«IF javaSuperClass != null»
	«this.registerImport("gwt.BeanDescriptor", javaSuperClass)»
«ENDIF» 	

«FILE generatedPath+"/"+className+".java"»
	package «generatorPackage.getQualifiedPackageName("gwt.BeanDescriptor")»;

	import java.beans.IntrospectionException;
	import java.beans.PropertyDescriptor;
	import java.beans.PropertyEditor;
	
	import org.apache.log4j.Logger;
	import org.umlmda.runtime.bean.AbstractPropertyEditor;
	import org.umlmda.runtime.bean.BeanDescriptor;
	import org.umlmda.runtime.bean.DynamicEditorPropertyDescriptor;
	import org.umlmda.runtime.bean.ReadOnlyPropertyDescriptor;
	
	«this.registeredImports()»

	public class «className» extends 
		«IF javaSuperClass != null»
			«getScopedName("gwt.BeanDescriptor", javaSuperClass)»
		«ELSE»
			BeanDescriptor
		«ENDIF» 	
	 {
	
	   public static final «className» INSTANCE = new «className»();
	
	   protected «className»() {
		   «IF hasImplementedClientFeatures()»
		      try {
		     	 «FOREACH getImplementedClientAttributes() AS attr»
		     	 	«EXPAND addPropertyDescriptor(this, attr.javaPropertyTypeName()) FOR attr»
		     	 «ENDFOREACH» 
		     	 «FOREACH getImplementedClientAssociation() AS assoc»
		     	 	«EXPAND addPropertyDescriptor(this, assoc.interfaceType) FOR assoc»
		     	 «ENDFOREACH» 
		      } catch (IntrospectionException e) {
		         Logger.getRootLogger().error(e.getMessage(), e);
		      }
		   «ENDIF»
	   }
	}
«ENDFILE»
«ENDLET»	
«ENDDEFINE»

«DEFINE addPropertyDescriptor(JavaModelClass class, String javaType) FOR JavaModelStructuraleFeature»
	«LET class.getScopedName(getDefaultArtefact("BusinessObject")) AS interface»
		addPropertyDescriptor(new «getPropertyDesciptor()»(«interface».PROPERTY_«upperCaseIdentifier», «interface».class
		«IF readOnly»
			, "«getter»"
		«ENDIF»
		) {
			@Override public PropertyEditor createPropertyEditor(Object bean) {
				return new AbstractPropertyEditor<«interface»>((«interface»)bean, «interface».PROPERTY_«upperCaseIdentifier») {
					@Override public Object getValue() {
						return getBean().«getter»();
					}
					«IF readOnly»
						@Override public void setValue(Object value) {
							throw new UnsupportedOperationException("Property is readonly");
						}};
					«ELSE»	                  
						@Override public void setValue(Object value) {
						«IF classifier().hasStereotype("Enumeration")»
							if ( value instanceof org.umlmda.runtime.lang.GenericEnumeration ) {
								getBean().«setter»((«javaType») value);
							}
							else {	
								getBean().«setter»(«javaType».fromValue((«classifier().enumerationType()»)value));
							}
						«ELSE»
							getBean().«setter»((«javaType») value);
						«ENDIF»
						}};
                  «ENDIF»
            }
            @Override public Class<?> getPropertyType() {
               return «javaType».class;
            }
         }); 
	«ENDLET»
«ENDDEFINE»