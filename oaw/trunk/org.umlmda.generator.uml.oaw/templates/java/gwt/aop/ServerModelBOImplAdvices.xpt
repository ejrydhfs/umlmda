«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::uml::generator»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::oaw::generator::util»
«IMPORT org::umlmda::oaw::generator::model::java»

«EXTENSION java::UMLMDA»
«EXTENSION java::NamingConventions»
«EXTENSION org::umlmda::uml::java::Element»
«EXTENSION org::umlmda::uml::java::StructuralFeature»

// =================
// Avoid jmi support
// =================
«AROUND java::JmiReflect::Impl FOR JavaModelClass»
«ENDAROUND»

«AROUND java::JmiReflect::Imports FOR JavaModelClass»
«ENDAROUND»

// =================
// Avoid persistence
// =================
«AROUND java::BOImpl::persistenceInterface FOR JavaBusinessObject»
«ENDAROUND»

«AROUND java::BOImpl::persistenceImpl FOR JavaBusinessObject»
«ENDAROUND»

// ===========================
// Skip <<SDOClient>> features
// ===========================
«AROUND java::BOImpl::standardImports FOR JavaBusinessObject»
	«targetDef.proceed()»
	
	import org.umlmda.runtime.sdo.sync.gwt.server.SyncContext;
«ENDAROUND»

«AROUND java::BOImpl::handleAttribute(JavaModelClass modelClass) FOR JavaModelAttribute»
	«IF this.isSDOClientOnly() == false»
		«targetDef.proceed()»
	«ENDIF»
«ENDAROUND»

«AROUND java::BOImpl::handleAssociation(JavaModelClass modelClass) FOR JavaModelAssociation»
	«IF this.isSDOClientOnly() == false»
		«targetDef.proceed()»
	«ENDIF»
«ENDAROUND»

«AROUND java::BOImpl::handleMethod(JavaModelClass modelClass) FOR JavaModelMethod»
	«IF this.isSDOClientOnly() == false»
		«targetDef.proceed()»
	«ENDIF»
«ENDAROUND»

«AROUND java::BOImpl::callPostSetMethod FOR JavaModelStructuraleFeature»
	«IF multivalue == false»
		Recorder recorder = SyncContext.recorderHolder.get();
		
	    recorder.recordChange(this, PROPERTY_«upperCaseIdentifier», «name»);
	«ENDIF»
	«IF postSetMethod() != null && postSetMethod().isSDOClientOnly() == false»
		«targetDef.proceed()»
	«ENDIF»
«ENDAROUND»

«AROUND java::BOImpl::xmlMarshalAttribute FOR JavaModelAttribute»
	«IF this.isSDOClientOnly() == false»
		«targetDef.proceed()»
	«ENDIF»
«ENDAROUND»

«AROUND java::BOImpl::xmlMarshalChild FOR JavaModelAssociation»
	«IF this.isSDOClientOnly() == false»
		«targetDef.proceed()»
	«ENDIF»
«ENDAROUND»

«AROUND java::BOImpl::xmlMarshalReference FOR JavaModelAssociation»
	«IF this.isSDOClientOnly() == false»
		«targetDef.proceed()»
	«ENDIF»
«ENDAROUND»
