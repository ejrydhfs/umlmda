«AROUND java::BOFactoryImpl::additionalMethods FOR JavaBusinessComponent»
	public SynchronizedObject create(ModeledElementProxy element) {
		«IF businessObjects.typeSelect(JavaBusinessObject).select(e|e.abstract == false).size > 0 »
			«FOREACH businessObjects.typeSelect(JavaBusinessObject).select(e|e.abstract == false) AS bo SEPARATOR "else"»
				if ( «getScopedName("java.BusinessObject", bo)».MODEL_NAME.equals(element.getModelName())) {
