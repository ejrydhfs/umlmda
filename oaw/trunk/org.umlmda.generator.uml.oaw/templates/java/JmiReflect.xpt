«DEFINE jmiRefGetValueImpl FOR JavaModelClass»
	/**
	 * Reflective read access to the class features.
	 * @param featureName
	 *    Name of the feature to be read
	 * @return
	 *    Value of the feature or null if not set
	 */
	public Object refGetValue(String featureName) {
		Object retObj = null;
		
		«FOREACH javaAttributes() AS attr SEPARATOR "else"»
			if (featureName.equals(«EXPAND java::BOInterface::propertyNameConstant FOR attr»)){
			    «IF attr.javaPrimitiveType»
			    	retObj = new «attr.dataType.javaTypeWrapper()» ( «attr.getter»() );
			    «ELSE»
					retObj = «attr.getter»();
			    «ENDIF»
			}
		«ENDFOREACH»
		«IF attributes.size > 0 && associations.size > 0  »
			else
		«ENDIF»
		«FOREACH associations.typeSelect(JavaModelAssociation) AS assoc SEPARATOR "else"»
			if (featureName.equals(«EXPAND java::BOInterface::propertyNameConstant FOR assoc»)){
				retObj = «assoc.getter»();
			}
		«ENDFOREACH»
		«IF attributes.size > 0 || associations.size > 0  »
		    else {
		«ENDIF»
    	«IF superClass != null»
    		retObj = super.refGetValue(featureName);
    	«ELSE»
	    	throw new InvalidNameException(featureName);
    	«ENDIF»
		«IF attributes.size > 0 || associations.size > 0  »
		    }
		«ENDIF»
	    
		«IF attributes.size > 0 || associations.size > 0 || superClass != null »
	    	return retObj;
	    «ENDIF»	
	}
«ENDDEFINE»

«DEFINE jmiRefSetValueImpl FOR JavaModelClass»
	/**
	 * Reflective write access to the class features.
	 * @param featureName
	 *    Name of the feature to be read
	 * @param value
	 *    Value of the feature or null to be set
	 */
	public void refSetValue(String featureName, Object value) {
		«FOREACH javaWriteableAttributes() AS attr SEPARATOR "else"»
			if (featureName.equals(«EXPAND java::BOInterface::propertyNameConstant FOR attr»)){
  				«IF attr.javaPrimitiveType»
	   				«attr.setter»(((«attr.dataType.javaTypeWrapper()»)value).«attr.dataType.javaTypeWrapperValue()»());
  				«ELSE»
	   				«attr.setter»((«attr.javaTypeName()»)value);
	   			«ENDIF»
	   		}
	   	«ENDFOREACH»	
		«IF javaWriteableAttributes().size > 0 && javaWriteableAssociations().size > 0  »
			else
		«ENDIF»
		«FOREACH javaWriteableAssociations() AS assoc SEPARATOR "else"»
			if (featureName.equals(«EXPAND java::BOInterface::propertyNameConstant FOR assoc»)){
   				«assoc.setter»((«assoc.interfaceType»)value);
			}
		«ENDFOREACH»
		«IF javaWriteableAttributes().size > 0 || javaWriteableAssociations().size > 0  »
		    else {
	    «ENDIF»
    	«IF superClass != null»
    		super.refSetValue(featureName, value);
    	«ELSE»
	    	throw new InvalidNameException(featureName);
    	«ENDIF»
		«IF javaWriteableAttributes().size > 0 || javaWriteableAssociations().size > 0  »
		    }
	    «ENDIF»
	}
«ENDDEFINE»

