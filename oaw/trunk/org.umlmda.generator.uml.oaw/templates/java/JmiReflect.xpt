		«FOREACH javaWriteableAttributes() AS attr SEPARATOR "else"»
			if (featureName.equals(«EXPAND java::BOInterface::propertyNameConstant FOR attr»)){
  				«IF attr.javaPrimitiveType»
	   				«attr.setter»(((«attr.dataType.javaTypeWrapper()»)value).«attr.dataType.javaTypeWrapperValue()»());
  				«ELSE»
