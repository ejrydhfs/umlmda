«DEFINE keyImpl FOR JavaModelClass»
   «REM»Only concrete persistent entities should get a key implementation«ENDREM»
   «IF this.isKeyClassRequired()»
       /**
        * Primary key implementation
        */
        @Embeddable
         public static class PKey implements «pkeyInterface()» {
         	private static final long serialVersionUID = «serialVersionUID»;
         «FOREACH keyAttributes.typeSelect(JavaModelAttribute) AS attr»
            «EXPAND java::BOImpl::attrDecl FOR attr»
         «ENDFOREACH»
         
         public PKey() {
         super();
         }
      
         public PKey(
         «FOREACH keyAttributes.typeSelect(JavaModelAttribute) AS attr SEPARATOR ", "»
            «attr.javaTypeName()» «attr.name»
         «ENDFOREACH»
         ) {
         «FOREACH keyAttributes.typeSelect(JavaModelAttribute) AS attr»
            this.«attr.name» = «attr.name»;
         «ENDFOREACH»
         }

         «FOREACH keyAttributes.typeSelect(JavaModelAttribute) AS keyAttr»
         «EXPAND java::BOInterface::attrGetterDecl("key attribute") FOR keyAttr»
         «EXPAND java::BOImpl::getterBody(this) FOR keyAttr»
         «EXPAND java::BOInterface::attrSetterDecl("key attribute") FOR keyAttr»
         «EXPAND java::BOImpl::setterBody(this) FOR keyAttr»
      «ENDFOREACH»   
         
      public boolean equals(Object obj) {
            if ( obj instanceof «pkeyInterface()» ) {
               «pkeyInterface()» pkey = («pkeyInterface()»)obj;
         
               return 
                  «FOREACH keyAttributes.typeSelect(JavaModelAttribute) AS attr SEPARATOR "&&"»
                  «IF attr.javaPrimitiveType»
                     «attr.name» == pkey.«attr.getter»()
                  «ELSE»
                     «attr.name».equals(pkey.«attr.getter»())
                  «ENDIF»
                  «ENDFOREACH»;
            }
            else {
               return super.equals(obj);
            }
         }
                
        public int hashCode() {
         int hashCode = 0;
         
            «FOREACH keyAttributes.typeSelect(JavaModelAttribute) AS attr»
            «IF attr.javaPrimitiveType»
               hashCode = hashCode * 29 + (int)«attr.name»;
            «ELSE»
               hashCode = hashCode * 29 + «attr.name».hashCode();
            «ENDIF»
            «ENDFOREACH»
         return hashCode;
      }
                        
         }
         
         // The primary key
         @EmbeddedId
         private PKey pkey = new PKey();

      /**
       * Getter for the primary key
       */   
      public «pkeyInterface()» «pkeyGetter()»() {
         return pkey;
      }
   
      /**
       * Setter for the primary key
       */   
         public void set«name»Pkey(«pkeyInterface()» pkey) {
            this.pkey = (PKey)pkey;
         }

         «FOREACH this.keyAttributes.typeSelect(JavaModelAttribute) AS keyAttr»
         	«EXPAND handleKeyAttribute(this) FOR keyAttr»
         «ENDFOREACH»
         
         «FOREACH this.inheritedKeyAttributes.typeSelect(JavaModelAttribute) AS keyAttr»
         «EXPAND java::BOInterface::attrGetterDecl("parent key attribute") FOR keyAttr» {
             return pkey.«keyAttr.getter»();
         }
         «ENDFOREACH»
   «ENDIF»
«ENDDEFINE»
