	   {
	      if (!(listener instanceof Serializable)) {
	         throw new IllegalArgumentException(listener.getClass() + " must implement " + Serializable.class);
	      }
	
	      propertyChangeSupport.addPropertyChangeListener(propertyName, listener);
	   }
	
	   /**
