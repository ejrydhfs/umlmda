«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::uml::generator»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::oaw::generator::util»
«IMPORT org::umlmda::oaw::generator::model::java»

«EXTENSION java::UMLMDA»
«EXTENSION java::NamingConventions»
«EXTENSION java::Visitor»
«EXTENSION org::umlmda::uml::java::Sdo»

«DEFINE Root FOR JavaBusinessComponent»
«LET generatedName(this, "java.VisitableIterator") AS className»
«FILE generatedPath+"/"+className+".java"»
package «getQualifiedPackageName("java.VisitableIterator")»;

import org.umlmda.runtime.visitor.AbstractVisitableIterator;
import org.umlmda.runtime.visitor.VisitableIterator;

/**
 * Visitable iterator for the business objects of «qualifiedName» 
 */
public class «generatedName» extends AbstractVisitableIterator {

   /**
    * 
    */
   public «generatedName»(Object startPoint) {
      this(null, startPoint);
   }

   /**
    * 
    */
   public «generatedName»(VisitableIterator parentIterator, Object startPoint) {
      super(parentIterator, startPoint);
   }

   /* (non-Javadoc)
    * @see org.umlmda.runtime.visitor.AbstractVisitableIterator#registerChildrenOf()
    */
   protected void registerChildrenOf(Object startPoint) {
	   «FOREACH classes.typeSelect(JavaBusinessObject) AS class»
	        «LET class.associations.select(e|e.target.hasStereotype("BusinessObject")) AS assocList»
			«IF assocList.isEmpty»
			«ELSE»
			«LET getScopedName("java.BusinessObjectInterface", class) AS boClass»
            if ( startPoint instanceof «boClass» ) {
               «boClass» sp«class.name» = («boClass»)startPoint;

					«FOREACH assocList AS assoc»
						«IF assoc.multiple»
	                     registerChildren(sp«class.name».«assoc.getter»());
						«ELSE»
	                     registerChild(sp«class.name».«assoc.getter»());
						«ENDIF»
					«ENDFOREACH»
            }
			«ENDLET»	   
			«ENDIF»	   
			«ENDLET»	   
	   «ENDFOREACH»
   }
}
«ENDFILE»
«ENDLET»
«ENDDEFINE»