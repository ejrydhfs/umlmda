«EXTENSION java::UMLMDA»
«EXTENSION java::NamingConventions»

// =====================
// SDO Recording support
// =====================
«AROUND java::BOImpl::standardCtor FOR JavaBusinessObject»
	/**
	 * Default Ctor. «EXPAND java::BOImpl::docInitializer FOR this»
	 */
	public «generatedName»(Recorder recorder)
	{
		super(recorder);
		«EXPAND java::BOImpl::callInitializer FOR this»
	}
«ENDAROUND»

«AROUND java::BOImpl::standardExtendsDecl FOR JavaModelClass»
	extends AbstractSynchronizedObject
«ENDAROUND»

«AROUND java::BOImpl::standardImports FOR JavaBusinessObject»
	«targetDef.proceed()»
	
	import org.umlmda.runtime.sdo.sync.Recorder;
	import org.umlmda.runtime.sdo.sync.impl.AbstractSynchronizedObject;
«ENDAROUND»

«AROUND java::BOImpl::callPostSetMethod FOR JavaModelStructuraleFeature»
	«IF multivalue == false»
	    this.recorder.recordChange(this, PROPERTY_«upperCaseIdentifier», «name»);
	«ENDIF»
	«targetDef.proceed()»
«ENDAROUND»

«AROUND java::BOImpl::assocDecl FOR JavaModelAssociation»
	«IF derived == false»
		«IF multiple»
			«IF interfaceType.startsWith("java.util.List")»
			   private «interfaceType» «name» = new org.umlmda.runtime.sdo.sync.SynchronizedListWrapper(this.recorder, new «implementationType»());
			«ELSE»   
			   private «interfaceType» «name» = new org.umlmda.runtime.sdo.sync.SynchronizedSetWrapper(this.recorder, new «implementationType»());
			«ENDIF»
		«ELSE»
		   private «interfaceType» «name»;
		«ENDIF»
	«ENDIF»
«ENDAROUND»
