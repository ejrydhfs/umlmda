«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::uml::generator»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::oaw::generator::model::java»
«IMPORT org::umlmda::oaw::generator::model::webservice»

«DEFINE Root FOR JavaModel»
   «REM» Define standard service artifacts supporting jaxws «ENDREM»
   «ERROR "Root called on <<Model>> "+name»
   «EXPAND java::Root::initArtefacts FOR this»
   «EXPAND Root FOREACH this.packages.typeSelect(WSModelPackage).select( p | p.hasStereotype("WebServiceComponent") )»
«ENDDEFINE»

«DEFINE Root FOR WSModelPackage»
   «ERROR "Root called on <<WSModelPackage>> "+qualifiedName»
   «IF hasStereotype("WebServiceComponent")»
      «EXPAND jaxws::common::WSObjectFactory::wsObjectFactoryRoot»
      «EXPAND jaxws::common::WSUtils::wsUtilsRoot»
      «EXPAND jaxws::common::WSPackageXSD::xsdRoot»
   «ENDIF»
   «EXPAND Root FOREACH classes.typeSelect(JavaModelClass)»
«ENDDEFINE»

«DEFINE Root FOR JavaModelClass»
   «ERROR "Root called on <<JavaModelClass>> "+name»
   «IF hasStereotype("WebServiceObject")»
      «EXPAND jaxws::common::WSBusinessObject::wsBORoot»
   «ENDIF»
«ENDDEFINE»

«DEFINE Root FOR WSBusinessService»
   «ERROR "Root called on <<WSBusinessService>> "+name»
   «IF hasStereotype("WebService")»
      «REM» WS classes «ENDREM»
      «EXPAND jaxws::common::WSPort::wsPortRoot»
      «EXPAND jaxws::common::WSClient::wsClientRoot»

      «REM» Utility class «ENDREM»
      «EXPAND jaxws::common::WSUtils::wsUtilsRoot»
      
      «REM» WSDL definition «ENDREM»
      «EXPAND jaxws::common::WSDL::wsdlRoot»

		«REM» Special classes for method exceptions «ENDREM»
		«FOREACH methods.typeSelect(JavaModelMethod).select( m | m.hasStereotype("WebServiceMethod") && m.exceptions.size>0 ) AS method»
		   «EXPAND jaxws::common::WSException::wsExceptionRoot(method) FOREACH method.exceptions.typeSelect(JavaModelClass).select( e | e.hasStereotype("WebServiceException") )»
		«ENDFOREACH»
   «ENDIF»
«ENDDEFINE»

«DEFINE Root FOR WSBusinessException»
   «ERROR ">>>>>>>>>>>> WSBusinessException = "+this.name»
«ENDDEFINE»

«DEFINE Root FOR WSEnumeration»
   «ERROR "Root called on <<WSEnumeration>> "+name»
   «IF hasStereotype("WebServiceEnumeration")»
      «EXPAND jaxws::common::WSEnumeration::wsEnumerationRoot»
   «ENDIF»
«ENDDEFINE»

«DEFINE Root FOR WSBusinessComponent»
   «ERROR ">>>>>> WSBusinessComponent = "+this.name»
	«REM»«EXPAND Root FOREACH classes.typeSelect(ModelClass).select( c | c.hasStereotype("WebServiceObject") )»«ENDREM»
«ENDDEFINE»

«DEFINE Root FOR ModelElement»
   «ERROR "Root should not be called on <<ModelElement>> "+qualifiedName»
«ENDDEFINE»
