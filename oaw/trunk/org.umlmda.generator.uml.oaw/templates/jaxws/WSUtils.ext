import java::util;
import org::umlmda::generator::model::uml;
import org::umlmda::profile;
import org::umlmda::model::uml;
import org::umlmda::uml::generator;
import org::umlmda::uml::generator::java;
import org::umlmda::uml::generator::webservice;
import org::umlmda::oaw::generator::util;
import org::umlmda::oaw::generator::model::java;
import org::umlmda::oaw::generator::model::webservice;



cached String wsNamespace(ModelClass class) :
    class.component != null ? (
        class.component.wsNamespace()
    ) : (
        class.package.wsNamespace()
    )
;

cached String wsNamespace(ModelPackage package) :
    package.getStereotypeProperty("WSNamespace") != null ? (
        package.getStereotypeProperty("WSNamespace")
    ) : (
        package.package != null ? (
            package.package.wsNamespace()
        ) : (
            ""
        )
    )
;

