«IMPORT org::umlmda::model::uml»
«IMPORT org::umlmda::generator::model::uml»
«IMPORT org::umlmda::uml::generator::java»
«IMPORT org::umlmda::uml::generator::webservices»
«IMPORT org::umlmda::oaw::generator::model::java»
«IMPORT org::umlmda::oaw::generator::model::webservice»
«IMPORT org::umlmda::oaw::generator::util»

«EXTENSION jaxws::WSUtils»
«EXTENSION java::UMLMDA»
«EXTENSION org::umlmda::uml::java::Attribute»
«EXTENSION org::umlmda::uml::java::DataType»


«DEFINE xsdRoot FOR WSModelPackage»
	«FILE "WEB-INF/wsdl/"+owner.name.toFirstLower()+".xsd" resourceGenPath»
	<?xml version="1.0" encoding="ISO-8859-1"?>
	<xsd:schema targetNamespace="«wsNamespace()»" 
	           elementFormDefault="qualified" 
	           attributeFormDefault="unqualified" 
	           version="1.1"
	           xmlns="http://www.w3.org/2001/XMLSchema" 
	           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
      «REM» Own namespace «ENDREM»
      xmlns:«wsNamespacePrefix()»="«wsNamespace()»"
      «REM» Referenced namespaces «ENDREM»
      «FOREACH referencedPackages.typeSelect(JavaModelPackage) AS component»
         xmlns:«component.wsNamespacePrefix()»="«component.wsNamespace()»"
      «ENDFOREACH»
	 >
      «REM» Import referenced namespaces «ENDREM»
	   «IF ! isRuntimeWsPackage()»
	      «FOREACH referencedPackages.typeSelect(JavaModelPackage) AS component»
	         <xsd:import namespace="«component.wsNamespace()»" schemaLocation="«component.owner.name.toFirstLower()».xsd"/>
	      «ENDFOREACH»
	   «ENDIF» 

      «EXPAND complexType FOREACH classes.typeSelect(JavaModelClass).select( c | c.hasStereotype("WebServiceObject") ).sortBy(e|e.name)»

      «EXPAND enumSimpleType FOREACH classes.typeSelect(JavaModelClass).select( c | c.hasStereotype("WebServiceEnumeration") ).sortBy(e|e.name)»

	</xsd:schema>
	«ENDFILE»
«ENDDEFINE»


«DEFINE complexType FOR JavaModelClass»
	«LET getGeneratedName("jaxWs.WSObject") AS wsObjectClassName»
	<complexType name="«wsObjectClassName»">
      «IF superClass!=null»
      <complexContent>
         <extension base="«((JavaModelClass)superClass).wsNamespacePrefix()»:«((JavaModelClass)superClass).getGeneratedName("jaxWs.WSObject")»">
      «ENDIF»
      «LET attributes.typeSelect(JavaModelAttribute) AS attribs»
      «LET associations.typeSelect(JavaModelAssociation) AS assocs»
         «IF attribs.size>0 || assocs.size>0»
            <sequence>
	         «FOREACH attribs AS attrib»
               <element 
                  name="«attrib.name»" 
                  «IF ! attrib.multivalue»
                     nillable="«attrib.optional»" 
                  «ELSE»
                     minOccurs="«attrib.multiplicity.lower»" maxOccurs="«IF attrib.multiplicity.unbound»unbounded«ELSE»«attrib.multiplicity.upper»«ENDIF»" 
                  «ENDIF»
                  type=«IF ! attrib.multivalue»
					         «IF attrib.primitiveType»
					            "xsd:«attrib.dataType.name.toFirstLower()»"
					         «ELSE»
					            "«((JavaModelClass)attrib.modelClassifier).wsNamespacePrefix()»:«attrib.modelClassifier.name»"
					         «ENDIF»
					      «ELSE»
					         «IF attrib.primitiveType»
					            "xsd:«((JavaModelDataType)attrib.modelClassifier).name.toFirstLower()»"
					         «ELSE»
					            "«((JavaModelClass)attrib.modelClassifier).wsNamespacePrefix()»:«attrib.modelClassifier.name.toFirstLower()»"
					         «ENDIF»
					      «ENDIF»
					      />
	         «ENDFOREACH»

            «FOREACH assocs AS assoc»
               <element 
                  name="«assoc.name»" 
                  minOccurs="«assoc.multiplicity.lower»" maxOccurs="«IF assoc.multiplicity.unbound»unbounded«ELSE»«assoc.multiplicity.upper»«ENDIF»" 
                  type="«((JavaModelClass)assoc.target).wsNamespacePrefix()»:«((JavaModelClass)assoc.target).getGeneratedName("jaxWs.WSObject")»"
                     />
            «ENDFOREACH»
            </sequence>
         «ENDIF»
      «ENDLET»
      «ENDLET»
      «IF superClass!=null»
         </extension>
      </complexContent>
      «ENDIF»
	</complexType>
	
	«REM» Additional element definition for exceptions - to be referenced in the WSDL «ENDREM»
	«IF hasStereotype("WebServiceException")»
      <xsd:element name="«wsObjectClassName»Element" type="«wsNamespacePrefix()»:«wsObjectClassName»"/>
	«ENDIF»
	«ENDLET»
«ENDDEFINE»


«DEFINE enumSimpleType FOR JavaModelClass»
   «LET getGeneratedName("jaxWs.WSObject") AS wsObjectClassName»
   <simpleType name="«wsObjectClassName»">
      <restriction base="xsd:«((WSEnumeration)this).javaValueType.toFirstLower()»">
      «FOREACH attributes.typeSelect(JavaModelAttribute) AS attrib»
         <!-- «attrib.name» -->
         <enumeration value=«attrib.initialValue»/>
      «ENDFOREACH»
      </restriction>
   </simpleType>
   «ENDLET»
«ENDDEFINE»