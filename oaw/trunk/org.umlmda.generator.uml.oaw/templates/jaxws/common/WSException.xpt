«DEFINE wsExceptionRoot(JavaModelMethod usingMethod) FOR WSModelClass»
«LET generatedName(this, "ws.Stub") AS className»
«LET usingMethod.name.toFirstUpper()+name AS classNameForMethod»
«LET ((JavaModelClass)usingMethod.owner).generatorPackage.getQualifiedPackageName("ws.ServicePort") AS packageName»
«FILE generatedPath+"/"+classNameForMethod+".java"»
	package «packageName»;
	
   import javax.xml.ws.WebFault;

   /**
    * This is the method specific representation of «className» for WS method <i>«usingMethod.name»</i> 
    * in <i>«((JavaModelClass)usingMethod.owner).getScopedName("ws.ServicePort")»</i>. 
    */
   @WebFault(name = "«name»Element", targetNamespace = "«wsNamespace()»")
   public class «classNameForMethod» extends Exception {

	   /**
	    * Java type that goes as soapenv:Fault detail element.
	    */
	   private «className» faultInfo;
	
	   /**
	    * @param message
	    * @param faultInfo
	    */
	   public «classNameForMethod»(String message, «className» faultInfo) {
	      super(message);
	      this.faultInfo = faultInfo;
	   }
	
	   /**
	    * @param message
	    * @param faultInfo
	    * @param cause
	    */
	   public «classNameForMethod»(String message, «className» faultInfo, Throwable cause) {
	      super(message, cause);
	      this.faultInfo = faultInfo;
	   }
	
	   /**
	    * @return returns fault bean: «getQualifiedName("ws.Stub")»
	    */
	   public «className» getFaultInfo() {
	      return faultInfo;
	   }

   }
«ENDFILE»
