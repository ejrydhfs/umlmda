«ENDDEFINE»

«DEFINE stubImport(WSModelClass class) FOR WSModelClassifier»
«ENDDEFINE»


«DEFINE XmlAnnotations FOR WSBusinessService»
	@WebService(name = "«generatedName»", targetNamespace = "«wsNamespace()»")
	@SOAPBinding(style = SOAPBinding.Style.RPC)
	@XmlSeeAlso( { 
      «FOREACH referencedPackages.typeSelect(JavaModelPackage) AS refPkg SEPARATOR ", "»
