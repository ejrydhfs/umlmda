«DEFINE wsPortRoot FOR WSBusinessService»
«LET generatedName(this, "ws.ServicePort") AS className»
«FILE generatedPath+"/"+className+".java"»
	package «generatorPackage.getQualifiedPackageName("ws.ServicePort")»;

   «EXPAND imports»	

   /**
    * «documentation»
    */
