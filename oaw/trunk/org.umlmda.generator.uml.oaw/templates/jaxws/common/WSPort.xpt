   «FOREACH exceptions.typeSelect(JavaModelClass) AS exc -»
      * @throws «name.toFirstUpper()»«exc.name»
   «ENDFOREACH -»
    */
   @WebMethod(action = "«wsNamespace()»/«name»")
   @WebResult(name = "returnValue", partName = "returnValue")
   public «((JavaModelClass)returnType).getGeneratedName("jaxWs.WSObject")» «name»(
   «FOREACH parameters.typeSelect(JavaModelParameter) AS param SEPARATOR ", "»
      @WebParam(name = "«param.name»", partName = "«param.name»") «((JavaModelClass)param.type).getGeneratedName("jaxWs.WSObject")» «param.name»
   «ENDFOREACH»
   )
   «IF exceptions.size > 0»
      throws «FOREACH exceptions.typeSelect(JavaModelClass) AS exc SEPARATOR ", "»«name.toFirstUpper()»«exc.getGeneratedName("jaxWs.WSObject")»«ENDFOREACH»
   «ENDIF»
   ;
«ENDDEFINE»

