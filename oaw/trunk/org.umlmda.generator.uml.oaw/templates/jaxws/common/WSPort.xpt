«IMPORT org::umlmda::oaw::generator::util»

«EXTENSION jaxws::WSUtils»
«EXTENSION java::UMLMDA»


«DEFINE wsPortRoot FOR WSBusinessService»
«LET generatedName(this, "jaxWs.WSPort") AS className»
«FILE generatedPath+"/"+className+".java"»
	package «generatorPackage.getQualifiedPackageName("jaxWs.WSPort")»;
	
	import javax.jws.WebMethod;
	import javax.jws.WebParam;
	import javax.jws.WebResult;
	import javax.jws.WebService;
	import javax.jws.soap.SOAPBinding;
	import javax.xml.bind.annotation.XmlSeeAlso;

   «resetImports()»
   «REM» Method parameters and return types «ENDREM»
   «FOREACH methods.typeSelect(JavaModelMethod).select( m | m.hasStereotype("WebServiceMethod") ) AS method»
      «registerImport("jaxWs.WSObject", (JavaModelClass)method.returnType)»
      «FOREACH method.parameters.typeSelect(JavaModelParameter) AS param»
	      «registerImport("jaxWs.WSObject", (JavaModelClass)param.type)»
	   «ENDFOREACH»
   «ENDFOREACH»
   «registeredImports()»

   /**
    * «documentation»
    */
   «EXPAND XmlAnnotations»
	public interface «generatedName» {

      «FOREACH methods.typeSelect(JavaModelMethod).select( m | m.hasStereotype("WebServiceMethod") ) AS method»
         «EXPAND webMethod FOR method»
      «ENDFOREACH»

   }   
«ENDFILE»
«ENDLET»
«ENDDEFINE»


«DEFINE XmlAnnotations FOR WSBusinessService»
	@WebService(name = "«generatedName»", targetNamespace = "«wsNamespace()»")
	@SOAPBinding(style = SOAPBinding.Style.RPC)
	@XmlSeeAlso( { «generatorPackage.getQualifiedPackageName("jaxWs.WSObject")».ObjectFactory.class, com.fja.cor.bs.runtime.ws.jax.ObjectFactory.class })
«ENDDEFINE»


«DEFINE webMethod FOR JavaModelMethod»
   /**
    * @param in
