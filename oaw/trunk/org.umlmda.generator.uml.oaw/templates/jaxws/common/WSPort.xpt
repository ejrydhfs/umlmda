«DEFINE imports FOR WSBusinessService»
   import javax.jws.WebMethod;
   import javax.jws.WebParam;
   import javax.jws.WebResult;
   import javax.jws.WebService;
   import javax.jws.soap.SOAPBinding;
   import javax.xml.bind.annotation.XmlSeeAlso;
   
   «IF methods.typeSelect(WSModelMethod).select( m | m.returnType==null ).size > 0»
      import javax.jws.Oneway;
   «ENDIF»

   «resetImports()»
   «REM» Method parameters and return types «ENDREM»
   «FOREACH methods.typeSelect(WSModelMethod).select( m | m.hasStereotype("WebServiceMethod") ) AS method»
      «IF method.returnType!=null»
         «EXPAND stubImport(this) FOR (WSModelClassifier)method.returnType»
