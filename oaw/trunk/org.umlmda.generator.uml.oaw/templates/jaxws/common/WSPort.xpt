      «ENDFOREACH»
   })
«ENDDEFINE»


«DEFINE wsMethodDecl FOR WSModelMethod»
   /**
   «FOREACH parameters.typeSelect(JavaModelParameter) AS param -»
     * @param «param.name»
   «ENDFOREACH -»
    * @return returns «((WSModelClassifier)returnType).generatedStubName()»
   «FOREACH exceptions.typeSelect(JavaModelClass) AS exc -»
      * @throws «name.toFirstUpper()»«exc.name»
   «ENDFOREACH -»
    */
   @WebMethod(action = "«wsNamespace()»/«name»")
   «IF returnType!=null»
      @WebResult(name = "returnValue", partName = "returnValue")
   «ELSE»
      @Oneway
   «ENDIF»
   public «IF returnType!=null»«((WSModelClassifier)returnType).generatedStubName()»«ELSE»void«ENDIF» «name»(
   «FOREACH parameters.typeSelect(JavaModelParameter) AS param SEPARATOR ", "»
      @WebParam(name = "«param.name»", partName = "«param.name»") «((WSModelClassifier)param.type).generatedStubName()» «param.name»
   «ENDFOREACH»
   )
   «IF exceptions.size > 0»
      throws «FOREACH exceptions.typeSelect(WSModelClass) AS exc SEPARATOR ", "»«name.toFirstUpper()»«((WSModelClassifier)exc).generatedStubName()»«ENDFOREACH»
   «ENDIF»
«ENDDEFINE»

