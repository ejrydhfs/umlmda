      «FOREACH classes.typeSelect(WSModelClass).select( c | c.hasStereotype("WebServiceObject") ) AS class»
         «LET class.getScopedName("ws.Stub") AS wsObjectClassName»
		   /**
		    * Create an instance of {@link «wsObjectClassName» }
		    */
		   public «wsObjectClassName» create«wsObjectClassName.toFirstUpper()»() {
		      return new «wsObjectClassName»();
		   }

         «ENDLET»
      «ENDFOREACH»

      «REM» Exception classes are handled in a special way «ENDREM»
      «FOREACH classes.typeSelect(WSModelClass).select( c | c.hasStereotype("WebServiceException") ) AS exception»
		   /**
		    * Create an instance of {@link JAXBElement }{@code <}{@link «exception.getScopedName("ws.Stub")» }{@code >}
