<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
   <parent>
      <artifactId>org.umlmda.oaw</artifactId>
      <groupId>org.umlmda</groupId>
      <version>3.54-SNAPSHOT</version>
   </parent>
   <modelVersion>4.0.0</modelVersion>
   <groupId>org.umlmda</groupId>
   <artifactId>org.umlmda.oaw.generator</artifactId>
   <packaging>pom</packaging>
   <name>UMLMDA oAW Generator</name>
   <description />

   <dependencyManagement>
      <dependencies>
         <dependency>
            <groupId>org.umlmda</groupId>
            <artifactId>org.umlmda.uml2.generator.profiles</artifactId>
            <version>${umlmda.generator.profile.version}</version>
         </dependency>
         <dependency>
            <groupId>org.umlmda</groupId>
            <artifactId>org.umlmda.uml2.profiles</artifactId>
            <version>${umlmda.uml2.profile.version}</version>
         </dependency>
      </dependencies>
   </dependencyManagement>

   <dependencies>
      <!-- UMLMDA oAW stuff -->
      <dependency>
         <groupId>${project.parent.groupId}</groupId>
         <artifactId>org.umlmda.generator.uml.oaw</artifactId>
         <version>${project.parent.version}</version>
      </dependency>

      <!-- Additional UMLMDA Common stuff -->
      <dependency>
         <groupId>org.umlmda</groupId>
         <artifactId>org.umlmda.umlmodel.uml2</artifactId>
      </dependency>

      <!-- Commons Logging -->
      <dependency>
         <groupId>commons-logging</groupId>
         <artifactId>commons-logging</artifactId>
         <scope>runtime</scope>
         <exclusions>
            <exclusion>
               <groupId>logkit</groupId>
               <artifactId>logkit</artifactId>
            </exclusion>
            <exclusion>
               <groupId>avalon-framework</groupId>
               <artifactId>avalon-framework</artifactId>
            </exclusion>
            <exclusion>
               <groupId>javax.servlet</groupId>
               <artifactId>servlet-api</artifactId>
            </exclusion>
         </exclusions>
      </dependency>

      <!-- EMF -->
      <dependency>
         <groupId>org.eclipse.emf.mapping</groupId>
         <artifactId>ecore2xml</artifactId>
         <version>${emf.version}</version>
         <scope>runtime</scope>
         <exclusions>
            <exclusion>
               <groupId>org.eclipse.core</groupId>
               <artifactId>runtime</artifactId>
            </exclusion>
         </exclusions>
      </dependency>

      <!-- UML2 -->
      <dependency>
         <groupId>org.eclipse.uml2</groupId>
         <artifactId>resources</artifactId>
         <version>${uml2.version}</version>
         <scope>runtime</scope>
      </dependency>
      <dependency>
         <groupId>org.eclipse.uml2</groupId>
         <artifactId>uml</artifactId>
         <version>${uml2.version}</version>
         <scope>runtime</scope>
      </dependency>

      <!-- oAW -->
      <dependency>
         <groupId>org.openarchitectureware</groupId>
         <artifactId>oaw-rsdp-adapter</artifactId>
         <version>${oaw.version}</version>
         <scope>runtime</scope>
      </dependency>
      <dependency>
         <groupId>org.openarchitectureware</groupId>
         <artifactId>oaw-uml2-adapter</artifactId>
         <scope>runtime</scope>
         <exclusions>
            <exclusion>
               <groupId>org.openarchitectureware</groupId>
               <artifactId>oaw-dependencies</artifactId>
            </exclusion>
            <exclusion>
               <groupId>org.eclipse.uml2</groupId>
               <artifactId>codegen-ecore</artifactId>
            </exclusion>
            <exclusion>
               <groupId>org.eclipse.uml2</groupId>
               <artifactId>uml-ecore-importer</artifactId>
            </exclusion>
         </exclusions>
      </dependency>
      <dependency>
         <groupId>org.openarchitectureware</groupId>
         <artifactId>oaw-core-emftools</artifactId>
         <scope>runtime</scope>
      </dependency>
      <dependency>
         <groupId>org.openarchitectureware</groupId>
         <artifactId>oaw-core-expressions</artifactId>
         <scope>runtime</scope>
      </dependency>
      <dependency>
         <groupId>org.openarchitectureware</groupId>
         <artifactId>oaw-core-workflow</artifactId>
         <scope>runtime</scope>
      </dependency>
      <dependency>
         <groupId>org.openarchitectureware</groupId>
         <artifactId>oaw-core-xpand2</artifactId>
         <scope>runtime</scope>
      </dependency>
      <dependency>
         <groupId>org.openarchitectureware</groupId>
         <artifactId>oaw-util-stdlib</artifactId>
         <version>${oaw.version}</version>
         <scope>provided</scope>
      </dependency>
   </dependencies>

   <build>
      <plugins>
         <!-- Assembly -->
         <plugin>
            <artifactId>maven-assembly-plugin</artifactId>
            <configuration>
               <descriptors>
                  <descriptor>assembly.xml</descriptor>
               </descriptors>
            </configuration>
         </plugin>

      </plugins>

   </build>
</project>