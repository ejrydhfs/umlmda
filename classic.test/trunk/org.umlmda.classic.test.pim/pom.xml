<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
   <parent>
      <artifactId>org.umlmda.classic</artifactId>
      <groupId>org.umlmda</groupId>
      <version>3.2.0-SNAPSHOT</version>
   </parent>
   <modelVersion>4.0.0</modelVersion>
   <groupId>org.umlmda</groupId>
   <artifactId>org.umlmda.classic.test.pim</artifactId>
   <packaging>pom</packaging>
   <name>UMLMDA Classic test</name>
   <description />

   <dependencyManagement>
      <dependencies>
         <dependency>
            <groupId>org.umlmda</groupId>
            <artifactId>org.umlmda.uml2.generator.profiles</artifactId>
            <version>${umlmda.generator.profile.version}</version>
         </dependency>
         <dependency>
            <groupId>org.umlmda</groupId>
            <artifactId>org.umlmda.uml2.profiles</artifactId>
            <version>${umlmda.uml2.profile.version}</version>
         </dependency>
      </dependencies>
   </dependencyManagement>
   
   <dependencies>
      <!-- Classic stuff -->
      <dependency>
         <groupId>${parent.groupId}</groupId>
         <artifactId>org.umlmda.generator.uml</artifactId>
         <version>${parent.version}</version>
      </dependency>

      <!-- Classic stuff -->
      <dependency>
         <groupId>${parent.groupId}</groupId>
         <artifactId>org.umlmda.generator.uml.oaw</artifactId>
         <version>${umlmda.oaw.version}</version>
      </dependency>

      <!-- oAW -->
      <dependency>
         <groupId>org.fornax.openarchitectureware</groupId>
         <artifactId>oaw-uml2</artifactId>
         <version>${oaw.version}</version>
         <type>pom</type>
      </dependency>
      <dependency>
         <groupId>org.openarchitectureware.adapter</groupId>
         <artifactId>adapter-rsdp</artifactId>
         <version>${oaw.version}</version>
      </dependency>

   </dependencies>

   <build>
      <plugins>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
               <!-- Unpack UML profiles, UMLMDA generator profiles und -sets -->
               <execution>
                  <id>unpack</id>
                  <phase>initialize</phase>
                  <goals>
                     <goal>unpack</goal>
                  </goals>
                  <configuration>
                     <artifactItems>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.generator.profiles</artifactId>
                           <type>zip</type>
                           <classifier>java-ump</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/etc/umlmda/3rd/profile</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.generator.profiles</artifactId>
                           <type>zip</type>
                           <classifier>j2ee-ump</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/etc/umlmda/3rd/profile</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.generator.profiles</artifactId>
                           <type>zip</type>
                           <classifier>ws-ump</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/etc/umlmda/3rd/profile</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.uml2.profiles</artifactId>
                           <type>zip</type>
                           <classifier>std</classifier>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/profiles/rsm/3rd/umlmda/profiles</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>com.ibm.xtools.uml.msl</groupId>
                           <artifactId>uml2_profiles</artifactId>
                           <version>7.1.200</version>
                           <type>zip</type>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/profiles/rsm/3rd/ibm</outputDirectory>
                        </artifactItem>
                        <artifactItem>
                           <groupId>org.umlmda</groupId>
                           <artifactId>org.umlmda.generator.uml</artifactId>
                           <classifier>templates</classifier>
                           <type>zip</type>
                           <overWrite>false</overWrite>
                           <outputDirectory>${basedir}/etc/umlmda/3rd/templates</outputDirectory>
                        </artifactItem>
                        
                     </artifactItems>
                     <overWriteReleases>false</overWriteReleases>
                     <overWriteSnapshots>true</overWriteSnapshots>
                  </configuration>
               </execution>
            </executions>
         </plugin>

         <!-- Start oAW Workflow -->
         <plugin>
            <groupId>org.fornax.toolsupport</groupId>
            <artifactId>fornax-oaw-m2-plugin</artifactId>
            <version>2.0.0</version>
            <executions>
               <execution>
                  <id>run-oaw-workflow-base</id>
                  <phase>generate-sources</phase>
                  <goals>
                     <goal>run-workflow</goal>
                  </goals>
                  <configuration>
                     <defaultOawResourceDir>${basedir}/src</defaultOawResourceDir>
                  </configuration>
               </execution>
            </executions>
         </plugin>

         <!-- Clean 3rd modelling stuff -->
         <plugin>
            <artifactId>maven-clean-plugin</artifactId>
            <configuration>
               <filesets>
                  <fileset>
                     <directory>etc/umlmda/3rd</directory>
                  </fileset>
                  <fileset>
                     <directory>model/rsm/3rd</directory>
                  </fileset>
                  <fileset>
                     <directory>profiles/rsm/3rd</directory>
                  </fileset>
                  <!-- 
                     <fileset>
                     <directory>../vertrag_pnc_oap_gui_base_gwt/src-gen</directory>
                     </fileset>
                  -->
               </filesets>
            </configuration>
         </plugin>
      </plugins>
   </build>
</project>